{
  // Read by `tsrs`: the plain TypeScript in the project. `.rx` files need `rx-tsc` (see tsconfig.json).
  "extends": "./tsconfig.json",
  "compilerOptions": { "verbatimModuleSyntax": true, "types": ["vite/client", "node"] },
  "include": [
    "src/**/*.ts",
    "docs/**/*.ts",
    "vite.config.ts",
    "vite.docs.config.ts",
    "vitest.browser.config.ts"
  ]
}
