{
  "name": "rs-ui",
  "version": "0.0.0",
  "description": "Headless, unstyled, accessible components for ReactiveScript (.rx).",
  "license": "MIT",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts",
    "!src/**/fixtures"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:rx && pnpm typecheck:ts",
    "typecheck:rx": "node scripts/gen-dts.mjs --check && rx-tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsrs --noEmit -p tsconfig.ts.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:demo",
    "gen:dts": "node scripts/gen-dts.mjs",
    "rx-check": "node scripts/rx-check.mjs",
    "build:demo": "vite build --outDir node_modules/.cache/demo --emptyOutDir --logLevel warn"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0"
  },
  "devDependencies": {
    "@reactivescript/compiler": "0.3.1",
    "@reactivescript/language-server": "0.3.1",
    "@reactivescript/runtime": "0.3.1",
    "@solidjs/signals": "2.0.0-rc.22",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "solid-js": "2.0.0-rc.22",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
