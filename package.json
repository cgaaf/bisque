{
  "name": "bisque-ui",
  "version": "0.0.0",
  "description": "Headless, unstyled, accessible components for ReactiveScript (.rx).",
  "keywords": [
    "accessible",
    "agent-skills",
    "components",
    "headless",
    "reactivescript",
    "solid"
  ],
  "license": "MIT",
  "bin": {
    "bisque": "./bin/bisque.mjs"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/fixtures",
    "!src/test"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:rx && pnpm typecheck:ts",
    "typecheck:rx": "node scripts/gen-dts.mjs --check && node scripts/gen-api.mjs --check && node scripts/gen-skill.mjs --check && rx-tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsrs --noEmit -p tsconfig.ts.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser && pnpm build:docs",
    "gen:dts": "node scripts/gen-dts.mjs",
    "rx-check": "node scripts/rx-check.mjs",
    "baseline": "node scripts/baseline.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "docs": "vite --config vite.docs.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts --logLevel warn",
    "gen:api": "node scripts/gen-api.mjs && node scripts/gen-skill.mjs",
    "deploy:docs": "pnpm build:docs && cf deploy dist/docs"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.1.9",
    "@reactivescript/compiler": "0.3.1",
    "@reactivescript/language-server": "0.3.1",
    "@reactivescript/runtime": "0.3.1",
    "@solidjs/signals": "2.0.0-rc.22",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "playwright": "1.64.1",
    "shiki": "4.6.0",
    "solid-js": "2.0.0-rc.22",
    "temporal-polyfill": "1.0.6",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "web-features": "3.46.0"
  },
  "peerDependencies": {
    "@reactivescript/runtime": "^0.3.1",
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21"
  }
}
