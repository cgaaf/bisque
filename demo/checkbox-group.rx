import { CheckboxGroup } from "../src/checkbox-group/checkbox-group.rx"
import { CheckboxRoot, CheckboxIndicator } from "../src/checkbox/checkbox.rx"

// The parent box is mixed while some apples are checked: its indicator shows a dash from `:indeterminate`.
export component CheckboxGroupDemo() {
  <style>
    :global(.apple-mark) { display: inline-block; width: 1.5ch; visibility: hidden }
    :global(.apple-mark::before) { content: "✓" }
    :global(input:checked + .apple-mark), :global(input:indeterminate + .apple-mark) { visibility: visible }
    :global(input:indeterminate + .apple-mark::before) { content: "–" }
  </style>
  <CheckboxGroup aria-label="Apples" allValues={["fuji", "gala", "granny"]} defaultValue={["fuji"]}>
    <label><CheckboxRoot parent><CheckboxIndicator class="apple-mark" /></CheckboxRoot>All apples</label>
    <label><CheckboxRoot name="apple" value="fuji"><CheckboxIndicator class="apple-mark" /></CheckboxRoot>Fuji</label>
    <label><CheckboxRoot name="apple" value="gala"><CheckboxIndicator class="apple-mark" /></CheckboxRoot>Gala</label>
    <label><CheckboxRoot name="apple" value="granny"><CheckboxIndicator class="apple-mark" /></CheckboxRoot>Granny Smith</label>
  </CheckboxGroup>
}
