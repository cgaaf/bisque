import { FieldsetRoot, FieldsetLegend } from "../src/fieldset/fieldset.rx"
import { FieldRoot, FieldLabel, FieldControl } from "../src/field/field.rx"

export component FieldsetDemo() {
  source locked: boolean := false
  <div>
    <FieldsetRoot disabled={locked}>
      <FieldsetLegend>Billing details</FieldsetLegend>
      <FieldRoot>
        <FieldLabel>Company</FieldLabel>{" "}
        <FieldControl />
      </FieldRoot>
      <FieldRoot>
        <FieldLabel>Tax ID</FieldLabel>{" "}
        <FieldControl />
      </FieldRoot>
    </FieldsetRoot>
    <button type="button" onClick={() => { locked := !locked }}>{locked ? "Unlock" : "Lock"}</button>
  </div>
}
