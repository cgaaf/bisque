import { ToastProvider, ToastViewport, ToastRoot, ToastContent, ToastTitle, ToastDescription, ToastAction, ToastClose, toast } from "../src/toast/toast.rx"

component ToastList() {
  c = use toast
  for t in c.toasts {
    <ToastRoot toast={t} class="toast">
      <ToastContent>
        <ToastTitle />
        <ToastDescription />
        <ToastAction />
        <ToastClose aria-label="Close">×</ToastClose>
      </ToastContent>
    </ToastRoot>
  }
}

component ToastButtons() {
  c = use toast
  source saved := 0
  action save() {
    let n = saved + 1
    saved := n
    c.manager.add({ title: "Saved", description: `Draft ${n} was saved.`, type: "success" })
  }
  action remove() {
    c.manager.add({ title: "Message deleted", type: "info", actionProps: { children: "Undo" } })
  }
  action fail() {
    c.manager.add({ title: "Upload failed", description: "The server didn't answer.", type: "error", priority: "high" })
  }
  <div>
    <button onClick={save}>Save draft</button>{" "}
    <button onClick={remove}>Delete message</button>{" "}
    <button onClick={fail}>Fail upload</button>
  </div>
}

export component ToastDemo() {
  // The viewport is an open popover: placed in the bottom-right corner instead of the browser's centred box, and
  // letting presses through where it has no toast. Toasts animate in with @starting-style and out under
  // [data-ending-style], and follow a swipe.
  <style>
    :global(.toast-viewport) { inset: auto 1rem 1rem auto; margin: 0; padding: 0; border: 0; background: none; overflow: visible; width: 20rem; display: flex; flex-direction: column-reverse; gap: 0.5rem; pointer-events: none }
    :global(.toast) { pointer-events: auto; background: white; border: 1px solid #ddd; border-radius: 8px; padding: 0.75rem; box-shadow: 0 4px 12px rgb(0 0 0 / 0.1); transform: translate(var(--toast-swipe-movement-x), var(--toast-swipe-movement-y)); transition: opacity 200ms, transform 200ms }
    :global(.toast[data-swiping]) { transition: none }
    @starting-style { :global(.toast) { opacity: 0; transform: translateY(1rem) } }
    :global(.toast[data-ending-style]) { opacity: 0 }
    :global(.toast[data-limited]) { display: none }
  </style>
  <ToastProvider>
    <ToastButtons />
    <ToastViewport class="toast-viewport">
      <ToastList />
    </ToastViewport>
  </ToastProvider>
}
