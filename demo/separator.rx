import { Separator } from "../src/separator/separator.rx"

export component SeparatorDemo() {
  <style>
    :global(.rule) { border: 0; border-top: 1px solid #ccc; margin: 0.5rem 0 }
    :global(.rule[aria-orientation="vertical"]) { border-top: 0; border-left: 1px solid #ccc; margin: 0 0.5rem; align-self: stretch }
  </style>
  <div>
    <p>Above the line</p>
    <Separator class="rule" />
    <p>Below the line</p>
    <div style={{ display: "flex", "align-items": "center" }}>
      <span>Left</span>
      <Separator class="rule" orientation="vertical" />
      <span>Right</span>
    </div>
  </div>
}
