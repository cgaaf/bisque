import { Form, FormErrors } from "../src/form/form.rx"
import { FieldRoot, FieldLabel, FieldControl, FieldError } from "../src/field/field.rx"

export component FormDemo() {
  source errors: FormErrors := {}
  source sent := ""
  // A real app resets `errors` to {} when it sends, and fills it from the reply. Here the "server" rejects every
  // address at once.
  <Form errors={errors} onFormSubmit={(values) => {
    sent := `${values.url}`
    errors := { url: `${values.url} is already registered` }
  }}>
    <FieldRoot name="url">
      <FieldLabel>Homepage</FieldLabel>{" "}
      <FieldControl type="url" required placeholder="https://example.com" />
      <FieldError />
    </FieldRoot>
    <button type="submit">Submit</button>
    {if sent != "" { <p>Sent {sent}</p> }}
  </Form>
}
