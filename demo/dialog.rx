import { DialogRoot, DialogTrigger, DialogPopup, DialogTitle, DialogDescription, DialogClose } from "../src/dialog/dialog.rx"

export component DialogDemo() {
  <DialogRoot>
    <DialogTrigger>Delete project</DialogTrigger>
    <DialogPopup class="popup">
      <DialogTitle>Delete project?</DialogTitle>
      <DialogDescription>This can't be undone.</DialogDescription>
      <DialogClose>Cancel</DialogClose>
    </DialogPopup>
  </DialogRoot>
}
