import { TabsRoot, TabsList, TabsTab, TabsPanel, TabsIndicator } from "../src/tabs/tabs.rx"

export component TabsDemo() {
  <style>
    :global(.tabs-list) { position: relative; display: flex; gap: 0.25rem; border-bottom: 1px solid #ddd }
    :global(.tabs-tab) { border: 0; background: none; padding: 0.5rem 0.75rem; cursor: pointer }
    :global(.tabs-tab[data-disabled]) { opacity: 0.4; cursor: default }
    :global(.tabs-indicator) { position: absolute; bottom: -1px; left: var(--active-tab-left); width: var(--active-tab-width); height: 2px; background: currentColor; transition: left 200ms ease, width 200ms ease }
  </style>
  <TabsRoot>
    <TabsList class="tabs-list">
      <TabsTab class="tabs-tab" value="overview">Overview</TabsTab>
      <TabsTab class="tabs-tab" value="projects">Projects</TabsTab>
      <TabsTab class="tabs-tab" value="billing" disabled>Billing</TabsTab>
      <TabsTab class="tabs-tab" value="account">Account</TabsTab>
      <TabsIndicator class="tabs-indicator" />
    </TabsList>
    <TabsPanel value="overview"><p>Everything at a glance.</p></TabsPanel>
    <TabsPanel value="projects"><p>Your projects.</p></TabsPanel>
    <TabsPanel value="billing"><p>Invoices.</p></TabsPanel>
    <TabsPanel value="account"><p>Name, email and password.</p></TabsPanel>
  </TabsRoot>
}
