import { ScrollAreaRoot, ScrollAreaViewport, ScrollAreaContent, ScrollAreaScrollbar, ScrollAreaThumb, ScrollAreaCorner } from "../src/scroll-area/scroll-area.rx"

export component ScrollAreaDemo() {
  <style>
    :global(.scroll-root) { position: relative; width: 20rem; height: 10rem; border: 1px solid #ddd }
    :global(.scroll-viewport) { height: 100%; width: 100% }
    :global(.scroll-content) { width: 30rem; padding: 0.5rem 1rem }
    :global(.scroll-bar) { position: absolute; display: flex; opacity: 0; transition: opacity 150ms; touch-action: none; user-select: none }
    :global(.scroll-bar[data-hovering]), :global(.scroll-bar[data-scrolling]) { opacity: 1 }
    :global(.scroll-bar[data-orientation="vertical"]) { top: 0; right: 0; bottom: var(--scroll-area-corner-height); width: 0.5rem }
    :global(.scroll-bar[data-orientation="horizontal"]) { left: 0; bottom: 0; right: var(--scroll-area-corner-width); height: 0.5rem }
    :global(.scroll-thumb) { flex: none; border-radius: 0.25rem; background: #999 }
    :global(.scroll-bar[data-orientation="vertical"] .scroll-thumb) { width: 100% }
    :global(.scroll-bar[data-orientation="horizontal"] .scroll-thumb) { height: 100% }
    :global(.scroll-corner) { position: absolute; right: 0; bottom: 0 }
  </style>
  <ScrollAreaRoot class="scroll-root">
    <ScrollAreaViewport class="scroll-viewport">
      <ScrollAreaContent class="scroll-content">
        <p>Vernal equinox: the day and night are close to equal length everywhere on Earth.</p>
        <p>Summer solstice: the longest day of the year in the northern hemisphere.</p>
        <p>Autumnal equinox: day and night are again close to equal.</p>
        <p>Winter solstice: the shortest day of the year in the northern hemisphere.</p>
        <p>Perihelion: Earth is closest to the Sun, in early January.</p>
        <p>Aphelion: Earth is farthest from the Sun, in early July.</p>
      </ScrollAreaContent>
    </ScrollAreaViewport>
    <ScrollAreaScrollbar class="scroll-bar"><ScrollAreaThumb class="scroll-thumb" /></ScrollAreaScrollbar>
    <ScrollAreaScrollbar class="scroll-bar" orientation="horizontal"><ScrollAreaThumb class="scroll-thumb" /></ScrollAreaScrollbar>
    <ScrollAreaCorner class="scroll-corner" />
  </ScrollAreaRoot>
}
