import { TooltipProvider, TooltipRoot, TooltipTrigger, TooltipPopup } from "../src/tooltip/tooltip.rx"

export component TooltipDemo() {
  <TooltipProvider>
    <div role="toolbar" aria-label="Formatting">
      <TooltipRoot>
        <TooltipTrigger aria-label="Bold">B</TooltipTrigger>
        <TooltipPopup class="popup" sideOffset={6}>Bold</TooltipPopup>
      </TooltipRoot>
      <TooltipRoot>
        <TooltipTrigger aria-label="Italic">I</TooltipTrigger>
        <TooltipPopup class="popup" sideOffset={6}>Italic</TooltipPopup>
      </TooltipRoot>
    </div>
  </TooltipProvider>
}
