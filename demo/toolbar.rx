import { ToolbarRoot, ToolbarButton, ToolbarLink, ToolbarInput, ToolbarGroup, ToolbarSeparator } from "../src/toolbar/toolbar.rx"
import { ToggleGroup } from "../src/toggle-group/toggle-group.rx"
import { Toggle } from "../src/toggle/toggle.rx"

export component ToolbarDemo() {
  <ToolbarRoot aria-label="Formatting">
    <ToggleGroup aria-label="Style" multiple>
      <Toggle value="bold">Bold</Toggle>
      <Toggle value="italic">Italic</Toggle>
    </ToggleGroup>
    <ToolbarSeparator />
    <ToolbarGroup aria-label="History">
      <ToolbarButton>Undo</ToolbarButton>
      <ToolbarButton disabled>Redo</ToolbarButton>
    </ToolbarGroup>
    <ToolbarSeparator />
    <ToolbarInput aria-label="Font size" defaultValue="12" />
    <ToolbarLink href="#help">Help</ToolbarLink>
  </ToolbarRoot>
}
