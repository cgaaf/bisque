  <NavigationMenuRoot class="navigation-menu">
    <NavigationMenuList class="navigation-list">
      <NavigationMenuItem value="overview">
        <NavigationMenuTrigger>Overview <NavigationMenuIcon>▾</NavigationMenuIcon></NavigationMenuTrigger>
        <NavigationMenuContent class="navigation-content">
          <NavigationMenuLink href="#quick-start">Quick start</NavigationMenuLink>
          <NavigationMenuLink href="#accessibility">Accessibility</NavigationMenuLink>
