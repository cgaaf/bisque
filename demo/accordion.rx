import { AccordionRoot, AccordionItem, AccordionTrigger, AccordionPanel } from "../src/accordion/accordion.rx"

export component AccordionDemo() {
  // Both entry rules: Chrome animates the open from `@starting-style`, Safari from the closed style.
  <style>
    :global(.accordion-panel) { overflow: hidden; height: var(--accordion-panel-height); transition: height 200ms ease }
    :global(details:not([open]) > .accordion-panel), :global(.accordion-panel[data-ending-style]) { height: 0 }
    @starting-style { :global(details[open] > .accordion-panel) { height: 0 } }
    :global(.accordion-heading) { display: inline; margin: 0; font-size: inherit }
  </style>
  <AccordionRoot defaultValue={["shipping"]}>
    <AccordionItem value="shipping">
      <AccordionTrigger><h3 class="accordion-heading">Shipping</h3></AccordionTrigger>
      <AccordionPanel class="accordion-panel"><p>Orders ship within two working days.</p></AccordionPanel>
    </AccordionItem>
    <AccordionItem value="returns">
      <AccordionTrigger><h3 class="accordion-heading">Returns</h3></AccordionTrigger>
      <AccordionPanel class="accordion-panel"><p>Return anything unused within 30 days.</p></AccordionPanel>
    </AccordionItem>
    <AccordionItem value="gift" disabled>
      <AccordionTrigger><h3 class="accordion-heading">Gift wrap (unavailable)</h3></AccordionTrigger>
      <AccordionPanel class="accordion-panel"><p>Not offered yet.</p></AccordionPanel>
    </AccordionItem>
  </AccordionRoot>
}
