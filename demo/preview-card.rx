import { PreviewCardRoot, PreviewCardTrigger, PreviewCardPopup } from "../src/preview-card/preview-card.rx"

// The root renders nothing, so it can wrap the paragraph: the card is a block and can't sit inside a <p>.
export component PreviewCardDemo() {
  <PreviewCardRoot>
    <p>
      The principles of good{" "}
      <PreviewCardTrigger href="https://en.wikipedia.org/wiki/Typography">typography</PreviewCardTrigger>
      {" "}remain in the digital age.
    </p>
    <PreviewCardPopup class="popup" sideOffset={8}>
      Typography is the art and technique of arranging type to make written language legible.
    </PreviewCardPopup>
  </PreviewCardRoot>
}
