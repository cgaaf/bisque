import { MenuRoot, MenuTrigger, MenuPopup, MenuItem, MenuLinkItem, MenuSeparator, MenuCheckboxItem, MenuSubmenuRoot, MenuSubmenuTrigger } from "../src/menu/menu.rx"

export component MenuDemo() {
  <MenuRoot>
    <MenuTrigger>Actions</MenuTrigger>
    <MenuPopup class="popup" sideOffset={4}>
      <MenuItem>Rename</MenuItem>
      <MenuItem>Duplicate</MenuItem>
      <MenuSubmenuRoot>
        <MenuSubmenuTrigger>Share</MenuSubmenuTrigger>
        <MenuPopup class="popup">
          <MenuItem>Email link</MenuItem>
          <MenuItem>Copy link</MenuItem>
        </MenuPopup>
      </MenuSubmenuRoot>
      <MenuSeparator />
      <MenuCheckboxItem>Word wrap</MenuCheckboxItem>
      <MenuLinkItem href="#menu">Documentation</MenuLinkItem>
    </MenuPopup>
  </MenuRoot>
}
