import { FieldRoot, FieldLabel, FieldControl, FieldDescription, FieldError } from "../src/field/field.rx"
import { CheckboxRoot } from "../src/checkbox/checkbox.rx"

// `:user-invalid` is the browser's own hook; `data-invalid` is the field's, which also counts `validate`.
export component FieldDemo() {
  <style>
    :global(.field-input:user-invalid) { outline: 1px solid #c22 }
    :global(.field-root[data-invalid] label) { color: #c22 }
  </style>
  <div>
    <FieldRoot class="field-root" validationMode="onBlur" validate={(value) => value == "admin" ? "That name is taken" : null}>
      <FieldLabel>Username</FieldLabel>{" "}
      <FieldControl class="field-input" required minlength={3} />
      <FieldDescription>At least three characters. Try "admin".</FieldDescription>
      <FieldError />
    </FieldRoot>
    <FieldRoot class="field-root" validationMode="onChange">
      <CheckboxRoot class="field-input" required />{" "}
      <FieldLabel>I have read the guide</FieldLabel>
      <FieldError />
    </FieldRoot>
  </div>
}
