import { CollapsibleRoot, CollapsibleTrigger, CollapsiblePanel } from "../src/collapsible/collapsible.rx"

export component CollapsibleDemo() {
  <style>
    :global(.collapsible-panel) { overflow: hidden; height: var(--collapsible-panel-height); transition: height 200ms ease }
    :global(details:not([open]) > .collapsible-panel), :global(.collapsible-panel[data-ending-style]) { height: 0 }
    @starting-style { :global(details[open] > .collapsible-panel) { height: 0 } }
  </style>
  <CollapsibleRoot>
    <CollapsibleTrigger>Details</CollapsibleTrigger>
    <CollapsiblePanel class="collapsible-panel"><p>Hidden until opened, and found by find-in-page.</p></CollapsiblePanel>
  </CollapsibleRoot>
}
