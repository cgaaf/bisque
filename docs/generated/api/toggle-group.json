{
  "family": "toggle-group",
  "parts": [
    {
      "name": "ToggleGroup",
      "element": "div",
      "description": "One Tab stop over its toggles, moved with the arrow keys, Home and End. Inside a toolbar the toolbar owns the keyboard instead, and the toggles are its items.",
      "props": [
        {
          "name": "value",
          "type": "string[]",
          "default": null,
          "required": false,
          "description": "The values of the pressed toggles."
        },
        {
          "name": "defaultValue",
          "type": "string[]",
          "default": null,
          "required": false,
          "description": ""
        },
        {
          "name": "onValueChange",
          "type": "(value: string[]) => void",
          "default": null,
          "required": false,
          "description": ""
        },
        {
          "name": "multiple",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": "Whether several toggles can be pressed at once."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "description": ""
        },
        {
          "name": "orientation",
          "type": "ToggleGroupOrientation",
          "default": "\"horizontal\"",
          "required": false,
          "description": ""
        },
        {
          "name": "loopFocus",
          "type": "boolean",
          "default": "true",
          "required": false,
          "description": "Whether the arrow keys wrap around at the ends."
        }
      ],
      "dataAttributes": [
        {
          "name": "data-disabled",
          "description": "Present when the part is disabled."
        },
        {
          "name": "data-multiple",
          "description": ""
        },
        {
          "name": "data-orientation",
          "description": "The orientation: `horizontal` or `vertical`."
        }
      ],
      "cssVariables": []
    }
  ]
}
