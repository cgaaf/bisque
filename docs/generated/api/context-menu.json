        }
      ],
      "cssVariables": []
    },
    {
      "name": "ContextMenuPopup",
      "element": "div",
      "description": "The menu. Default: below the point and starting at it (`side=\"bottom\"`, `align=\"start\"`).",
      "props": [
        {
          "name": "side",
          "type": "\"top\" | \"bottom\" | \"left\" | \"right\"",
          "default": "\"bottom\"; \"right\" for a submenu and in a vertical menubar",
          "required": false,
          "description": "Which side of the trigger it sits on; the browser flips it when it doesn't fit."
        },
        {
          "name": "align",
          "type": "\"start\" | \"center\" | \"end\"",
          "default": "\"start\"",
          "required": false,
          "description": "Which edge of the trigger it lines up with."
        },
        {
          "name": "sideOffset",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Gap between trigger and popup, in pixels."
        },
        {
          "name": "alignOffset",
          "type": "number",
          "default": null,
          "required": false,
          "description": ""
        }
      ],
      "dataAttributes": [
        {
          "name": "data-side",
          "description": "Which side of its anchor the popup is on: the one asked for, then the one the browser placed it on."
