    {
      "name": "ComboboxPopup",
      "element": "div",
      "description": "The popup: a `popover=\"manual\"` element anchored to the input (or ComboboxChips) and at least as wide as it (`min-width: anchor-size(width)`). Style it with `:popover-open` and `@starting-style`. A press inside it keeps focus in the input.",
      "props": [
        {
          "name": "side",
          "type": "\"top\" | \"bottom\" | \"left\" | \"right\"",
          "default": "\"bottom\"",
          "required": false,
          "description": "Which side of the input it sits on; the browser flips it when it doesn't fit."
        },
        {
          "name": "align",
          "type": "\"start\" | \"center\" | \"end\"",
          "default": "\"start\"",
          "required": false,
          "description": "Which edge of the input it lines up with."
        },
        {
          "name": "sideOffset",
          "type": "number",
          "default": "0",
          "required": false,
          "description": "Gap between input and popup, in pixels."
        },
        {
          "name": "alignOffset",
          "type": "number",
          "default": "0",
          "required": false,
          "description": ""
        }
      ],
      "dataAttributes": [
        {
          "name": "data-empty",
          "description": ""
        },
        {
          "name": "data-side",
          "description": "Which side of its anchor the popup is on: the one asked for, then the one the browser placed it on."
