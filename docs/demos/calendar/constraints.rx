import { CalendarRoot, CalendarPreviousMonth, CalendarMonthLabel, CalendarNextMonth, CalendarGrid, CalendarGridHeader, CalendarGridBody } from "../../../src/calendar/calendar.rx"
import { today } from "../../../src/internal/date.js"
import { PlainDate } from "../../../src/internal/types.rx"

// Closed at weekends, and on the 1st of each month for stocktaking.
fn closed(date: PlainDate): boolean => date.dayOfWeek >= 6 || date.day == 1

export component CalendarConstraints() {
  // Bookable from tomorrow, for the next eight weeks.
  start = today(undefined, undefined)
  <div class="CalendarConstraints">
    <CalendarRoot class="Calendar" aria-label="Collection day" locale="en-GB" min={start.add({ days: 1 })} max={start.add({ weeks: 8 })} isDateUnavailable={closed} showWeekNumbers weekNumberLabel="Week">
      <div class="Header">
        <CalendarPreviousMonth class="Nav">‹</CalendarPreviousMonth>
        <CalendarMonthLabel class="Label" />
        <CalendarNextMonth class="Nav">›</CalendarNextMonth>
      </div>
      <CalendarGrid class="Grid">
        <CalendarGridHeader class="Head" format="narrow" />
        <CalendarGridBody class="Body" />
      </CalendarGrid>
    </CalendarRoot>
  </div>
}
