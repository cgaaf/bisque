import { FieldRoot, FieldLabel } from "../../../src/field/field.rx"
import { SelectRoot, SelectTrigger, SelectValue, SelectIcon, SelectPopup, SelectItem, SelectItemText, SelectItemIndicator } from "../../../src/select/select.rx"

export component SelectMultiple() {
  <div class="SelectMultiple">
    <FieldRoot class="Field">
      <FieldLabel class="Label">Toppings</FieldLabel>
      <SelectRoot multiple defaultValues={["mushrooms", "olives"]}>
        <SelectTrigger class="Trigger">
          <SelectValue class="Value" placeholder="No toppings" />
          <SelectIcon class="Icon">
            <svg width="10" height="14" viewBox="0 0 10 14" fill="none"><path d="M1.5 5 5 1.5 8.5 5M1.5 9 5 12.5 8.5 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </SelectIcon>
        </SelectTrigger>
        <SelectPopup class="Popup" sideOffset={6}>
          <SelectItem class="Item" value="basil">
            <SelectItemIndicator class="Box" keepMounted><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></SelectItemIndicator>
            <SelectItemText>Basil</SelectItemText>
          </SelectItem>
          <SelectItem class="Item" value="mushrooms">
            <SelectItemIndicator class="Box" keepMounted><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></SelectItemIndicator>
            <SelectItemText>Mushrooms</SelectItemText>
          </SelectItem>
          <SelectItem class="Item" value="olives">
            <SelectItemIndicator class="Box" keepMounted><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></SelectItemIndicator>
            <SelectItemText>Olives</SelectItemText>
          </SelectItem>
          <SelectItem class="Item" value="peppers">
            <SelectItemIndicator class="Box" keepMounted><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></SelectItemIndicator>
            <SelectItemText>Peppers</SelectItemText>
          </SelectItem>
          <SelectItem class="Item" value="pineapple">
            <SelectItemIndicator class="Box" keepMounted><svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></SelectItemIndicator>
            <SelectItemText>Pineapple</SelectItemText>
          </SelectItem>
        </SelectPopup>
      </SelectRoot>
    </FieldRoot>
  </div>
}
