import { DialogRoot, DialogTrigger, DialogPopup, DialogTitle, DialogClose } from "../../../src/dialog/dialog.rx"

export component DialogNonModal() {
  <div class="DialogNonModal">
    <DialogRoot modal={false}>
      <div class="Toolbar">
        <span class="Name">draft.md</span>
        <DialogTrigger class="Button">Shortcuts</DialogTrigger>
      </div>
      <textarea class="Editor" aria-label="Draft">The page stays usable while the panel is open: keep typing here.</textarea>
      <DialogPopup class="Panel">
        <div class="Header">
          <DialogTitle class="Title">Shortcuts</DialogTitle>
          <DialogClose class="Close" aria-label="Close">
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </DialogClose>
        </div>
        <dl class="Keys">
          <dt><kbd>Ctrl</kbd> <kbd>B</kbd></dt>
          <dd>Bold</dd>
          <dt><kbd>Ctrl</kbd> <kbd>I</kbd></dt>
          <dd>Italic</dd>
          <dt><kbd>Esc</kbd></dt>
          <dd>Close this panel</dd>
        </dl>
      </DialogPopup>
    </DialogRoot>
  </div>
}
