import { DialogRoot, DialogTrigger, DialogPopup, DialogTitle, DialogClose } from "../../../src/dialog/dialog.rx"
import { loadProject, saveProject, failNextSave } from "./projects.js"

export component DialogServer() {
  source open: boolean := false
  // Asked each time the dialog opens: `onOpenChange` moves `visit`, which the question reads.
  source visit := 0
  project = visit == 0 ? null : await loadProject()
  source draft := ""
  source saved := ""
  source failure := ""
  action save() {
    affects saved
    onFlush(() => { failure := "" })
    try {
      let answer = await saveProject(draft)
      saved := answer
      // Closed once the server has the new name; the dialog waits with the rest of the action.
      open := false
    } catch (e) {
      failure := e.message
    }
  }
  action change(next: boolean) {
    open := next
    if (next) {
      visit := visit + 1
      draft := ""
      failure := ""
    }
  }
  <div class="DialogServer">
    <DialogRoot open={open} onOpenChange={change}>
      <DialogTrigger class="Button">Rename project</DialogTrigger>
      <DialogPopup class="Popup">
        <DialogTitle class="Title">Rename project</DialogTitle>
        {loading on(visit) fallback { <p class="Status">Loading the project…</p> } {
          {errored fallback(e) {
            <p class="Error" role="alert">{e.message}</p>
            <button type="button" class="Button" onClick={() => { refresh project }}>Retry</button>
          } {
            <p class="Status">{project?.edited ?? ""}</p>
            <form onSubmit={(event) => { event.preventDefault(); save() }}>
              <input class="Input" aria-label="Name" required placeholder={project?.name ?? ""} value={draft} onInput={(event) => { draft := event.currentTarget.value }} />
              <p class="Error" role="alert">{failure}</p>
              <div class="Actions">
                <DialogClose class="Button">Cancel</DialogClose>
                <button class="Button Primary" type="submit" disabled={pending? saved}>{pending? saved ? "Saving…" : "Save"}</button>
              </div>
            </form>
          }}
        }}
      </DialogPopup>
    </DialogRoot>
    <p class="State" role="status">{saved == "" ? "Not renamed yet." : "Renamed to " + saved + "."}</p>
    <button type="button" class="Toggle" onClick={() => { failNextSave() }}>Make the next save fail</button>
  </div>
}
