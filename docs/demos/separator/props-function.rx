import { separator } from "../../../src/separator/separator.rx"

// A <div> that is a separator: the props function gives it the role and both orientation attributes.
component ToolbarDivider() {
  own = separator("vertical")
  <div class="Divider" {...own} />
}

export component SeparatorPropsFunction() {
  <div class="SeparatorPropsFunction">
    <div class="Toolbar" role="group" aria-label="Text formatting">
      <button class="Button" type="button">Bold</button>
      <button class="Button" type="button">Italic</button>
      <ToolbarDivider />
      <button class="Button" type="button">Left</button>
      <button class="Button" type="button">Center</button>
    </div>
  </div>
}
