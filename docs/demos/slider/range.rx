import { SliderRoot, SliderValue, SliderControl, SliderTrack, SliderIndicator, SliderThumb } from "../../../src/slider/slider.rx"

export component SliderRange() {
  <div class="SliderRange">
    <SliderRoot class="Slider" aria-labelledby="price-range-label" defaultValue={[40, 160]} min={0} max={250} step={5} largeStep={25} minStepsBetweenValues={4} format={{ style: "currency", currency: "USD", maximumFractionDigits: 0 }} locale="en-US">
      <div class="Header">
        <span class="Label" id="price-range-label">Price</span>
        <SliderValue class="Value" />
      </div>
      <SliderControl class="Control">
        <SliderTrack class="Track">
          <SliderIndicator class="Indicator" />
          <SliderThumb class="Thumb" index={0} getAriaLabel={(i) => i == 0 ? "Minimum price" : "Maximum price"} />
          <SliderThumb class="Thumb" index={1} getAriaLabel={(i) => i == 0 ? "Minimum price" : "Maximum price"} />
        </SliderTrack>
      </SliderControl>
    </SliderRoot>
  </div>
}
