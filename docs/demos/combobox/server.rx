import { ComboboxRoot, ComboboxInput, ComboboxClear, ComboboxPopup, ComboboxStatus, ComboboxEmpty, ComboboxList, ComboboxItem } from "../../../src/combobox/combobox.rx"
import { searchCountries, dropNetwork } from "./countries.js"

export component ComboboxServer() {
  source query := ""
  // Asked again whenever `query` changes; an answer to an older query is dropped. `-> null`: no answer yet.
  results = await searchCountries(query) -> null
  searching = results == null || pending? results
  <div class="ComboboxServer">
    <ComboboxRoot loading={searching} onInputValueChange={(text) => { query := text }}>
      <div class="InputGroup">
        <ComboboxInput class="Input" placeholder="Search countries" aria-label="Country" />
        <ComboboxClear class="IconButton" aria-label="Clear">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3 3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        </ComboboxClear>
      </div>
      <ComboboxPopup class="Popup" sideOffset={6}>
        {errored fallback(e) {
          <div class="Error" role="alert">
            <span>{e.message}</span>
            <button type="button" class="Retry" onClick={() => { refresh results }}>Retry</button>
          </div>
        } {
          <ComboboxStatus class="Status">{searching ? "Searching…" : ""}</ComboboxStatus>
          <ComboboxEmpty class="Empty">No country found.</ComboboxEmpty>
          <ComboboxList class="List">
            {for country in results ?? [] {
              <ComboboxItem class="Item" value={country.code} label={country.name}>{country.name}</ComboboxItem>
            }}
          </ComboboxList>
        }}
      </ComboboxPopup>
    </ComboboxRoot>
    <button type="button" class="Toggle" onClick={() => { dropNetwork() }}>Drop the network for 2 seconds</button>
  </div>
}
