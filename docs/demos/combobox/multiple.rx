import { combobox, ComboboxRoot, ComboboxInput, ComboboxChips, ComboboxChip, ComboboxChipRemove, ComboboxPopup, ComboboxEmpty, ComboboxList, ComboboxItem, ComboboxItemIndicator } from "../../../src/combobox/combobox.rx"

// One selected value. The context's `labels` names it.
component Chip(props: { value: string }) {
  c = use combobox
  label = c.labels.find((entry) => entry.value == props.value)?.label ?? props.value
  <ComboboxChip class="Chip" value={props.value}>
    {label}
    <ComboboxChipRemove class="ChipRemove" aria-label={`Remove ${label}`}>
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3 3 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </ComboboxChipRemove>
  </ComboboxChip>
}

// A chip per selected value, read from the `combobox` context.
component Chips() {
  c = use combobox
  {for value in c.selected {
    <Chip value={value} />
  }}
}

component Label(props: { value: string; label: string }) {
  <ComboboxItem class="Item" value={props.value} label={props.label}>
    <ComboboxItemIndicator class="Indicator">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="m2 6.5 2.5 2.5L10 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </ComboboxItemIndicator>
    <span class="ItemText">{props.label}</span>
  </ComboboxItem>
}

export component ComboboxMultiple() {
  <div class="ComboboxMultiple">
    <ComboboxRoot multiple name="labels" defaultValues={["bug", "docs"]}>
      <ComboboxChips class="Chips">
        <Chips />
        <ComboboxInput class="Input" aria-label="Labels" placeholder="Add a label" />
      </ComboboxChips>
      <ComboboxPopup class="Popup" sideOffset={6}>
        <ComboboxEmpty class="Empty">No such label.</ComboboxEmpty>
        <ComboboxList class="List">
          <Label value="bug" label="Bug" />
          <Label value="docs" label="Documentation" />
          <Label value="feature" label="Feature" />
          <Label value="question" label="Question" />
          <Label value="security" label="Security" />
          <Label value="wontfix" label="Won't fix" />
        </ComboboxList>
      </ComboboxPopup>
    </ComboboxRoot>
  </div>
}
