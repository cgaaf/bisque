import { ToastProvider, ToastViewport, ToastRoot, ToastTitle, ToastAction, ToastClose, toast } from "../../../src/toast/toast.rx"

component Toasts() {
  c = use toast
  for t in c.toasts {
    <ToastRoot toast={t} class="Toast">
      <ToastTitle class="Title" />
      <ToastAction class="Action" />
      <ToastClose class="Close" aria-label="Close">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </ToastClose>
    </ToastRoot>
  }
}

component Inbox() {
  c = use toast
  source archived := false
  action undo() {
    archived := false
    c.manager.close("archived")
  }
  action archive() {
    archived := true
    // The same id again replaces the toast that is showing instead of adding another.
    c.manager.add({ id: "archived", title: "Conversation archived", timeout: 8000, actionProps: { children: "Undo", onClick: undo } })
  }
  <div class="Row">
    {if archived {
      <span class="Empty">Nothing left in the inbox.</span>
    } else {
      <span class="Subject">Planning notes for the spring offsite</span>
      <button class="Button" type="button" onClick={archive}>Archive</button>
    }}
  </div>
}

export component ToastUndo() {
  <div class="ToastUndo">
    <ToastProvider>
      <Inbox />
      <ToastViewport class="Viewport">
        <Toasts />
      </ToastViewport>
    </ToastProvider>
  </div>
}
