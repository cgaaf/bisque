import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../../src/field/field.rx"
import { Input } from "../../../src/input/input.rx"

export component FieldValidate() {
  <div class="FieldValidate">
    <FieldRoot class="Field" name="username" validationMode="onChange" validate={(value) => value == "admin" || value == "root" ? "That name is taken" : null}>
      <FieldLabel class="Label">Username</FieldLabel>
      <Input class="Input" required minlength={3} />
      <FieldDescription class="Description">At least three characters. Try “admin”.</FieldDescription>
      <FieldError class="Error" />
    </FieldRoot>
  </div>
}
