import { AccordionRoot, AccordionItem, AccordionTrigger, AccordionPanel } from "../../../src/accordion/accordion.rx"

export component AccordionHero() {
  <div class="AccordionHero">
    <AccordionRoot class="Accordion" defaultValue={["shipping"]}>
      <AccordionItem class="Item" value="shipping">
        <AccordionTrigger class="Trigger">
          <h3 class="Heading">How long does shipping take?</h3>
          <svg class="Icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </AccordionTrigger>
        <AccordionPanel class="Panel">
          <p class="Content">Orders leave the warehouse within two working days and arrive three to five days later.</p>
        </AccordionPanel>
      </AccordionItem>
      <AccordionItem class="Item" value="returns">
        <AccordionTrigger class="Trigger">
          <h3 class="Heading">Can I return an order?</h3>
          <svg class="Icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </AccordionTrigger>
        <AccordionPanel class="Panel">
          <p class="Content">Anything unused can be sent back within 30 days, with the restocking fee waived.</p>
        </AccordionPanel>
      </AccordionItem>
      <AccordionItem class="Item" value="gift">
        <AccordionTrigger class="Trigger">
          <h3 class="Heading">Do you offer gift wrapping?</h3>
          <svg class="Icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </AccordionTrigger>
        <AccordionPanel class="Panel">
          <p class="Content">Yes: choose it at checkout and add a note of up to 200 characters.</p>
        </AccordionPanel>
      </AccordionItem>
    </AccordionRoot>
  </div>
}
