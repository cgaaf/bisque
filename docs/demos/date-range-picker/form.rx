import { DateRangePickerRoot, DateRangePickerGroup, DateRangePickerStart, DateRangePickerSeparator, DateRangePickerEnd, DateRangePickerTrigger, DateRangePickerPopup, DateRangePickerCalendar } from "../../../src/date-range-picker/date-range-picker.rx"
import { DateFieldInput, DateFieldSegment, dateField } from "../../../src/date-field/date-field.rx"
import { CalendarPreviousMonth, CalendarMonthLabel, CalendarNextMonth, CalendarGrid, CalendarGridHeader, CalendarGridBody } from "../../../src/calendar/calendar.rx"
import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../../src/field/field.rx"
import { Form } from "../../../src/form/form.rx"

// The segments come from the field's context, so they are rendered by a component inside the field.
component Segments() {
  c = use dateField
  {for segment in c.segments {
    <DateFieldSegment class="Segment" segment={segment} />
  }}
}

component CalendarIcon() {
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="2" y="3" width="12" height="11" rx="1.5" />
    <path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3" />
  </svg>
}

// The calendar's header and grid, inside the picker's calendar.
component Month() {
  <div class="Header">
    <CalendarPreviousMonth class="Nav">‹</CalendarPreviousMonth>
    <CalendarMonthLabel class="MonthLabel" />
    <CalendarNextMonth class="Nav">›</CalendarNextMonth>
  </div>
  <CalendarGrid class="Grid">
    <CalendarGridHeader class="Head" format="narrow" />
    <CalendarGridBody class="Body" />
  </CalendarGrid>
}

// The Field's value for a range: `{ start, end }` ISO strings, or null.
fn describe(trip: any): string => trip == null ? "" : `${trip.start} to ${trip.end}`

export component DateRangePickerForm() {
  source sent := ""
  <div class="DateRangePickerForm">
    <Form class="Form" onFormSubmit={(values) => { sent := describe(values.trip) }}>
      <FieldRoot class="Field" name="trip">
        <FieldLabel class="Label">Trip dates</FieldLabel>
        <DateRangePickerRoot required>
          <DateRangePickerGroup class="Group">
            <DateRangePickerStart class="Input"><DateFieldInput><Segments /></DateFieldInput></DateRangePickerStart>
            <DateRangePickerSeparator class="Separator">–</DateRangePickerSeparator>
            <DateRangePickerEnd class="Input"><DateFieldInput><Segments /></DateFieldInput></DateRangePickerEnd>
            <DateRangePickerTrigger class="Trigger"><CalendarIcon /></DateRangePickerTrigger>
          </DateRangePickerGroup>
          <DateRangePickerPopup class="Popup">
            <DateRangePickerCalendar><Month /></DateRangePickerCalendar>
          </DateRangePickerPopup>
        </DateRangePickerRoot>
        <FieldDescription class="Description">Both dates; the trip ends on or after it starts.</FieldDescription>
        <FieldError class="Error" />
      </FieldRoot>
      <button class="Button" type="submit">Book</button>
    </Form>
    <output class="Sent">{sent == "" ? "" : `Submitted ${sent}`}</output>
  </div>
}
