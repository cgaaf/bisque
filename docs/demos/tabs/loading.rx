import { TabsRoot, TabsList, TabsTab, TabsPanel, TabsIndicator } from "../../../src/tabs/tabs.rx"
import { loadText, failNextLoad } from "../../lib/panel-server.js"

export component TabsLoading() {
  // The selected tab is what the question reads: choosing a tab asks again, and an answer for a tab that is no
  // longer selected is dropped. `onValueChange` is called after the tab has switched, so the switch never waits.
  source tab := "activity"
  text = await loadText(tab)
  topics = [{ value: "activity", label: "Activity" }, { value: "members", label: "Members" }, { value: "files", label: "Files" }]
  <div class="TabsLoading">
    <TabsRoot defaultValue="activity" onValueChange={(next) => { tab := next }}>
      <TabsList class="List" aria-label="Project">
        {for topic in topics {
          <TabsTab class="Tab" value={topic.value}>{topic.label}</TabsTab>
        }}
        <TabsIndicator class="Indicator" />
      </TabsList>
      {for topic in topics {
        <TabsPanel class="Panel" value={topic.value}>
          {loading on(tab) fallback { <p class="Muted">Loading…</p> } {
            {errored fallback(e) {
              <p class="Error">{e.message}</p>
              <button class="Retry" onClick={() => { refresh text }}>Try again</button>
            } {
              <p class="Text">{text}</p>
            }}
          }}
        </TabsPanel>
      }}
    </TabsRoot>
    <button class="Fail" onClick={() => { failNextLoad() }}>Fail the next load</button>
  </div>
}
