import { FileUploadRoot, FileUploadDropZone, FileUploadInput, FileUploadTrigger, FileUploadItem, FileUploadItemRemove, fileUpload } from "../../../src/file-upload/file-upload.rx"
import { sendFile } from "./upload.js"

// What the app tracks about each upload. The family knows nothing of it: it hands over File objects.
type Upload = { file: File; percent: number; state: "uploading" | "done" | "failed" }

fn stateText(upload: Upload | undefined): string => upload == undefined ? "" : upload.state == "uploading" ? `${upload.percent}%` : upload.state == "done" ? "Uploaded" : "Failed"

component Rows(props: { uploads: Upload[] }) {
  c = use fileUpload
  {for file in c.files {
    upload = props.uploads.find((u) => u.file == file)
    <FileUploadItem class="Item" file={file} data-state={upload?.state}>
      <span class="Name">{file.name}</span>
      <span class="State">{stateText(upload)}</span>
      <progress class="Progress" max="100" value={upload?.percent ?? 0} aria-label={`${file.name} uploaded`} />
      <FileUploadItemRemove class="Remove">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </FileUploadItemRemove>
    </FileUploadItem>
  }}
}

export component FileUploadProgress() {
  source uploads: Upload[] := []
  uploading = uploads.filter((u) => u.state == "uploading").length
  action report(file: File, percent: number) {
    uploads := old => old.map((u) => u.file == file ? { ...u, percent: percent } : u)
  }
  action finish(file: File, state: "done" | "failed") {
    uploads := old => old.map((u) => u.file == file ? { ...u, state: state } : u)
  }
  action upload(file: File) {
    // Shown at once, in a change of its own: a write before `await` would wait for the upload to end.
    onFlush(() => { uploads := old => [...old, { file: file, percent: 0, state: "uploading" }] })
    try {
      await sendFile(file, (percent) => report(file, percent))
      finish(file, "done")
    } catch (e) {
      finish(file, "failed")
    }
  }
  <div class="FileUploadProgress">
    <FileUploadRoot class="Root" multiple onFilesChange={(next) => {
      let started = uploads.map((u) => u.file)
      // Each new file's upload starts in a change of its own, so each one finishes on its own.
      next.filter((file) => !started.includes(file)).forEach((file) => onFlush(() => { upload(file) }))
    }}>
      <FileUploadDropZone class="DropZone">
        <span>Drop files to upload, or</span>
        <FileUploadTrigger class="Trigger">Choose files</FileUploadTrigger>
        <FileUploadInput class="VisuallyHidden" aria-label="Files to upload" tabindex="-1" />
      </FileUploadDropZone>
      <ul class="List" aria-busy={pending? uploads ? "true" : undefined}><Rows uploads={uploads} /></ul>
    </FileUploadRoot>
    <p class="Status" role="status">{uploading > 0 ? `Uploading ${uploading} of ${uploads.length}` : ""}</p>
  </div>
}
