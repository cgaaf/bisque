import { NumberFieldRoot, NumberFieldGroup, NumberFieldInput, NumberFieldIncrement, NumberFieldDecrement } from "../../../src/number-field/number-field.rx"

export component NumberFieldFormat() {
  source price: number | null := 1249.5
  source discount: number | null := 0.15
  <div class="NumberFieldFormat">
    <NumberFieldRoot class="Field" value={price} onValueChange={(next) => { price := next }} min={0} step={0.5} locale="de-DE" format={{ style: "currency", currency: "EUR" }}>
      <label class="Label" for="number-field-price">Price</label>
      <NumberFieldGroup class="Group">
        <NumberFieldDecrement class="Stepper">−</NumberFieldDecrement>
        <NumberFieldInput class="Input" id="number-field-price" />
        <NumberFieldIncrement class="Stepper">+</NumberFieldIncrement>
      </NumberFieldGroup>
      <output class="Raw">value: {price == null ? "null" : `${price}`}</output>
    </NumberFieldRoot>
    <NumberFieldRoot class="Field" value={discount} onValueChange={(next) => { discount := next }} min={0} max={1} step={0.05} snapOnStep format={{ style: "percent" }}>
      <label class="Label" for="number-field-discount">Discount</label>
      <NumberFieldGroup class="Group">
        <NumberFieldDecrement class="Stepper">−</NumberFieldDecrement>
        <NumberFieldInput class="Input" id="number-field-discount" />
        <NumberFieldIncrement class="Stepper">+</NumberFieldIncrement>
      </NumberFieldGroup>
      <output class="Raw">value: {discount == null ? "null" : `${discount}`}</output>
    </NumberFieldRoot>
  </div>
}
