        <label class="Label" for="number-field-hero">Amount</label>
        <NumberFieldScrubAreaCursor>
          <svg width="26" height="14" viewBox="0 0 24 14" fill="black" stroke="white" stroke-width="1"><path d="M19.5 5.5V1L24 7l-4.5 6V8.5h-15V13L0 7l4.5-6v4.5z" /></svg>
