import { TimePickerRoot, TimePickerField, TimePickerTrigger, TimePickerPopup, TimePickerHours, TimePickerMinutes, TimePickerSeconds, TimePickerDayPeriod } from "../../../src/time-picker/time-picker.rx"
import { TimeFieldInput, TimeFieldSegment, timeField } from "../../../src/time-field/time-field.rx"
import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../../src/field/field.rx"
import { Form } from "../../../src/form/form.rx"
import { parseTime } from "../../../src/internal/date.js"

component Segments() {
  c = use timeField
  {for segment in c.segments {
    <TimeFieldSegment class="Segment" segment={segment} />
  }}
}

// In a FieldRoot: labelled by FieldLabel, validated by Field (required, min), submitted once under the field's name
// as `13:45`.
export component TimePickerForm() {
  source sent := ""
  <div class="TimePickerForm">
    <Form class="Form" onFormSubmit={(values) => { sent := `${values.arrival}` }}>
      <FieldRoot class="FieldRoot" name="arrival">
        <FieldLabel class="Label">Arrival</FieldLabel>
        <TimePickerRoot locale="en-US" minuteStep={15} required min={parseTime("07:00")}>
          <TimePickerField class="Field">
            <TimeFieldInput class="Input"><Segments /></TimeFieldInput>
            <TimePickerTrigger class="Trigger">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.2" />
                <path d="M8 4.5V8l2.25 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              </svg>
            </TimePickerTrigger>
          </TimePickerField>
          <TimePickerPopup class="Popup" sideOffset={6}>
            <div class="Columns">
              <TimePickerHours class="Column" />
              <TimePickerMinutes class="Column" />
              <TimePickerSeconds class="Column" />
              <TimePickerDayPeriod class="Column" />
            </div>
          </TimePickerPopup>
        </TimePickerRoot>
        <FieldDescription class="Description">From 7:00 AM.</FieldDescription>
        <FieldError class="Error" />
      </FieldRoot>
      <button class="Button" type="submit">Book</button>
    </Form>
    <output class="Sent">{sent == "" ? "" : `Submitted ${sent}`}</output>
  </div>
}
