import { TimePickerRoot, TimePickerField, TimePickerTrigger, TimePickerPopup, TimePickerHours, TimePickerMinutes, TimePickerSeconds, TimePickerDayPeriod } from "../../../src/time-picker/time-picker.rx"
import { TimeFieldInput, TimeFieldSegment, timeField } from "../../../src/time-field/time-field.rx"
import { parseTime } from "../../../src/internal/date.js"

component Segments() {
  c = use timeField
  {for segment in c.segments {
    <TimeFieldSegment class="Segment" segment={segment} />
  }}
}

// 12-hour (the locale's), minutes every 5. Put all four columns in: the ones this locale and granularity don't use
// render nothing.
export component TimePickerHero() {
  <div class="TimePickerHero">
    <span class="Label" id="time-picker-hero-label">Reminder</span>
    <TimePickerRoot locale="en-US" minuteStep={5} defaultValue={parseTime("09:30")}>
      <TimePickerField class="Field" aria-labelledby="time-picker-hero-label">
        <TimeFieldInput class="Input"><Segments /></TimeFieldInput>
        <TimePickerTrigger class="Trigger">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.2" />
            <path d="M8 4.5V8l2.25 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
        </TimePickerTrigger>
      </TimePickerField>
      <TimePickerPopup class="Popup" sideOffset={6}>
        <div class="Columns">
          <TimePickerHours class="Column" />
          <TimePickerMinutes class="Column" />
          <TimePickerSeconds class="Column" />
          <TimePickerDayPeriod class="Column" />
        </div>
      </TimePickerPopup>
    </TimePickerRoot>
  </div>
}
