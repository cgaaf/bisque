import { DocsPage } from "../../shell.rx"
import { href } from "../../lib/site.js"

export default component Page() {
  <DocsPage title="About" subtitle="What Bisque is, the work it builds on, and where it stands.">
    <h2 id="what-it-is">What it is</h2>
    <p>
      Bisque is a library of unstyled, accessible components written in{" "}
      <a href="https://reactivescript.dev/">ReactiveScript</a>, the language from the Solid team that compiles
      to Solid 2. It gives you behaviour and accessibility; the markup's appearance is entirely yours.
    </p>

    <h2 id="design">How it is put together</h2>
    <ul>
      <li>
        <strong>It is built on native features</strong> wherever all current browsers have them, so many
        components are thinner than you might expect, and parts such as Portal, Positioner and Backdrop don't
        exist. <a href={href("overview/platform-first")}>Platform first</a> has the reasoning.
      </li>
      <li>
        <strong>A component is composed from parts</strong> with flat names: <code>DialogRoot</code> and{" "}
        <code>DialogPopup</code>.
      </li>
      <li>
        <strong>There is no <code>render</code> prop.</strong> Each part's behaviour is also exported as a
        function that returns its props, which you spread on an element of your own. See{" "}
        <a href={href("handbook/composition")}>Composition</a>.
      </li>
      <li>
        <strong>Style hooks are native selectors</strong> such as <code>[open]</code> and{" "}
        <code>:popover-open</code> where they exist, and <code>data-*</code> attributes only where they don't.
      </li>
      <li>
        <strong>Some features are left out</strong> for now. Each component's page says what, where it matters:
        detached triggers, snap points on Drawer, and exit animations for popovers in browsers that can't keep a
        closing layer on screen are the main ones.
      </li>
    </ul>

    <h2 id="prior-art">Prior art</h2>
    <p>
      The shape of a headless component library (a family of parts, the ARIA patterns, the keyboard behaviour)
      is shared work, refined across many projects. Bisque borrows from them freely:
    </p>
    <ul>
      <li>
        <a href="https://base-ui.com/">Base UI</a>, whose component families and parts were the starting
        checklist for what Bisque covers.
      </li>
      <li>
        The <a href="https://www.w3.org/WAI/ARIA/apg/">WAI-ARIA Authoring Practices</a>, for the roles and
        keyboard interaction each pattern expects.
      </li>
    </ul>

    <h2 id="status">Status</h2>
    <p>
      Bisque is experimental, as ReactiveScript itself is (version 0.3). Expect its API to change. Server
      rendering has not been tested. It is distributed as source that you copy into your app, because the
      language can't yet import <code>.rx</code> from a package.
    </p>
    <p>It supports the current releases of Chrome, Firefox and Safari, and is released under the MIT licence.</p>
  </DocsPage>
}
