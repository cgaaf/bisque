import { DocsPage, Code } from "../../shell.rx"
import { href } from "../../lib/site.js"

export default component Page() {
  <DocsPage title="Forms" subtitle="The controls are native inputs, so forms work as HTML forms do. Field and Form add labelling, validation, error display and waiting for the server.">
    <h2 id="native">Controls submit by themselves</h2>
    <p>
      Checkbox, Switch, Radio and Input render the browser's own inputs. Give one a <code>name</code> and it is
      part of its form's submission, its constraints (<code>required</code>, <code>pattern</code>,{" "}
      <code>min</code>) are enforced by the browser, and <code>:user-invalid</code> styles it after the person
      has interacted with it. Nothing from this library is needed for that.
    </p>
    <Code file="handbook/native-form.rx.txt" />
    <p>
      Controls that have no native counterpart with the same behaviour, such as Select, Slider and Number Field,
      carry a <code>name</code> too and submit their value with the form.
    </p>

    <h2 id="reset">Resetting</h2>
    <p>
      A reset button puts every control back to its default, and the controls follow the browser. A default is
      written on the input as the browser expects it, <code>defaultChecked</code> as the <code>checked</code>{" "}
      attribute and <code>defaultValue</code> as the <code>value</code> attribute, so the browser's own reset
      restores it. An uncontrolled control then takes its default as its state and calls{" "}
      <code>onCheckedChange</code> or <code>onValueChange</code> once if it changed; a radio group or checkbox group
      reports once for the whole group. A controlled control keeps the value its owner holds: it is written back
      over what the browser restored.
    </p>
    <div class="note">
      <p>
        Select, Combobox, Autocomplete, Slider and Number Field don't take part in a reset yet, and neither does a
        Field around one.
      </p>
    </div>

    <h2 id="field">Field</h2>
    <p>
      <a href={href("components/field")}>Field</a> groups a control with its label, description and error
      message and connects them: the label names the control, the description and the error describe it. It
      tracks whether the control has been touched, changed or filled, and validates it: first the native
      constraints, then your <code>validate</code> function.
    </p>
    <Code file="handbook/field.rx.txt" />
    <p>
      A field works in a plain <code>{"<form>"}</code> too. There it validates when the control loses focus, and
      when the browser checks the form on submit, so its error shows beside the control while the browser blocks
      the submit. A <code>validate</code> message counts for the browser as well, once the field has validated.
    </p>

    <h2 id="form">Form</h2>
    <p>
      <a href={href("components/form")}>Form</a> is a <code>{"<form>"}</code> that validates its fields when it
      is submitted and moves focus to the first invalid one. On a valid submit it calls{" "}
      <code>onFormSubmit</code> with the named fields' values, and waits for it: the form is{" "}
      <code>data-submitting</code> until the request ends, and a second submit is ignored. What the handler
      resolves to is the errors the server found, keyed by field name; each shows on its field until that field's
      value changes, and the first takes focus. A failed request goes to <code>onFormError</code>.
    </p>
    <p>
      Fields inside a Form validate on submit by default, and on every change after the first attempt.{" "}
      <code>validationMode</code> on the form or on a single field changes that to <code>"onBlur"</code> or{" "}
      <code>"onChange"</code>. A reset returns every field to untouched and unvalidated, and the form to before
      its first submit.
    </p>

    <h2 id="groups">Groups</h2>
    <p>
      <a href={href("components/fieldset")}>Fieldset</a> is a native <code>{"<fieldset>"}</code> with its{" "}
      <code>{"<legend>"}</code>, for a set of related controls such as a
      {" "}<a href={href("components/radio")}>radio group</a> or a{" "}
      <a href={href("components/checkbox-group")}>checkbox group</a>.
    </p>
  </DocsPage>
}
