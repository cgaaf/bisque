import { DrawerRoot, DrawerTrigger, DrawerPopup, DrawerTitle } from "../drawer.rx"
import { dialog } from "../../dialog/dialog.rx"

component CloseCommand(props: { label: string }) {
  c = use dialog
  <button command="close" commandfor={c.popupId}>{props.label}</button>
}

// A controlled drawer closed by the browser itself: a `<form method="dialog">` and a `command="close"` button.
// Its owner refuses while `locked`; once unlocked, the close goes ahead and slides out.
export default component Fixture() {
  source open := false
  source locked := true
  source requests := 0
  action change(next: boolean) {
    requests := requests + 1
    if (next || !locked) { open := next }
  }
  <style>
    :global(.drawer) { margin: auto auto 0; width: 300px; height: 200px; padding: 0; border: 0 }
    :global(.drawer[data-ending-style]) { transform: translateY(100%); transition: transform 100ms linear }
  </style>
  <main>
    <DrawerRoot open={open} onOpenChange={change}>
      <DrawerTrigger>Open drawer</DrawerTrigger>
      <DrawerPopup data-testid="popup" class="drawer">
        <DrawerTitle>Filters</DrawerTitle>
        <button onClick={() => { locked := false }}>Unlock</button>
        <form method="dialog">
          <button>Apply</button>
        </form>
        <CloseCommand label="Dismiss" />
      </DrawerPopup>
    </DrawerRoot>
    <output data-testid="requests">{requests}</output>
  </main>
}
