import { DrawerRoot, DrawerTrigger, DrawerPopup, DrawerClose } from "../drawer.rx"
import { fetchText, save } from "../../test/slow-server.js"

// A drawer whose content loads when it first opens (its `onOpenChange` writes what the loading question reads), and
// one whose `onOpenChange` is an action that awaits.
export default component Fixture() {
  source wanted: boolean := false
  details = wanted ? await fetchText("cart") : ""
  source logged := ""
  action log(next: boolean) {
    affects logged
    try {
      let answer = await save(next ? "opened" : "closed")
      logged := answer
    } catch (e) {
      logged := "failed"
    }
  }
  <main>
    <DrawerRoot onOpenChange={(open) => { if (open) { wanted := true } }}>
      <DrawerTrigger>Cart</DrawerTrigger>
      <DrawerPopup aria-label="Cart" data-testid="cart">
        {loading on(wanted) fallback { <p data-testid="loading">Loading…</p> } {
          <p data-testid="details">{details catch (e) => e.message}</p>
        }}
        <DrawerClose>Close cart</DrawerClose>
      </DrawerPopup>
    </DrawerRoot>
    <DrawerRoot onOpenChange={log}>
      <DrawerTrigger>Logged</DrawerTrigger>
      <DrawerPopup aria-label="Logged" data-testid="logged-drawer">
        <DrawerClose>Close logged</DrawerClose>
      </DrawerPopup>
    </DrawerRoot>
    <output data-testid="logged">{pending? logged ? "" : logged}</output>
  </main>
}
