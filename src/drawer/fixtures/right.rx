import { DrawerRoot, DrawerTrigger, DrawerPopup, DrawerTitle } from "../drawer.rx"

// Controlled, sliding out to the right, with a fixed threshold.
export default component Fixture() {
  source open := true
  <style>
    :global(.side) { margin: 0 0 0 auto; width: 300px; height: 100%; max-height: none; padding: 0; border: 0 }
  </style>
  <main>
    <DrawerRoot open={open} onOpenChange={(next) => { open := next }} swipeDirection="right" swipeThreshold={50}>
      <DrawerTrigger>Open drawer</DrawerTrigger>
      <DrawerPopup data-testid="popup" class="side">
        <DrawerTitle>Side panel</DrawerTitle>
      </DrawerPopup>
    </DrawerRoot>
    <output data-testid="open">{open ? "open" : "closed"}</output>
  </main>
}
