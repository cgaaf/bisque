import { mergeProps, createRef } from "../internal/props.js"
import { createFormRegistry, createSubmission, createFormReset, submitForm, focusFirstInvalid, withoutErrors, reportFailure } from "../internal/field.js"
import { FormProps } from "../internal/types.rx"

export type FormValidationMode = "onSubmit" | "onBlur" | "onChange"
// Errors keyed by field name (the `name` of a FieldRoot), typically returned by a server.
export type FormErrors = import("../internal/impl/field.ts").FormErrors
export type FormValues = import("../internal/impl/field.ts").FormValues
export type FormAnswer = import("../internal/impl/field.ts").FormAnswer
export type FormRegistry = import("../internal/impl/field.ts").FormRegistry

// Read optionally, by FieldRoot only: a Field inside a Form registers with it, so a submit validates it.
export type FormContext = {
  // The fields of this form, for the validation engine (src/internal/impl/field.ts).
  registry: FormRegistry
  // The `errors` prop, minus the entries whose field has changed since.
  errors: FormErrors
  validationMode: FormValidationMode
  // True once a submit was attempted: an "onSubmit" field validates on every change from then on.
  submitted: boolean
  // The errors the last `onFormSubmit` resolved to, and the values it was sent.
  answer: FormAnswer
  // A field whose value changed retires the form's error for its name.
  clearError: (name: string) => void
}

export context form: FormContext | undefined = undefined

export type FormRootProps = {
  // When fields validate, unless a FieldRoot says otherwise. Default: "onSubmit".
  validationMode?: FormValidationMode
  // Errors to show on fields, keyed by field name, from somewhere other than a submit (a page loaded with them).
  // An entry is hidden once its field's value changes, until `errors` itself changes.
  errors?: FormErrors
  // Called on a valid submit with the values of the named fields; the native submission is then prevented. It may
  // take its time: return a promise (or be an action that awaits) and the form stays `data-submitting` until it
  // ends, ignoring further submits. What it resolves to, if anything, is the errors the server found, keyed by
  // field name: they are shown on their fields and the first one takes focus. An error for a field that was edited
  // while the request was out is dropped: it was about a value that is no longer there.
  onFormSubmit?: (values: FormValues) => FormErrors | void | Promise<FormErrors | void>
  // Called when `onFormSubmit` throws or its promise rejects (the network failed). Without it the failure is
  // reported to the page as an uncaught error. Either way the form can be submitted again.
  onFormError?: (error: unknown) => void
  // Called on a valid submit, before `onFormSubmit`.
  onSubmit?: (event: SubmitEvent) => void
} & Omit<FormProps, "onSubmit">

// A native <form> that validates its Fields on submit, focuses the first invalid one, waits for the handler that
// sends it, and shows the errors that come back.
export component Form(props: FormRootProps) {
  source cleared: string[] := []
  // Numbers the submits: an answer carries its submit's number (FormAnswer.id), which fields compare.
  source submitCount := 0
  // A submit was attempted since the form was mounted or last reset.
  source submitted: boolean := false
  // True from a valid submit until `errors` next changes: errors that arrive for it move focus to their field.
  source awaitingErrors: boolean := false
  source element: HTMLFormElement | undefined := undefined
  registry = createFormRegistry()
  errors = withoutErrors(props.errors, cleared)
  // Whether `onFormSubmit` is out, and what the last one resolved to with the values it was sent. Kept outside
  // the reactive graph's actions (../internal/impl/field.ts says why), so fields stay live during a submit.
  [submission, send] = createSubmission()

  effect (props.errors) {
    cleared := []
    // Tested through a local: narrowing `awaitingErrors` itself would type the write below as `true` (rx-tsc).
    let waiting = awaitingErrors
    if (waiting) {
      awaitingErrors := false
      focusFirstInvalid(registry, $0)
    }
  }

  action clearError(name: string) {
    cleared := old => old.includes(name) ? old : [...old, name]
  }
  action answered() { focusFirstInvalid(registry, undefined) }
  action failed(error: unknown) {
    if (props.onFormError) { props.onFormError(error) } else { reportFailure(error) }
  }

  // A reset returns the form to before its first submit; each Field returns itself to untouched once its control
  // has taken the reset. A reset someone cancelled changes nothing (createFormReset).
  action reset() {
    submitted := false
    awaitingErrors := false
  }
  _reset = createFormReset(element, reset)
  action writeElement(form: HTMLFormElement) { element := form }
  setElement = createRef(writeElement)

  action submit(event: SubmitEvent) {
    // One request at a time: a second submit while the first is out would race it.
    if (submission.pending) {
      event.preventDefault()
      return
    }
    let count = submitCount + 1
    submitCount := count
    submitted := true
    let result = submitForm(registry)
    if (!result.valid) {
      event.preventDefault()
      return
    }
    awaitingErrors := true
    if (props.onSubmit) { props.onSubmit(event) }
    if (props.onFormSubmit) {
      event.preventDefault()
      send(props.onFormSubmit, result.values, count, answered, failed)
    }
  }

  provide form = {
    registry: registry,
    errors: errors,
    validationMode: props.validationMode ?? "onSubmit",
    submitted: submitted,
    answer: submission.answer,
    clearError: clearError,
  }

  { validationMode, errors: _errors, onFormSubmit, onFormError, onSubmit, children, ...rest } = props
  merged = mergeProps({ novalidate: true, "data-submitting": submission.pending ? "" : undefined, "aria-busy": submission.pending ? "true" : undefined, onSubmit: submit, ref: setElement }, rest)
  <form {...merged}>{children}</form>
}
