import { TooltipRoot, TooltipTrigger, TooltipPopup } from "../tooltip.rx"

// Room above the triggers, where the tooltips go by default.
export default component Fixture() {
  source changes := 0
  <main style="padding: 160px 0 120px 200px">
    <button>Before</button>
    <TooltipRoot onOpenChange={(open) => { changes := changes + 1 }}>
      <TooltipTrigger style="width: 40px; height: 20px; padding: 0">Bold</TooltipTrigger>
      <TooltipPopup data-testid="popup" sideOffset={10} style="width: 120px; height: 40px; border: 0; padding: 0">Make the selection bold</TooltipPopup>
    </TooltipRoot>
    <TooltipRoot disableHoverablePopup>
      <TooltipTrigger delay={0}>Italic</TooltipTrigger>
      <TooltipPopup data-testid="italic-popup" sideOffset={4}>Italic text</TooltipPopup>
    </TooltipRoot>
    <TooltipRoot disabled>
      <TooltipTrigger delay={0}>Strike</TooltipTrigger>
      <TooltipPopup data-testid="strike-popup">Strikethrough</TooltipPopup>
    </TooltipRoot>
    <TooltipRoot>
      <TooltipTrigger delay={0} closeOnClick={false}>Underline</TooltipTrigger>
      <TooltipPopup data-testid="underline-popup">Underline text</TooltipPopup>
    </TooltipRoot>
    <p data-testid="outside" style="margin-top: 80px">Elsewhere</p>
    <output data-testid="changes">{changes}</output>
  </main>
}
