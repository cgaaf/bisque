// A tooltip on the native `popover` attribute. The browser provides the top layer and the placement against the
// trigger with CSS anchor positioning (opened with `showPopover({ source: trigger })`, so the trigger is its
// anchor). It is `popover="manual"`: hover-triggered popovers (`interestfor`, `popover="hint"`) aren't shipped in
// every engine yet, so this family keeps the hover intent, the delay group, and closing on Escape and on a press
// outside, which the browser does only for `popover="auto"`. There is no Portal, Positioner or Arrow part: the
// popup is the positioned element, styled with `:popover-open` and `@starting-style`.
import { mergeProps } from "../internal/props.js"
import { createHoverGroup, createHoverIntent, createManualDismiss } from "../internal/overlay.js"
import { createPopoverState, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { DivProps, ButtonProps, PartProps } from "../internal/types.rx"

type HoverGroup = import("../internal/impl/overlay.ts").HoverGroup

// What a TooltipProvider shares with the tooltips beneath it. Without one, each tooltip uses its own delays and
// waits every time.
export type TooltipProviderContext = {
  delay: number | undefined
  closeDelay: number | undefined
  group: HoverGroup | undefined
}

export context tooltipProvider: TooltipProviderContext = { delay: undefined, closeDelay: undefined, group: undefined }

export type TooltipProviderProps = {
  // How long the pointer rests on a trigger before its tooltip opens, in ms. A trigger's own `delay` wins.
  delay?: number
  // How long after the pointer leaves before a tooltip closes, in ms. A trigger's own `closeDelay` wins.
  closeDelay?: number
  // After a tooltip closes, another opens at once if hovered within this many ms. Default: 400.
  timeout?: number
  children?: View
}

// Groups tooltips: once one has opened, moving to another opens it without the delay, and closes the first.
export component TooltipProvider(props: TooltipProviderProps) {
  group = createHoverGroup(props.timeout ?? 400)
  provide tooltipProvider = { delay: props.delay, closeDelay: props.closeDelay, group: group }
  {props.children}
}

export type TooltipContext = PopoverState & {
  disabled: boolean
  hoverablePopup: boolean
}

export context tooltip: TooltipContext

export type TooltipRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // A disabled tooltip doesn't open, and closes if it was open. Default: false.
  disabled?: boolean
  // Whether the tooltip closes as soon as the pointer leaves the trigger, instead of letting it move onto the
  // popup. Default: false.
  disableHoverablePopup?: boolean
  children?: View
}

export component TooltipRoot(props: TooltipRootProps) {
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), props.onOpenChange)
  isDisabled = props.disabled ?? false
  action dismiss(reason: "escape-key" | "outside-press") { state.setOpen(false) }
  _dismiss = createManualDismiss(state.open, state.trigger, state.popup, dismiss)

  effect (isDisabled) {
    if ($0 && state.open) { state.setOpen(false) }
  }

  provide tooltip = {
    ...state,
    disabled: isDisabled,
    hoverablePopup: !(props.disableHoverablePopup ?? false),
  }

  {props.children}
}

export type TooltipTriggerProps = {
  // How long the pointer rests on the trigger before the tooltip opens, in ms. Default: the provider's, else 600.
  delay?: number
  // How long after the pointer leaves before it closes, in ms. Default: the provider's, else 0.
  closeDelay?: number
  // Whether pressing the trigger closes the tooltip. Default: true.
  closeOnClick?: boolean
} & ButtonProps

// Opens the tooltip on hover (after the delay) and on keyboard focus; closes it on leave, blur and press. It has
// no `popovertarget`: a press must not open a tooltip. Spread on any focusable element.
export fn tooltipTrigger(ref c: TooltipContext, ref provider: TooltipProviderContext, ref delay: number, ref closeDelay: number, ref closeOnClick: boolean): PartProps {
  action change(next: boolean, reason: "hover" | "focus" | "press" | "group") { c.setOpen(next) }
  _hover = createHoverIntent(!c.disabled, c.open, c.trigger, c.popup, {
    openDelay: delay,
    closeDelay: closeDelay,
    hoverablePopup: c.hoverablePopup,
    focus: true,
    focusDelay: 0,
    closeOnPress: closeOnClick,
    group: provider.group,
  }, change)
  {
    type: "button",
    "aria-describedby": c.open ? c.popupId : undefined,
    "data-popup-open": c.open ? "" : undefined,
    ref: c.setTrigger,
  }
}

export component TooltipTrigger({ delay, closeDelay, closeOnClick = true, children, ...rest }: TooltipTriggerProps) {
  c = use tooltip
  provider = use tooltipProvider
  own = tooltipTrigger(c, provider, delay ?? provider.delay ?? 600, closeDelay ?? provider.closeDelay ?? 0, closeOnClick)
  merged = mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

export type TooltipPopupProps = {
  // Which side of the trigger it sits on; the browser flips it when it doesn't fit. Default: "top".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the trigger it lines up with. Default: "center".
  align?: "start" | "center" | "end"
  // Gap between trigger and popup, in pixels. Default: 0.
  sideOffset?: number
  alignOffset?: number
} & DivProps

export fn tooltipPopup(ref c: TooltipContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(c, "manual", side, align, sideOffset, alignOffset)
  { ...base, role: "tooltip" }
}

export component TooltipPopup({ side = "top", align = "center", sideOffset = 0, alignOffset = 0, children, ...rest }: TooltipPopupProps) {
  c = use tooltip
  own = tooltipPopup(c, side, align, sideOffset, alignOffset)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn tooltipArrow(ref c: TooltipContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component TooltipArrow({ children, ...rest }: DivProps) {
  c = use tooltip
  own = tooltipArrow(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
