import { mergeProps, createId } from "../internal/props.js"
import { createPresence, createFocusScope, createDismiss, createScrollLock } from "../internal/dom.js"
import { DivProps, ButtonProps, HeadingProps, ParagraphProps, PartProps, TransitionStatus } from "../internal/types.rx"

export type DialogContext = {
  open: boolean
  // True from opening until the popup has finished animating out.
  mounted: boolean
  status: TransitionStatus
  modal: boolean
  popupId: string
  titleId: string | undefined
  descriptionId: string | undefined
  setOpen: (open: boolean) => void
  setPopup: (element: HTMLElement) => void
  setTrigger: (element: HTMLElement) => void
  setTitleId: (id: string | undefined) => void
  setDescriptionId: (id: string | undefined) => void
}

export context dialog: DialogContext

export type DialogRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // A modal dialog traps focus and locks page scroll. Default: true.
  modal?: boolean
  // Whether Escape and a press outside close it. Default: true.
  dismissible?: boolean
  children?: View
}

export component DialogRoot(props: DialogRootProps) {
  source uncontrolled := peek(props.defaultOpen ?? false)
  source popup: HTMLElement | undefined := undefined
  source trigger: HTMLElement | undefined := undefined
  source titleId: string | undefined := undefined
  source descriptionId: string | undefined := undefined
  isOpen = props.open ?? uncontrolled
  isModal = props.modal ?? true
  popupId = createId("dialog")

  action setOpen(next: boolean) {
    if (next == isOpen) { return }
    uncontrolled := next
    if (props.onOpenChange) { props.onOpenChange(next) }
  }
  action dismiss() { setOpen(false) }
  action setPopup(element: HTMLElement) { popup := element }
  action setTrigger(element: HTMLElement) { trigger := element }
  action setTitleId(id: string | undefined) { titleId := id }
  action setDescriptionId(id: string | undefined) { descriptionId := id }

  [mounted, status] = createPresence(isOpen, popup)
  _scope = createFocusScope(isOpen, popup, isModal, "auto")
  _dismiss = createDismiss(isOpen && (props.dismissible ?? true), [popup, trigger], dismiss)
  _lock = createScrollLock(isOpen && isModal)

  provide dialog = {
    open: isOpen,
    mounted: mounted,
    status: status,
    modal: isModal,
    popupId: popupId,
    titleId: titleId,
    descriptionId: descriptionId,
    setOpen: setOpen,
    setPopup: setPopup,
    setTrigger: setTrigger,
    setTitleId: setTitleId,
    setDescriptionId: setDescriptionId,
  }

  {props.children}
}

fn stateAttributes(ref c: DialogContext): PartProps {
  {
    "data-open": c.open ? "" : undefined,
    "data-closed": c.open ? undefined : "",
    "data-starting-style": c.status == "starting" ? "" : undefined,
    "data-ending-style": c.status == "ending" ? "" : undefined,
  }
}

export fn dialogTrigger(ref c: DialogContext): PartProps {
  action press() { c.setOpen(!c.open) }
  {
    type: "button",
    "aria-haspopup": "dialog",
    "aria-expanded": c.open ? "true" : "false",
    "aria-controls": c.mounted ? c.popupId : undefined,
    "data-popup-open": c.open ? "" : undefined,
    ref: c.setTrigger,
    onClick: press,
  }
}

export component DialogTrigger({ children, ...rest }: ButtonProps) {
  c = use dialog
  own = dialogTrigger(c)
  merged = mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

// Renders its children at the end of <body> while the dialog is mounted.
export component DialogPortal(props: { keepMounted?: boolean; children?: View }) {
  c = use dialog
  {if c.mounted || (props.keepMounted ?? false) {
    portal { {props.children} }
  }}
}

export component DialogBackdrop({ children, ...rest }: DivProps) {
  c = use dialog
  state = stateAttributes(c)
  merged = mergeProps({ role: "presentation", ...state }, rest)
  <div {...merged}>{children}</div>
}

export fn dialogPopup(ref c: DialogContext): PartProps {
  state = stateAttributes(c)
  {
    id: c.popupId,
    role: "dialog",
    tabindex: "-1",
    "aria-modal": c.modal ? "true" : undefined,
    "aria-labelledby": c.titleId,
    "aria-describedby": c.descriptionId,
    ref: c.setPopup,
    ...state,
  }
}

export component DialogPopup({ children, ...rest }: DivProps) {
  c = use dialog
  own = dialogPopup(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export component DialogTitle({ children, ...rest }: HeadingProps) {
  c = use dialog
  id = createId("dialog-title")
  effect () {
    c.setTitleId(id)
    return () => { c.setTitleId(undefined) }
  }
  merged = mergeProps({ id: id }, rest)
  <h2 {...merged}>{children}</h2>
}

export component DialogDescription({ children, ...rest }: ParagraphProps) {
  c = use dialog
  id = createId("dialog-description")
  effect () {
    c.setDescriptionId(id)
    return () => { c.setDescriptionId(undefined) }
  }
  merged = mergeProps({ id: id }, rest)
  <p {...merged}>{children}</p>
}

export fn dialogClose(ref c: DialogContext): PartProps {
  action press() { c.setOpen(false) }
  { type: "button", onClick: press }
}

export component DialogClose({ children, ...rest }: ButtonProps) {
  c = use dialog
  own = dialogClose(c)
  merged = mergeProps(own, rest)
  <button {...merged}>{children}</button>
}
