// A dialog on the native <dialog> element. The browser provides the top layer, the inert page behind it, focus
// moving in and back out, Escape and the ::backdrop; this family adds the open state, ARIA labelling and the
// exit animation. There is no Portal and no Backdrop part: the popup is the <dialog>, styled with `[open]`,
// `::backdrop`, `@starting-style` and `[data-ending-style]`.
import { mergeProps, createId, createRef } from "../internal/props.js"
import { createScrollLock } from "../internal/dom.js"
import { createNativeDialog } from "../internal/native.js"
import { ButtonProps, DialogElementProps, HeadingProps, ParagraphProps, PartProps } from "../internal/types.rx"

export type DialogContext = {
  open: boolean
  modal: boolean
  // "alertdialog" under AlertDialogRoot.
  role: "dialog" | "alertdialog"
  popupId: string
  titleId: string | undefined
  descriptionId: string | undefined
  setOpen: (open: boolean) => void
  setPopup: (element: HTMLDialogElement) => void
  setTitleId: (id: string | undefined) => void
  setDescriptionId: (id: string | undefined) => void
}

export context dialog: DialogContext

export type DialogRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // A modal dialog makes the rest of the page inert and locks its scroll. Default: true.
  modal?: boolean
  // Whether Escape and a press outside close it. Default: true.
  dismissible?: boolean
  // Whether a press outside is ignored (Escape still closes it). Default: false.
  disablePointerDismissal?: boolean
  // The popup's role. AlertDialogRoot sets "alertdialog". Default: "dialog".
  role?: "dialog" | "alertdialog"
  children?: View
}

export component DialogRoot(props: DialogRootProps) {
  source uncontrolled: boolean := peek(props.defaultOpen ?? false)
  source popup: HTMLDialogElement | undefined := undefined
  source titleId: string | undefined := undefined
  source descriptionId: string | undefined := undefined
  isOpen = props.open ?? uncontrolled
  isModal = props.modal ?? true
  popupId = createId("dialog")

  action setOpen(next: boolean) {
    if (next == isOpen) { return }
    uncontrolled := next
    if (props.onOpenChange) { props.onOpenChange(next) }
  }
  action requestClose(reason: "escape-key" | "outside-press" | "close") {
    if (reason != "close" && !(props.dismissible ?? true)) { return }
    if (reason == "outside-press" && (props.disablePointerDismissal ?? false)) { return }
    setOpen(false)
  }
  action writePopup(element: HTMLDialogElement) { popup := element }
  setPopup = createRef(writePopup)
  action setTitleId(id: string | undefined) { titleId := id }
  action setDescriptionId(id: string | undefined) { descriptionId := id }

  _dialog = createNativeDialog(popup, isOpen, isModal, requestClose)
  _lock = createScrollLock(isOpen && isModal)

  provide dialog = {
    open: isOpen,
    modal: isModal,
    role: props.role ?? "dialog",
    popupId: popupId,
    titleId: titleId,
    descriptionId: descriptionId,
    setOpen: setOpen,
    setPopup: setPopup,
    setTitleId: setTitleId,
    setDescriptionId: setDescriptionId,
  }

  {props.children}
}

export fn dialogTrigger(ref c: DialogContext): PartProps {
  action press() { c.setOpen(!c.open) }
  {
    type: "button",
    "aria-haspopup": "dialog",
    "aria-expanded": c.open ? "true" : "false",
    "aria-controls": c.popupId,
    "data-popup-open": c.open ? "" : undefined,
    onClick: press,
  }
}

export component DialogTrigger({ children, ...rest }: ButtonProps) {
  c = use dialog
  own = dialogTrigger(c)
  merged = mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

// Spread on a <dialog>. A <dialog> already has the dialog role; only "alertdialog" is written.
export fn dialogPopup(ref c: DialogContext): PartProps {
  {
    id: c.popupId,
    role: c.role == "alertdialog" ? "alertdialog" : undefined,
    "aria-labelledby": c.titleId,
    "aria-describedby": c.descriptionId,
    ref: c.setPopup,
  }
}

export component DialogPopup({ children, ...rest }: DialogElementProps) {
  c = use dialog
  own = dialogPopup(c)
  merged = mergeProps(own, rest)
  <dialog {...merged}>{children}</dialog>
}

export component DialogTitle({ children, ...rest }: HeadingProps) {
  c = use dialog
  id = createId("dialog-title")
  effect () {
    c.setTitleId(id)
    return () => { c.setTitleId(undefined) }
  }
  merged = mergeProps({ id: id }, rest)
  <h2 {...merged}>{children}</h2>
}

export component DialogDescription({ children, ...rest }: ParagraphProps) {
  c = use dialog
  id = createId("dialog-description")
  effect () {
    c.setDescriptionId(id)
    return () => { c.setDescriptionId(undefined) }
  }
  merged = mergeProps({ id: id }, rest)
  <p {...merged}>{children}</p>
}

export fn dialogClose(ref c: DialogContext): PartProps {
  action press() { c.setOpen(false) }
  { type: "button", onClick: press }
}

export component DialogClose({ children, ...rest }: ButtonProps) {
  c = use dialog
  own = dialogClose(c)
  merged = mergeProps(own, rest)
  <button {...merged}>{children}</button>
}
