// A menu that opens at the pointer: right-click (or the keyboard's context-menu key, Shift+F10, or a long press
// on touch) inside the trigger area. It is Menu underneath: every part below reads the `menu` context from
// ../menu/menu.rx, so a custom part imports `menu` and the `menu*` props functions from there.
//
// CSS anchor positioning anchors to an element, not a point, so the trigger area holds a zero-size element that
// is moved to the point the menu opens at, and the popup is anchored to it. The browser then places the popup
// below and to the right of the point and flips it at the viewport's edges. The anchor is `position: fixed`, so
// a transformed (or filtered, or `contain`ed) ancestor of the trigger area puts it in the wrong place.
import { MenuRoot, MenuPopup, MenuItem, MenuLinkItem, MenuCheckboxItem, MenuRadioGroup, MenuRadioItem, MenuGroup, MenuGroupLabel, MenuSeparator, MenuSubmenuRoot, MenuSubmenuTrigger, MenuContext, MenuPopupProps, menu } from "../menu/menu.rx"
import { mergeProps } from "../internal/props.js"
import { createLongPress, elementCorner, afterRelease, afterPointerRelease } from "../internal/menu.js"
import { DivProps, ButtonProps, AnchorProps, PartProps } from "../internal/types.rx"

export type ContextMenuRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // A disabled context menu doesn't open, and the browser's own menu shows instead. Default: false.
  disabled?: boolean
  children?: View
}

export component ContextMenuRoot(props: ContextMenuRootProps) {
  <MenuRoot open={props.open} defaultOpen={props.defaultOpen} onOpenChange={props.onOpenChange} disabled={props.disabled}>
    {props.children}
  </MenuRoot>
}

// Where the menu opens, in viewport coordinates: a point, or a small box around a finger.
export type ContextMenuPoint = { x: number; y: number; width: number; height: number }

type ElementRef = (element: HTMLElement) => void
type PlacePoint = (point: ContextMenuPoint) => void

// Spread on the area. `place` moves the anchor (contextMenuAnchor) to the point the menu opens at.
export fn contextMenuTrigger(ref c: MenuContext, ref setElement: ElementRef, ref place: PlacePoint): PartProps {
  // Set when the keyboard opened the menu: a platform that raises `contextmenu` for the key too (after the
  // keydown) is then not taken for a second, pointer, request. A pointer press clears it.
  source keyOpened: boolean := false
  action open() { c.openWith("container") }
  action contextMenu(event: MouseEvent) {
    if (c.disabled) { return }
    // The browser's own menu would cover ours.
    event.preventDefault()
    let fromKey = keyOpened
    if (fromKey) {
      keyOpened := false
      return
    }
    // In every engine the release of a press outside an open popover closes it (Firefox and Safari count the
    // right button too), so the menu opens once the press is released (afterPointerRelease). A menu already open
    // closes now and opens again at the new point.
    if (c.open) { c.setOpen(false) }
    place({ x: event.clientX, y: event.clientY, width: 0, height: 0 })
    afterPointerRelease(event, open)
  }
  action pointerDown() { keyOpened := false }
  action keyDown(event: KeyboardEvent & { target: HTMLElement }) {
    if (c.disabled || event.defaultPrevented) { return }
    if (event.key == "ContextMenu" || (event.shiftKey && event.key == "F10")) {
      event.preventDefault()
      let corner = elementCorner(event.target)
      place({ x: corner.x, y: corner.y, width: 0, height: 0 })
      keyOpened := true
      c.openWith("first-item")
    }
  }
  {
    "data-popup-open": c.open ? "" : undefined,
    "data-disabled": c.disabled ? "" : undefined,
    tabindex: c.disabled ? undefined : 0,
    ref: setElement,
    onContextMenu: contextMenu,
    onPointerDown: pointerDown,
    onKeyDown: keyDown,
  }
}

// Spread on an empty <span> inside the area: the element the popup is anchored to.
export fn contextMenuAnchor(ref c: MenuContext, ref point: ContextMenuPoint): PartProps {
  {
    "aria-hidden": "true",
    "data-bisque-context-menu-anchor": "",
    style: {
      position: "fixed",
      left: `${point.x}px`,
      top: `${point.y}px`,
      width: `${point.width}px`,
      height: `${point.height}px`,
      "pointer-events": "none",
    },
    ref: c.setTrigger,
  }
}

type TriggerActions = { openAt: (button: HTMLElement) => void }
context triggerActions: lane TriggerActions

// A single-press alternative inside the trigger area.
export component ContextMenuButton({ children, ...rest }: ButtonProps) {
  c = use menu
  trigger = use triggerActions
  action click(event: MouseEvent & { currentTarget: HTMLButtonElement }) {
    if (!event.defaultPrevented && !c.disabled) { trigger.openAt(event.currentTarget) }
  }
  merged = latest mergeProps({ type: "button", disabled: c.disabled, "aria-haspopup": "menu", "aria-expanded": c.open ? "true" : "false", "aria-controls": c.popupId, onClick: click }, rest)
  <button {...merged}>{children}</button>
}

// The context-menu key works from the focusable area or any focused descendant.
export component ContextMenuTrigger(props: DivProps) {
  { children, ...rest } = props
  c = use menu
  source element: HTMLElement | undefined := undefined
  source point: ContextMenuPoint := { x: 0, y: 0, width: 0, height: 0 }
  action setElement(el: HTMLElement) { element := el }
  action place(next: ContextMenuPoint) { point := next }
  // A finger resting still for half a second opens it at the finger, with a little room around the point, once
  // the finger lifts: its release would close a menu shown while it was down.
  action open() { c.openWith("container") }
  action longPress(x: number, y: number) {
    if (c.open) { c.setOpen(false) }
    point := { x: x, y: y, width: 10, height: 10 }
    afterRelease(open)
  }
  action openAt(button: HTMLElement) {
    let corner = elementCorner(button)
    place({ x: corner.x, y: corner.y, width: 0, height: 0 })
    c.openWith("first-item")
  }
  provide triggerActions = { openAt: openAt }
  _longPress = createLongPress(!c.disabled, element, 500, longPress)
  own = contextMenuTrigger(c, setElement, place)
  anchor = contextMenuAnchor(c, point)
  merged = latest mergeProps(own, rest)
  <div {...merged}><span {...anchor} />{props.children}</div>
}

// The menu. Default: below the point and starting at it (`side="bottom"`, `align="start"`).
export component ContextMenuPopup({ children, ...rest }: MenuPopupProps) {
  <MenuPopup {...rest}>{children}</MenuPopup>
}

export component ContextMenuItem({ disabled, closeOnClick, children, ...rest }: { disabled?: boolean; closeOnClick?: boolean } & DivProps) {
  <MenuItem disabled={disabled} closeOnClick={closeOnClick} {...rest}>{children}</MenuItem>
}

export component ContextMenuLinkItem({ closeOnClick, children, ...rest }: { closeOnClick?: boolean } & AnchorProps) {
  <MenuLinkItem closeOnClick={closeOnClick} {...rest}>{children}</MenuLinkItem>
}

export component ContextMenuCheckboxItem({ checked, defaultChecked, onCheckedChange, disabled, closeOnClick, children, ...rest }: { checked?: boolean; defaultChecked?: boolean; onCheckedChange?: (checked: boolean) => void; disabled?: boolean; closeOnClick?: boolean } & DivProps) {
  <MenuCheckboxItem checked={checked} defaultChecked={defaultChecked} onCheckedChange={onCheckedChange} disabled={disabled} closeOnClick={closeOnClick} {...rest}>{children}</MenuCheckboxItem>
}

export component ContextMenuRadioGroup(props: { value?: string; defaultValue?: string; onValueChange?: (value: string) => void } & DivProps) {
  // `children` stays unread here: MenuRadioGroup provides what the radio items inside read.
  { value, defaultValue, onValueChange, ...rest } = props
  <MenuRadioGroup {...rest} value={value} defaultValue={defaultValue} onValueChange={onValueChange}>{props.children}</MenuRadioGroup>
}

export component ContextMenuRadioItem({ value, disabled, closeOnClick, children, ...rest }: { value: string; disabled?: boolean; closeOnClick?: boolean } & DivProps) {
  <MenuRadioItem value={value} disabled={disabled} closeOnClick={closeOnClick} {...rest}>{children}</MenuRadioItem>
}

export component ContextMenuGroup(props: DivProps) {
  // `children` stays unread here: MenuGroup provides what the group label inside reads.
  <MenuGroup {...props}>{props.children}</MenuGroup>
}

export component ContextMenuGroupLabel({ children, ...rest }: DivProps) {
  <MenuGroupLabel {...rest}>{children}</MenuGroupLabel>
}

export component ContextMenuSeparator(props: DivProps) {
  <MenuSeparator {...props} />
}

export component ContextMenuSubmenuRoot(props: { open?: boolean; defaultOpen?: boolean; onOpenChange?: (open: boolean) => void; disabled?: boolean; children?: View }) {
  <MenuSubmenuRoot open={props.open} defaultOpen={props.defaultOpen} onOpenChange={props.onOpenChange} disabled={props.disabled}>
    {props.children}
  </MenuSubmenuRoot>
}

export component ContextMenuSubmenuTrigger({ disabled, openOnHover, delay, closeDelay, children, ...rest }: { disabled?: boolean; openOnHover?: boolean; delay?: number; closeDelay?: number } & ButtonProps) {
  <MenuSubmenuTrigger disabled={disabled} openOnHover={openOnHover} delay={delay} closeDelay={closeDelay} {...rest}>{children}</MenuSubmenuTrigger>
}
