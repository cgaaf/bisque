// A select on a custom listbox. A styleable native <select> (`appearance: base-select`) isn't shipped in Firefox
// yet, so the roles, selection, typeahead and keyboard navigation are the library's. The popup is a native
// `popover`: the trigger opens and closes it with `popovertarget`, and the browser provides the top layer,
// closing on Escape and on a press outside, and the placement against the trigger (CSS anchor positioning). There
// is no Portal, Positioner, Backdrop or Arrow part, and the items stay in the document while it is closed.
import { mergeProps, withoutHandlers, createId } from "../internal/props.js"
import { createRovingFocus, focusElement, focusListItem, clickElement } from "../internal/dom.js"
import { createTypeahead, elementText, itemValue, createOnShow, createLabels, createItemObserver, hasFocus } from "../internal/listbox.js"
import { createPopoverState, popoverTriggerProps, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { field, fieldControlProps } from "../field/field.rx"
import { DivProps, ButtonProps, SpanProps, PartProps } from "../internal/types.rx"

// A value and the text that names it: what SelectValue shows for a value whose item isn't rendered.
export type SelectItemLabel = { value: string; label: string }

export type SelectOpenFocus = "container" | "first-item" | "last-item" | "current-item"

// `popupId` (from PopoverState) is the listbox's id.
export type SelectContext = PopoverState & {
  multiple: boolean
  // The selected values: none or one, or any number when `multiple`.
  selected: string[]
  // What names each value: the `items` prop, then what each item registered.
  labels: SelectItemLabel[]
  disabled: boolean
  readOnly: boolean
  required: boolean
  // The app is fetching the options (the `loading` prop).
  loading: boolean
  // Where focus goes when the popup opens (`current-item` is the selected item, else the first).
  openFocus: SelectOpenFocus
  setOpenFocus: (focus: SelectOpenFocus) => void
  openWith: (focus: SelectOpenFocus) => void
  focusTrigger: () => void
  // Selects `value` (single: and closes), or toggles it (multiple).
  choose: (value: string) => void
  // Typeahead: on the closed trigger it selects the match, in the open popup it focuses it.
  typeClosed: (key: string) => void
  typeOpen: (key: string) => void
  resetTypeahead: () => void
  // Focus for an enclosing Field: in while on the trigger or in the popup, out once it leaves both.
  fieldFocus: () => void
  fieldBlur: (next: Node | null) => void
  // An item names its value: the label is kept after the item is gone, for the selected value.
  registerLabel: (value: string, label: string) => void
}

export context select: SelectContext

export type SelectRootProps = {
  // Single selection: the selected value, null for none.
  value?: string | null
  defaultValue?: string | null
  onValueChange?: (value: string | null) => void
  // Any number of values may be selected; they are then `values`, `defaultValues` and `onValuesChange`.
  multiple?: boolean
  values?: string[]
  defaultValues?: string[]
  onValuesChange?: (values: string[]) => void
  open?: boolean
  defaultOpen?: boolean
  // Called after the browser or a part opened or closed it. A press outside and Escape can't be refused: a
  // controlled select that keeps `open` true is shown again.
  onOpenChange?: (open: boolean) => void
  disabled?: boolean
  // The popup can be opened and browsed, but nothing can be selected.
  readOnly?: boolean
  required?: boolean
  // With a name (or inside a named FieldRoot) the select submits its value with a <form>; with `multiple`, one
  // entry per selected value.
  name?: string
  // The label of each value, when it must be known before its item has rendered, or differs from the item's text.
  items?: SelectItemLabel[]
  // Whether the options are being fetched (`pending? fruits` for `fruits = await loadFruits()`): the popup is
  // `aria-busy`, the parts carry `data-loading`, and SelectValue shows nothing for a value it can't name yet.
  loading?: boolean
  children?: View
}

// What SelectValue shows for a value: its label; while the options are loading, nothing for a value it can't name
// yet, rather than the raw value.
fn nameFor(labels: SelectItemLabel[], value: string, loading: boolean): string => labels.find((entry) => entry.value == value)?.label ?? (loading ? "" : value)

export component SelectRoot(props: SelectRootProps) {
  f = use field
  source single: string | null := peek(props.defaultValue ?? null)
  source many: string[] := peek([...(props.defaultValues ?? [])])
  [registered, registerLabel] = createLabels()
  source openFocus: SelectOpenFocus := "container"
  isMultiple = props.multiple ?? false
  currentSingle = props.value != undefined ? props.value : single
  selected = isMultiple ? props.values ?? many : currentSingle == null ? [] : [currentSingle]
  isDisabled = (props.disabled ?? false) || (f?.disabled ?? false)
  isReadOnly = props.readOnly ?? false
  isRequired = props.required ?? false
  // The app's handlers are called in a change of their own (`onFlush`), never in the change that updates the select:
  // a handler that writes something a loading question reads would hold the select's own state with it.
  action notifyOpen(next: boolean) {
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
  }
  action notifyValue(next: string | null) {
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(next) })
    }
  }
  action notifyValues(next: string[]) {
    if (props.onValuesChange) {
      let report = props.onValuesChange
      onFlush(() => { report(next) })
    }
  }
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), notifyOpen)
  // `items` and `loading` are often read from an answer that can fail: a failure there is the app's to show, in its
  // `errored` region around the items, not a reason for the root to fail.
  givenLabels = (props.items ?? []) catch (e) => []
  isLoading = (props.loading ?? false) catch (e) => false
  labels = [...givenLabels, ...registered]
  inputName = props.name ?? f?.name
  [match, resetMatch] = createTypeahead()

  action setOpenFocus(focus: SelectOpenFocus) { openFocus := focus }
  action openWith(focus: SelectOpenFocus) {
    if (isDisabled) { return }
    openFocus := focus
    state.setOpen(true)
  }
  action focusOpened() {
    if (openFocus == "container") {
      focusElement(state.popup)
    } else {
      focusListItem(state.popup, openFocus == "last-item" ? "last" : openFocus == "current-item" ? "current" : "first")
    }
  }
  action focusTrigger() { focusElement(state.trigger) }
  action choose(value: string) {
    if (isDisabled || isReadOnly) { return }
    if (isMultiple) {
      let next = selected.includes(value) ? selected.filter((other) => other != value) : [...selected, value]
      many := next
      notifyValues(next)
      return
    }
    if (currentSingle != value) {
      single := value
      notifyValue(value)
    }
    // Focus leaves the popup before it closes, so it lands on the trigger in every engine.
    focusElement(state.trigger)
    state.setOpen(false)
  }
  action typeClosed(key: string) {
    if (isDisabled || isReadOnly || isMultiple) { return }
    let found = itemValue(match(state.popup, key, currentSingle ?? undefined))
    if (found != undefined) { choose(found) }
  }
  action typeOpen(key: string) {
    focusElement(match(state.popup, key, undefined))
  }
  action resetTypeahead() { resetMatch() }
  action fieldFocus() { if (f) { f.setFocused(true) } }
  action fieldBlur(next: Node | null) {
    let inside = (state.popup != undefined && state.popup.contains(next)) || (state.trigger != undefined && state.trigger.contains(next))
    if (f && !inside) { f.setFocused(false) }
  }
  action setInput(element: HTMLInputElement) { if (f) { f.setInput(element) } }

  // Focus moves in once the popup is shown: an item can't take focus while it is hidden.
  _focusOnShow = createOnShow(state.popup, focusOpened)
  // Opened before its options arrived (they come from a server): focus waited on the popup itself, and moves to the
  // item it was meant for once they are there.
  action itemsArrived(count: number) {
    if (state.open && count > 0 && openFocus != "container" && hasFocus(state.popup)) { focusOpened() }
  }
  _items = createItemObserver(state.popup, itemsArrived)

  effect (selected) { if (f) { f.setValue(isMultiple ? $0 : $0.length > 0 ? $0[0] : null) } }

  provide select = {
    ...state,
    multiple: isMultiple,
    selected: selected,
    labels: labels,
    disabled: isDisabled,
    readOnly: isReadOnly,
    required: isRequired,
    loading: isLoading,
    openFocus: openFocus,
    setOpenFocus: setOpenFocus,
    openWith: openWith,
    focusTrigger: focusTrigger,
    choose: choose,
    typeClosed: typeClosed,
    typeOpen: typeOpen,
    resetTypeahead: resetTypeahead,
    fieldFocus: fieldFocus,
    fieldBlur: fieldBlur,
    registerLabel: registerLabel,
  }

  {props.children}
  {if inputName != undefined || f != undefined {
    <input hidden aria-hidden="true" tabindex="-1" name={isMultiple ? undefined : inputName} value={selected.join(",")} required={isRequired} disabled={isDisabled} ref={setInput} />
  }}
  {if isMultiple && inputName != undefined {
    {for entry in selected {
      <input type="hidden" name={inputName} value={entry} disabled={isDisabled} />
    }}
  }}
}

// The state attributes the trigger, value and icon share.
fn selectState(ref c: SelectContext): PartProps {
  {
    "data-popup-open": c.open ? "" : undefined,
    "data-disabled": c.disabled ? "" : undefined,
    "data-readonly": c.readOnly ? "" : undefined,
    "data-required": c.required ? "" : undefined,
    "data-loading": c.loading ? "" : undefined,
    "data-placeholder": c.selected.length == 0 ? "" : undefined,
  }
}

// Spread on a <button>: `popovertarget` makes the browser open and close the popup on a click, Enter and Space,
// and anchor the popup to it. The arrow keys open it through the select, and typing on the closed trigger selects.
export fn selectTrigger(ref c: SelectContext): PartProps {
  base = popoverTriggerProps(c)
  // A click from the keyboard (Enter, Space) has no pointer detail: it opens on the selected item, else the
  // first. A pointer opens on the selected item, else on the list itself.
  action press(event: MouseEvent) {
    c.setOpenFocus(event.detail == 0 || c.selected.length > 0 ? "current-item" : "container")
  }
  action keyDown(event: KeyboardEvent) {
    if (event.key == "ArrowDown") {
      event.preventDefault()
      if (!c.open) { c.openWith("current-item") }
    } else if (event.key == "ArrowUp") {
      event.preventDefault()
      if (!c.open) { c.openWith(c.selected.length > 0 ? "current-item" : "last-item") }
    } else if (!event.ctrlKey && !event.metaKey && !event.altKey && !c.open) {
      c.typeClosed(event.key)
    }
  }
  action focus() { c.fieldFocus() }
  action blur(event: FocusEvent & { relatedTarget: Node | null }) {
    c.resetTypeahead()
    c.fieldBlur(event.relatedTarget)
  }
  state = selectState(c)
  {
    ...base,
    role: "combobox",
    "aria-haspopup": "listbox",
    "aria-readonly": c.readOnly ? "true" : undefined,
    "aria-required": c.required ? "true" : undefined,
    disabled: c.disabled ? true : undefined,
    onClick: press,
    onKeyDown: keyDown,
    onFocus: focus,
    onBlur: blur,
    ...state,
  }
}

export component SelectTrigger({ children, ...rest }: ButtonProps) {
  c = use select
  f = use field
  // The field's focus handlers are left out: the trigger reports focus through the select, which counts the
  // popup as inside.
  fieldProps = fieldControlProps(f)
  inField = withoutHandlers(fieldProps, true)
  own = selectTrigger(c)
  withField = mergeProps(inField, own)
  merged = mergeProps(withField, rest)
  <button {...merged}>{children}</button>
}

export type SelectValueProps = {
  // Shown while nothing is selected (the value then carries `data-placeholder`).
  placeholder?: string
} & SpanProps

// The selected item's label (labels joined by ", " when `multiple`), or the placeholder.
export component SelectValue({ placeholder, children, ...rest }: SelectValueProps) {
  c = use select
  names = c.selected.map((value) => nameFor(c.labels, value, c.loading)).filter((name) => name != "")
  text = c.selected.length == 0 ? placeholder ?? "" : names.join(", ")
  state = selectState(c)
  merged = mergeProps(state, rest)
  <span {...merged}>{text}</span>
}

// A decoration beside the value (a chevron), hidden from assistive technology.
export component SelectIcon({ children, ...rest }: SpanProps) {
  c = use select
  state = selectState(c)
  merged = mergeProps({ "aria-hidden": "true", ...state }, rest)
  <span {...merged}>{children}</span>
}

export type SelectPopupProps = {
  // Which side of the trigger it sits on; the browser flips it when it doesn't fit. Default: "bottom".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the trigger it lines up with. Default: "start".
  align?: "start" | "center" | "end"
  // Gap between trigger and popup, in pixels. Default: 0.
  sideOffset?: number
  alignOffset?: number
} & DivProps

// The listbox, on a `popover="auto"` element placed against the trigger with CSS anchor positioning and at least
// as wide as it (`min-width: anchor-size(width)`). The browser closes it on Escape and on a press outside; style
// it with `:popover-open` and `@starting-style`.
export fn selectPopup(ref c: SelectContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  _roving = createRovingFocus(c.popup, { orientation: "vertical", loop: false, typeahead: false, tabStop: false })
  base = popoverPopupProps(c, "auto", side, align, sideOffset, alignOffset)
  action keyDown(event: KeyboardEvent) {
    if (event.key == "Tab") {
      // Tab leaves the select, so it closes.
      c.setOpen(false)
    } else if (event.key == "Escape") {
      // The browser closes it; focus goes back to the trigger first, which the browser alone does only when
      // the trigger had focus when it opened (Safari doesn't focus a clicked button).
      c.focusTrigger()
    } else if (!event.ctrlKey && !event.metaKey && !event.altKey) {
      c.typeOpen(event.key)
    }
  }
  action focusOut(event: FocusEvent & { relatedTarget: Node | null }) { c.fieldBlur(event.relatedTarget) }
  {
    ...base,
    style: { ...base.style, "min-width": "anchor-size(width)" },
    role: "listbox",
    tabindex: "-1",
    "aria-multiselectable": c.multiple ? "true" : undefined,
    "aria-readonly": c.readOnly ? "true" : undefined,
    "aria-busy": c.loading ? "true" : undefined,
    "data-loading": c.loading ? "" : undefined,
    onKeyDown: keyDown,
    onFocusOut: focusOut,
  }
}

// The items stay in the document while it is closed: they name the selected value and answer typeahead on the
// closed trigger.
export component SelectPopup({ side = "bottom", align = "start", sideOffset = 0, alignOffset = 0, children, ...rest }: SelectPopupProps) {
  c = use select
  own = selectPopup(c, side, align, sideOffset, alignOffset)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export type SelectItemContext = {
  selected: boolean
  disabled: boolean
  highlighted: boolean
  setText: (element: HTMLElement) => void
}

export context selectItemState: SelectItemContext

export type SelectItemProps = {
  value: string
  // The text that names the value, in SelectValue and for typeahead. Default: SelectItemText's text, else the
  // item's.
  label?: string
  disabled?: boolean
} & DivProps

export fn selectItem(ref c: SelectContext, ref value: string, ref label: string | undefined, ref disabled: boolean, ref highlighted: boolean, ref onHighlight: ((highlighted: boolean) => void)): PartProps {
  isSelected = c.selected.includes(value)
  action focus() { onHighlight(true) }
  action blur() { onHighlight(false) }
  action pointerMove(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (!disabled) { focusElement(event.currentTarget) }
  }
  action keyDown(event: KeyboardEvent & { currentTarget: HTMLElement }) {
    if (event.key == "Enter" || event.key == " ") {
      event.preventDefault()
      clickElement(event.currentTarget)
    }
  }
  action click() { if (!disabled) { c.choose(value) } }
  {
    role: "option",
    tabindex: "-1",
    "aria-selected": isSelected ? "true" : "false",
    "aria-disabled": disabled ? "true" : undefined,
    "data-rs-ui-item": "",
    "data-rs-ui-current": isSelected ? "" : undefined,
    "data-value": value,
    "data-label": label,
    "data-selected": isSelected ? "" : undefined,
    "data-highlighted": highlighted ? "" : undefined,
    "data-disabled": disabled ? "" : undefined,
    onFocus: focus,
    onBlur: blur,
    onPointerMove: pointerMove,
    onKeyDown: keyDown,
    onClick: click,
  }
}

export component SelectItem(props: SelectItemProps) {
  c = use select
  source highlighted: boolean := false
  source element: HTMLElement | undefined := undefined
  source textElement: HTMLElement | undefined := undefined
  isDisabled = props.disabled ?? false
  isSelected = c.selected.includes(props.value)
  action highlight(next: boolean) { highlighted := next }
  action setElement(el: HTMLElement) { element := el }
  action setText(el: HTMLElement) { textElement := el }

  // Register the value's label once the item (and its text) are in the document. No cleanup: the label goes on
  // naming the value after the item is gone, and an item removed with its `for` row can't call an action from a
  // cleanup.
  effect (element) {
    if ($0) { c.registerLabel(peek(props.value), peek(props.label) ?? elementText(peek(textElement) ?? $0)) }
  }

  provide selectItemState = { selected: isSelected, disabled: isDisabled, highlighted: highlighted, setText: setText }

  { value, label, disabled, children, ...rest } = props
  own = selectItem(c, value, label, isDisabled, highlighted, highlight)
  withRef = mergeProps(own, { ref: setElement })
  merged = mergeProps(withRef, withoutHandlers(rest, isDisabled))
  <div {...merged}>{children}</div>
}

// The item's text: what SelectValue shows for it, when the item holds more than its label (an indicator).
export component SelectItemText({ children, ...rest }: SpanProps) {
  item = use selectItemState
  action setText(element: HTMLElement) { item.setText(element) }
  merged = mergeProps({ ref: setText }, rest)
  <span {...merged}>{children}</span>
}

// Shown while its item is selected, unless `keepMounted`.
export component SelectItemIndicator({ keepMounted = false, children, ...rest }: { keepMounted?: boolean } & SpanProps) {
  item = use selectItemState
  merged = mergeProps({ "aria-hidden": "true", "data-selected": item.selected ? "" : undefined }, rest)
  {if item.selected || keepMounted {
    <span {...merged}>{children}</span>
  }}
}

export type SelectGroupContext = {
  labelId: string | undefined
  setLabelId: (id: string | undefined) => void
}

export context selectGroup: SelectGroupContext

export component SelectGroup(props: DivProps) {
  source labelId: string | undefined := undefined
  action setLabelId(id: string | undefined) { labelId := id }
  provide selectGroup = { labelId: labelId, setLabelId: setLabelId }
  { children, ...rest } = props
  merged = mergeProps({ role: "group", "aria-labelledby": labelId }, rest)
  <div {...merged}>{children}</div>
}

export component SelectGroupLabel({ children, ...rest }: DivProps) {
  group = use selectGroup
  id = createId("select-group-label")
  // No cleanup: a label removed with a `for` row can't call an action from a cleanup, and its group goes with it.
  effect () { group.setLabelId(id) }
  merged = mergeProps({ id: id }, rest)
  <div {...merged}>{children}</div>
}

export component SelectSeparator(props: DivProps) {
  merged = mergeProps({ role: "separator", "aria-orientation": "horizontal" }, props)
  <div {...merged} />
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn selectArrow(ref c: SelectContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component SelectArrow({ children, ...rest }: DivProps) {
  c = use select
  own = selectArrow(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
