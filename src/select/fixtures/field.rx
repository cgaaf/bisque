import { SelectRoot, SelectTrigger, SelectValue, SelectPortal, SelectPositioner, SelectPopup, SelectItem } from "../select.rx"
import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../field/field.rx"
import { Form } from "../../form/form.rx"

export default component Fixture() {
  source submitted := ""
  <Form data-testid="form" onFormSubmit={(values) => { submitted := `size=${values.size}` }}>
    <FieldRoot name="size" data-testid="size-root">
      <FieldLabel>Size</FieldLabel>
      <SelectRoot required>
        <SelectTrigger><SelectValue placeholder="Choose" /></SelectTrigger>
        <SelectPortal>
          <SelectPositioner>
            <SelectPopup>
              <SelectItem value="s">Small</SelectItem>
              <SelectItem value="l">Large</SelectItem>
            </SelectPopup>
          </SelectPositioner>
        </SelectPortal>
      </SelectRoot>
      <FieldDescription data-testid="size-description">Pick one.</FieldDescription>
      <FieldError data-testid="size-error">Choose a size</FieldError>
    </FieldRoot>
    <FieldRoot disabled>
      <FieldLabel>Locked</FieldLabel>
      <SelectRoot>
        <SelectTrigger><SelectValue /></SelectTrigger>
        <SelectPortal>
          <SelectPositioner>
            <SelectPopup>
              <SelectItem value="x">X</SelectItem>
            </SelectPopup>
          </SelectPositioner>
        </SelectPortal>
      </SelectRoot>
    </FieldRoot>
    <button type="submit">Submit</button>
    <output data-testid="submitted">{submitted}</output>
  </Form>
}
