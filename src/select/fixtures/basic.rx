import { SelectRoot, SelectTrigger, SelectValue, SelectIcon, SelectPopup, SelectItem, SelectItemText, SelectItemIndicator, SelectGroup, SelectGroupLabel, SelectSeparator } from "../select.rx"

export default component Fixture() {
  source changes := ""
  source opens := ""
  <form data-testid="form" style="padding: 80px 0 0 120px">
    <input aria-label="Before" />
    <SelectRoot name="fruit" onValueChange={(next) => { changes := `${changes}${next ?? "null"};` }} onOpenChange={(next) => { opens := `${opens}${next ? "open" : "close"};` }}>
      <SelectTrigger data-testid="trigger" style="width: 200px">
        <SelectValue data-testid="value" placeholder="Pick a fruit" />
        <SelectIcon>▾</SelectIcon>
      </SelectTrigger>
      <SelectPopup sideOffset={4} style="padding: 0; border: 0">
        <SelectGroup>
          <SelectGroupLabel>Fruits</SelectGroupLabel>
          <SelectItem value="apple"><SelectItemIndicator>✓</SelectItemIndicator><SelectItemText>Apple</SelectItemText></SelectItem>
          <SelectItem value="apricot" disabled><SelectItemIndicator>✓</SelectItemIndicator><SelectItemText>Apricot</SelectItemText></SelectItem>
          <SelectItem value="avocado"><SelectItemIndicator>✓</SelectItemIndicator><SelectItemText>Avocado</SelectItemText></SelectItem>
          <SelectItem value="banana"><SelectItemIndicator>✓</SelectItemIndicator><SelectItemText>Banana</SelectItemText></SelectItem>
        </SelectGroup>
        <SelectSeparator />
        <SelectItem value="fr" label="France">Option FR</SelectItem>
      </SelectPopup>
    </SelectRoot>
    <input aria-label="After" />
    <output data-testid="changes">{changes}</output>
    <output data-testid="opens">{opens}</output>
  </form>
}
