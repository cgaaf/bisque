import { SelectRoot, SelectTrigger, SelectValue, SelectPortal, SelectPositioner, SelectPopup, SelectItem } from "../select.rx"

export default component Fixture() {
  source fruit: string | null := "cherry"
  source open: boolean := false
  source fixed: string | null := "b"
  <main>
    <SelectRoot value={fruit} onValueChange={(next) => { fruit := next }} open={open} onOpenChange={(next) => { open := next }} items={[{ value: "cherry", label: "Cherry" }, { value: "plum", label: "Plum" }]}>
      <SelectTrigger data-testid="trigger"><SelectValue data-testid="value" /></SelectTrigger>
      <SelectPortal>
        <SelectPositioner>
          <SelectPopup data-testid="popup">
            <SelectItem value="cherry">Cherry</SelectItem>
            <SelectItem value="plum">Plum</SelectItem>
          </SelectPopup>
        </SelectPositioner>
      </SelectPortal>
    </SelectRoot>
    <output data-testid="fruit">{fruit ?? "null"}</output>
    <output data-testid="open">{open ? "open" : "closed"}</output>
    <button type="button" onClick={() => { fruit := "plum" }}>Set plum</button>
    <button type="button" onClick={() => { fruit := null }}>Clear</button>
    <SelectRoot value={fixed} onValueChange={(next) => { fixed := next }} readOnly>
      <SelectTrigger data-testid="readonly-trigger"><SelectValue /></SelectTrigger>
      <SelectPortal>
        <SelectPositioner>
          <SelectPopup>
            <SelectItem value="a">A</SelectItem>
            <SelectItem value="b">B</SelectItem>
          </SelectPopup>
        </SelectPositioner>
      </SelectPortal>
    </SelectRoot>
    <SelectRoot disabled>
      <SelectTrigger data-testid="disabled-trigger"><SelectValue placeholder="Off" /></SelectTrigger>
      <SelectPortal>
        <SelectPositioner>
          <SelectPopup>
            <SelectItem value="x">X</SelectItem>
          </SelectPopup>
        </SelectPositioner>
      </SelectPortal>
    </SelectRoot>
  </main>
}
