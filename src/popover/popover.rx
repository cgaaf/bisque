// A popover on the native `popover` attribute. The browser provides the top layer, closing on Escape and on a
// press outside, focus order (the popup follows its trigger), and the placement against the trigger with CSS
// anchor positioning. This family adds the open state and ARIA labelling. There is no Portal, Positioner or
// Backdrop part: the popup is the positioned element, styled with `:popover-open`, `::backdrop` and
// `@starting-style`. For a modal popup that traps focus, use Dialog.
//
// With `openOnHover` on the trigger it also opens when the pointer rests on the trigger, and closes when the
// pointer leaves both trigger and popup. No engine-wide native hover trigger exists yet (`interestfor`), so that
// part is the library's hover intent (../internal/overlay.js).
import { mergeProps, createId } from "../internal/props.js"
import { createHoverIntent } from "../internal/overlay.js"
import { createKeptFocus } from "../internal/dom.js"
import { createPopoverState, popoverTriggerProps, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { DivProps, ButtonProps, HeadingProps, ParagraphProps, PartProps } from "../internal/types.rx"

export type PopoverContext = PopoverState & {
  titleId: string | undefined
  descriptionId: string | undefined
  setTitleId: (id: string | undefined) => void
  setDescriptionId: (id: string | undefined) => void
}

export context popover: PopoverContext

export type PopoverRootProps = {
  open?: boolean
  defaultOpen?: boolean
  // Called after the browser or a part opened or closed it. A press outside and Escape can't be refused: a
  // controlled popover that keeps `open` true is shown again.
  onOpenChange?: (open: boolean) => void
  children?: View
}

export component PopoverRoot(props: PopoverRootProps) {
  source titleId: string | undefined := undefined
  source descriptionId: string | undefined := undefined
  // The app's handler is called in a change of its own (`onFlush`): one that writes what a loading question reads,
  // or that awaits, would otherwise hold the popover's own change, and the browser's open popover would be hidden
  // again to match the held state.
  action notifyOpen(next: boolean) {
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
  }
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), notifyOpen)
  // Content that loads or fails inside the open popup replaces what had focus: focus stays in the popup.
  _focus = createKeptFocus(state.popup, state.open)
  action setTitleId(id: string | undefined) { titleId := id }
  action setDescriptionId(id: string | undefined) { descriptionId := id }

  provide popover = { ...state, titleId: titleId, descriptionId: descriptionId, setTitleId: setTitleId, setDescriptionId: setDescriptionId }

  {props.children}
}

export type PopoverTriggerProps = {
  // Whether resting the pointer on the trigger also opens the popover. A press still toggles it. Default: false.
  openOnHover?: boolean
  // With `openOnHover`: how long the pointer rests on the trigger before it opens, in ms. Default: 300.
  delay?: number
  // With `openOnHover`: how long after the pointer leaves trigger and popup before it closes, in ms. Default: 0.
  closeDelay?: number
} & ButtonProps

// Spread on a <button>: the browser's `popovertarget` does the opening and closing on a press. With
// `openOnHover`, hovering opens it too; leaving closes only what hover opened, and a press while hover has it
// open keeps it open instead of toggling it shut.
export fn popoverTrigger(ref c: PopoverContext, ref openOnHover: boolean, ref delay: number, ref closeDelay: number): PartProps {
  action change(next: boolean, reason: "hover" | "focus" | "press" | "group") { c.setOpen(next) }
  _hover = createHoverIntent(openOnHover, c.open, c.trigger, c.popup, {
    openDelay: delay,
    closeDelay: closeDelay,
    hoverablePopup: true,
    focus: false,
    focusDelay: 0,
    closeOnPress: false,
    group: undefined,
    stickOnPress: true,
  }, change)
  base = popoverTriggerProps(c)
  { ...base, "aria-haspopup": "dialog" }
}

export component PopoverTrigger({ openOnHover = false, delay = 300, closeDelay = 0, children, ...rest }: PopoverTriggerProps) {
  c = use popover
  own = popoverTrigger(c, latest openOnHover, latest delay, latest closeDelay)
  merged = latest mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

export type PopoverPopupProps = {
  // Which side of the trigger it sits on; the browser flips it when it doesn't fit. Default: "bottom".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the trigger it lines up with. Default: "center".
  align?: "start" | "center" | "end"
  // Gap between trigger and popup, in pixels. Default: 0.
  sideOffset?: number
  alignOffset?: number
} & DivProps

export fn popoverPopup(ref c: PopoverContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(c, "auto", side, align, sideOffset, alignOffset)
  // Each read of the context is an equation of its own: the context is rebuilt whenever the popup opens or closes,
  // and this object, reading it directly, was rebuilt with it, new but equal each time (UNSTABLE_MEMO_OUTPUT once a
  // controlled popover had opened and closed twice).
  titleId = c.titleId
  descriptionId = c.descriptionId
  { ...base, role: "dialog", "aria-labelledby": titleId, "aria-describedby": descriptionId }
}

export component PopoverPopup({ side = "bottom", align = "center", sideOffset = 0, alignOffset = 0, children, ...rest }: PopoverPopupProps) {
  c = use popover
  own = popoverPopup(c, side, align, sideOffset, alignOffset)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export component PopoverTitle({ children, ...rest }: HeadingProps) {
  c = use popover
  id = createId("popover-title")
  effect () {
    c.setTitleId(id)
    return () => { c.setTitleId(undefined) }
  }
  merged = latest mergeProps({ id: id }, rest)
  <h2 {...merged}>{children}</h2>
}

export component PopoverDescription({ children, ...rest }: ParagraphProps) {
  c = use popover
  id = createId("popover-description")
  effect () {
    c.setDescriptionId(id)
    return () => { c.setDescriptionId(undefined) }
  }
  merged = latest mergeProps({ id: id }, rest)
  <p {...merged}>{children}</p>
}

export fn popoverClose(ref c: PopoverContext): PartProps {
  action press() { c.setOpen(false) }
  { type: "button", onClick: press }
}

export component PopoverClose({ children, ...rest }: ButtonProps) {
  c = use popover
  own = popoverClose(c)
  merged = latest mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn popoverArrow(ref c: PopoverContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component PopoverArrow({ children, ...rest }: DivProps) {
  c = use popover
  own = popoverArrow(c)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
