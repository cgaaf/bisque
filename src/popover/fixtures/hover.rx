import { PopoverRoot, PopoverTrigger, PopoverPortal, PopoverPositioner, PopoverPopup, PopoverTitle } from "../popover.rx"

export default component Fixture() {
  source changes := 0
  <main>
    <PopoverRoot onOpenChange={(open) => { changes := changes + 1 }}>
      <PopoverTrigger openOnHover delay={200} closeDelay={100}>Profile</PopoverTrigger>
      <PopoverPortal>
        <PopoverPositioner data-testid="positioner">
          <PopoverPopup data-testid="popup">
            <PopoverTitle>Ada</PopoverTitle>
            <button>Follow</button>
          </PopoverPopup>
        </PopoverPositioner>
      </PopoverPortal>
    </PopoverRoot>
    <p data-testid="outside">Elsewhere</p>
    <output data-testid="changes">{changes}</output>
  </main>
}
