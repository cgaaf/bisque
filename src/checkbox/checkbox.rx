// A checkbox on the native <input type="checkbox">, which can be styled whole with `appearance: none`. The browser
// provides the checked state, Space, label association, form submission, `required` validation and the style hooks
// `:checked`, `:indeterminate`, `:disabled`, `:focus-visible` and `:user-invalid`. This family adds a controlled
// value, `readOnly`, `indeterminate` (a property with no attribute), the checkbox group, and the Field wiring.
//
// An <input> can't have children, so CheckboxRoot renders its children right after the box: CheckboxIndicator, or
// any element of the consumer's, is the box's next sibling and is styled from it (`input:checked + span`), or the
// box draws its own mark (`input:checked::before`).
import { mergeProps, createRef } from "../internal/props.js"
import { createFormReset } from "../internal/field.js"
import { createCheckedInput } from "../internal/checked-input.js"
import { createFocusKeeper } from "../internal/focus-keeper.js"
import { field, fieldInputProps } from "../field/field.rx"
import { checkboxGroup } from "../checkbox-group/checkbox-group.rx"
import { InputProps, SpanProps } from "../internal/types.rx"

// For a custom indicator that renders differently per state (CheckboxRoot provides it to its children).
export type CheckboxContext = {
  checked: boolean
  indeterminate: boolean
  disabled: boolean
  readOnly: boolean
  required: boolean
}

export context checkbox: CheckboxContext

export type CheckboxRootProps = {
  checked?: boolean
  defaultChecked?: boolean
  onCheckedChange?: (checked: boolean) => void
  // Neither checked nor unchecked: a parent box whose children are mixed. A press clears it and toggles the box,
  // as the browser does; a controlled `indeterminate` that stays true is set again.
  indeterminate?: boolean
  disabled?: boolean
  // Focusable and announced, but a press doesn't change it (`readonly` has no effect on a native checkbox).
  readOnly?: boolean
  required?: boolean
  // With a name (or inside a named FieldRoot), the box submits `value` (default "on") with its form while checked.
  name?: string
  // Inside a CheckboxGroup, also the value the group's list holds while the box is checked.
  value?: string
  // Inside a CheckboxGroup with `allValues`: the box that checks or clears them all, mixed while some are checked.
  parent?: boolean
  // Rendered after the box, as its siblings: a CheckboxIndicator or the consumer's own.
  children?: View
} & Omit<InputProps, "value" | "name" | "disabled" | "checked" | "defaultChecked" | "readOnly" | "readonly" | "required" | "type" | "children">

export component CheckboxRoot(props: CheckboxRootProps) {
  f = use field
  group = use checkboxGroup
  source uncontrolled := peek(props.defaultChecked ?? false)
  // Counts form resets, so the box is set back to the state after one (createCheckedInput).
  source revision := 0
  source element: HTMLInputElement | undefined := undefined
  isParent = group != undefined && (props.parent ?? false)
  // A member of a group: a box with a value inside one. The group, not the box, is then the field's control.
  inGroup = group != undefined && !isParent && props.value != undefined
  groupValue = group?.value ?? []
  groupAll = group?.allValues ?? []
  // `checked`, `indeterminate` and `disabled` are often read from an answer that can fail (`checked={setting}` with
  // `setting = await load()`): a failure there is the app's to show, in its `errored` region, not the box's.
  givenChecked = props.checked catch (e) => undefined
  givenIndeterminate = (props.indeterminate ?? false) catch (e) => false
  givenDisabled = (props.disabled ?? false) catch (e) => false
  isChecked = isParent ? groupAll.length > 0 && groupValue.length == groupAll.length : inGroup ? groupValue.includes(props.value ?? "") : givenChecked ?? uncontrolled
  // Plain values first, then the objects built from them: a group's context is a new object on every change, and
  // a box's own objects (`self`, `own`) should be rebuilt only when something about this box changed.
  isIndeterminate = isParent ? groupValue.length > 0 && groupValue.length < groupAll.length : givenIndeterminate
  isDisabled = givenDisabled || (f?.disabled ?? false) || (group?.disabled ?? false)
  isReadOnly = props.readOnly ?? false
  isRequired = props.required ?? false
  self = {
    checked: isChecked,
    indeterminate: isIndeterminate,
    disabled: isDisabled,
    readOnly: isReadOnly,
    required: isRequired,
  }
  fieldOf = group == undefined ? f : undefined
  inputName = isParent ? undefined : props.name ?? f?.name
  // The box's `defaultChecked`: what a form reset puts back, which for an uncontrolled box is its default.
  initialChecked = peek(isChecked)

  effect (isChecked) { if (fieldOf) { fieldOf.setValue($0) } }
  _input = createCheckedInput(element, isChecked, isIndeterminate, revision + (group?.revision ?? 0))
  // Inside a group, the group answers a reset for all its boxes.
  _reset = createFormReset(group == undefined ? element : undefined, reset)
  // Disabled while it had focus (`disabled={pending? setting}`), it takes focus back when re-enabled.
  _focus = createFocusKeeper(element, isDisabled)

  // The owner's handler is called in a change of its own (`onFlush`), never in the one that updates this box: a
  // handler that saves (an action that awaits, or a write a loading question reads) holds its change until the
  // answer lands, and the box would be held with it, showing the browser's toggle whatever the owner decided.
  action notify(next: boolean) {
    if (props.onCheckedChange) {
      let report = props.onCheckedChange
      onFlush(() => { report(next) })
    }
  }

  // The browser has already toggled the box: report that, and let the state decide what it shows. The box is set
  // back to the state once the owner's change has run too (createCheckedInput).
  action change(event: Event & { currentTarget: HTMLInputElement }) {
    let next = event.currentTarget.checked
    if (isParent && group) {
      group.pressParent()
    } else if (inGroup && group) {
      group.setChecked(props.value ?? "", next)
    } else {
      uncontrolled := next
    }
    notify(next)
  }
  // The browser has put the box back to `defaultChecked`. Uncontrolled, that is the new state, reported once if it
  // changed; controlled, the owner's state is written back over it.
  action reset() {
    revision := revision + 1
    let next = givenChecked ?? initialChecked
    if (givenChecked == undefined && next != uncontrolled) {
      uncontrolled := next
      notify(next)
    }
    if (fieldOf) { fieldOf.reset(next) }
  }
  // Cancelling the click is what keeps a native box unchanged: the browser restores it and fires no change.
  action click(event: MouseEvent) { if (isReadOnly) { event.preventDefault() } }
  action writeElement(input: HTMLInputElement) {
    element := input
    if (fieldOf) { fieldOf.setInput(input) }
  }
  setElement = createRef(writeElement)

  provide checkbox = self

  { checked, defaultChecked, onCheckedChange, indeterminate, disabled, readOnly, required, name, value, parent, children, ...rest } = props
  inField = fieldInputProps(fieldOf)
  own = mergeProps(inField, {
    type: "checkbox",
    name: inputName,
    value: value,
    defaultChecked: initialChecked,
    disabled: isDisabled ? true : undefined,
    required: isRequired ? true : undefined,
    "aria-readonly": isReadOnly ? "true" : undefined,
    "data-readonly": isReadOnly ? "" : undefined,
    "data-parent": isParent ? "" : undefined,
    ref: setElement,
    onChange: change,
    onClick: click,
  })
  merged = mergeProps(own, rest)
  <input {...merged} />
  {children}
}

// A mark beside the box, always in the document: place it in CheckboxRoot, where it is the box's next sibling,
// and show it with `input:checked + *` and `input:indeterminate + *`. Hidden from assistive technology, which
// hears the box's own state.
export component CheckboxIndicator({ children, ...rest }: SpanProps) {
  merged = mergeProps({ "aria-hidden": "true" }, rest)
  <span {...merged}>{children}</span>
}
