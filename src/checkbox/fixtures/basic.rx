import { CheckboxRoot, CheckboxIndicator, checkbox } from "../checkbox.rx"

// A custom indicator: reads the box's state from the context.
component Mark() {
  c = use checkbox
  <span data-testid="mark" aria-hidden="true">{c.indeterminate ? "–" : c.checked ? "✓" : ""}</span>
}

export default component Fixture() {
  source agreed := false
  source changes := 0
  source mixed := true
  source newsChanges: string[] := []
  <form data-testid="form">
    <label>
      <CheckboxRoot name="terms" value="yes" checked={agreed} onCheckedChange={(next) => { agreed := next }}>
        <CheckboxIndicator data-testid="indicator">✓</CheckboxIndicator>
      </CheckboxRoot>
      Accept terms
    </label>
    <output data-testid="agreed">{agreed ? "yes" : "no"}</output>
    <label><CheckboxRoot name="news" defaultChecked onCheckedChange={(next) => { newsChanges := [...newsChanges, next ? "on" : "off"] }} />News</label>
    <output data-testid="news-changes">{newsChanges.join(",")}</output>
    <label><CheckboxRoot checked={false} onCheckedChange={() => { changes := changes + 1 }} />Refused</label>
    <output data-testid="changes">{changes}</output>
    <label><CheckboxRoot indeterminate={mixed}><Mark /></CheckboxRoot>Select all</label>
    <button type="button" onClick={() => { mixed := !mixed }}>Toggle mixed</button>
    <button type="button" onClick={() => { agreed := !agreed }}>Agree from outside</button>
    <CheckboxRoot aria-label="Locked" disabled defaultChecked />
    <CheckboxRoot aria-label="Fixed" readOnly />
    <button type="reset">Reset</button>
  </form>
}
