// Site navigation: a list of links and of triggers that each open a panel of content. Each item's Content is a
// `popover="auto"` element declared beside its trigger and placed against it with CSS anchor positioning. The
// browser provides the top layer, closing on Escape and on a press outside, one open at a time (showing one
// content closes the other), and the Tab order: the content follows its trigger in the document, so Tab moves
// from an open trigger into its content and on past it. This family adds the open item's value, hover intent,
// the list's arrow keys, focus moving into the content from the keyboard and back to the trigger when it
// closes, closing when focus leaves, and ARIA.
//
// There is no Portal, Positioner, Popup, Viewport or Backdrop part: content stays where it is declared
// and is the positioned element, styled with `:popover-open` and `@starting-style`.
import { mergeProps, withoutHandlers, createId } from "../internal/props.js"
import { createHoverIntent } from "../internal/overlay.js"
import { createCompositeFocus } from "../internal/composite-focus.js"
import { activationDirection, containsTarget, focusFirstIn, createContentFocus } from "../internal/navigation-menu.js"
import { createPopoverState, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { DivProps, ButtonProps, AnchorProps, NavProps, ListProps, ListItemProps, SpanProps, PartProps } from "../internal/types.rx"

export type NavigationMenuOrientation = "horizontal" | "vertical"
export type NavigationMenuOpenReason = "hover" | "click" | "keyboard"
export type NavigationMenuDirection = "left" | "right" | "up" | "down" | undefined

export type NavigationMenuContext = {
  // The value of the item whose content is shown; undefined while closed.
  value: string | undefined
  orientation: NavigationMenuOrientation
  openReason: NavigationMenuOpenReason
  // Where the previously open item was, relative to the one now open.
  activationDirection: NavigationMenuDirection
  // Whether focus moves into the content when it opens (it was opened from the keyboard).
  enter: boolean
  delay: number
  closeDelay: number
  setValue: (value: string | undefined, reason: NavigationMenuOpenReason, trigger: HTMLElement | undefined) => void
}

export context navigationMenu: NavigationMenuContext

export type NavigationMenuRootProps = {
  // The open item's value; `null` for closed. Leave it out to let the menu keep its own.
  value?: string | null
  defaultValue?: string
  // Called once per change, including when the browser closed the content (Escape, a press outside).
  onValueChange?: (value: string | null) => void
  orientation?: NavigationMenuOrientation
  // How long the pointer rests on a trigger before its content opens, in ms. Default: 50.
  delay?: number
  // How long after the pointer leaves before the content closes, in ms. Default: 50.
  closeDelay?: number
  children?: View
} & Omit<NavProps, "children">

export component NavigationMenuRoot(props: NavigationMenuRootProps) {
  source uncontrolled: string | undefined := peek(props.defaultValue)
  source openReason: NavigationMenuOpenReason := "click"
  source enter := false
  source direction: NavigationMenuDirection := undefined
  source activeTrigger: HTMLElement | undefined := undefined
  current = props.value == null ? undefined : (props.value ?? uncontrolled)
  dir = props.orientation ?? "horizontal"

  action setValue(next: string | undefined, reason: NavigationMenuOpenReason, trigger: HTMLElement | undefined) {
    if (next == undefined) {
      enter := false
      direction := undefined
    } else {
      if (current != undefined && next != current) {
        direction := activationDirection(activeTrigger, trigger, dir)
      }
      if (next != current) { enter := reason == "keyboard" }
      openReason := reason
      if (trigger) { activeTrigger := trigger }
    }
    if (next == current) { return }
    uncontrolled := next
    if (props.onValueChange) { props.onValueChange(next ?? null) }
  }

  provide navigationMenu = {
    value: current,
    orientation: dir,
    openReason: openReason,
    activationDirection: direction,
    enter: enter,
    delay: props.delay ?? 50,
    closeDelay: props.closeDelay ?? 50,
    setValue: setValue,
  }

  { value, defaultValue, onValueChange, orientation, delay, closeDelay, children, ...rest } = props
  merged = mergeProps({ "aria-orientation": dir, "data-orientation": dir }, rest)
  <nav {...merged}>{children}</nav>
}

// The list of items. One Tab stop: the arrow keys along the orientation move between its triggers and links.
type ElementRef = (element: HTMLElement) => void

export fn navigationMenuList(ref nav: NavigationMenuContext, ref setElement: ElementRef): PartProps {
  { "data-orientation": nav.orientation, ref: setElement }
}

export component NavigationMenuList({ children, ...rest }: ListProps) {
  nav = use navigationMenu
  source element: HTMLElement | undefined := undefined
  action setElement(el: HTMLElement) { element := el }
  _focus = createCompositeFocus(element, { orientation: nav.orientation, loop: false, homeEnd: true })
  own = navigationMenuList(nav, setElement)
  merged = mergeProps(own, rest)
  <ul {...merged}>{children}</ul>
}

// An item's value and its content's popover: the trigger and the content read it.
export type NavigationMenuItemContext = PopoverState & {
  value: string
  active: boolean
}

export context navigationMenuItem: NavigationMenuItemContext

export type NavigationMenuItemProps = {
  // Identifies the item; the root's `value` names the open one. Default: a generated id.
  value?: string
  children?: View
} & Omit<ListItemProps, "children" | "value">

export component NavigationMenuItem(props: NavigationMenuItemProps) {
  nav = use navigationMenu
  generated = createId("navigation-menu-item")
  itemValue = props.value ?? generated
  active = nav.value == itemValue
  // The browser closed this item's content (Escape, a press outside, focus elsewhere is the trigger's job).
  action changed(next: boolean) {
    if (!next && nav.value == itemValue) { nav.setValue(undefined, nav.openReason, undefined) }
  }
  state = createPopoverState(active, false, changed)
  _focus = createContentFocus(active, nav.enter, state.popup, state.trigger)
  provide navigationMenuItem = { ...state, value: itemValue, active: active }
  { value, children, ...rest } = props
  <li {...rest}>{children}</li>
}

export type NavigationMenuTriggerProps = {
  disabled?: boolean
} & ButtonProps

// Opens its item's content: on hover after the root's delay (at once while another item is open), on click, and
// with ArrowDown (ArrowRight in a vertical menu), which also moves focus into it. Spread it on a <button>: its
// `popovertarget` keeps a press on it from counting as a press outside the content, and its click is prevented
// so the browser doesn't toggle the content itself.
export fn navigationMenuTrigger(ref nav: NavigationMenuContext, ref item: NavigationMenuItemContext, ref disabled: boolean): PartProps {
  active = item.active
  action hoverChange(next: boolean, reason: "hover" | "focus" | "press" | "group") {
    if (next) {
      nav.setValue(item.value, "hover", item.trigger)
    } else if (nav.value == item.value) {
      nav.setValue(undefined, "hover", undefined)
    }
  }
  // Once a click has opened it (or made a hover-open stick), leaving with the pointer no longer closes it.
  _hover = createHoverIntent(!disabled && !(active && nav.openReason == "click"), active, item.trigger, item.popup, {
    openDelay: nav.value != undefined ? 0 : nav.delay,
    closeDelay: nav.closeDelay,
    hoverablePopup: true,
    focus: false,
    focusDelay: 0,
    closeOnPress: false,
    group: undefined,
  }, hoverChange)
  action press(event: MouseEvent) {
    event.preventDefault()
    if (disabled) { return }
    if (active && nav.openReason == "hover") {
      nav.setValue(item.value, "click", item.trigger)
    } else if (active) {
      nav.setValue(undefined, "click", undefined)
    } else {
      nav.setValue(item.value, "click", item.trigger)
    }
  }
  action keyDown(event: KeyboardEvent) {
    if (disabled) { return }
    let openKey = nav.orientation == "vertical" ? "ArrowRight" : "ArrowDown"
    if (event.key == openKey) {
      event.preventDefault()
      if (active) { focusFirstIn(item.popup) } else { nav.setValue(item.value, "keyboard", item.trigger) }
    }
  }
  action blur(event: FocusEvent) {
    // Focus leaving for somewhere that is neither the content nor this trigger closes it.
    if (active && event.relatedTarget != null && !containsTarget([item.popup, item.trigger], event.relatedTarget)) {
      nav.setValue(undefined, nav.openReason, undefined)
    }
  }
  {
    type: "button",
    popovertarget: item.popupId,
    "aria-expanded": active ? "true" : "false",
    "aria-controls": item.popupId,
    "data-popup-open": active ? "" : undefined,
    "data-disabled": disabled ? "" : undefined,
    "aria-disabled": disabled ? "true" : undefined,
    "data-focusable": "",
    "data-rs-ui-item": "",
    ref: item.setTrigger,
    onClick: press,
    onKeyDown: keyDown,
    onBlur: blur,
  }
}

export component NavigationMenuTrigger({ disabled = false, children, ...rest }: NavigationMenuTriggerProps) {
  nav = use navigationMenu
  item = use navigationMenuItem
  own = navigationMenuTrigger(nav, item, disabled)
  merged = mergeProps(own, withoutHandlers(rest, disabled))
  <button {...merged}>{children}</button>
}

// Shows whether its item is open (a chevron, say), with `data-popup-open`. Hidden from assistive technology.
export component NavigationMenuIcon({ children, ...rest }: SpanProps) {
  item = use navigationMenuItem
  merged = mergeProps({ "aria-hidden": "true", "data-popup-open": item.active ? "" : undefined }, rest)
  <span {...merged}>{children}</span>
}

// Whether a part is inside some Content: a Link there is not one of the list's arrow-key stops. (Named apart
// from the `navigationMenuContent` props function: a context and a function can't share a name.)
export type NavigationMenuContentContext = {
  inside: boolean
}

export context navigationMenuContentScope: NavigationMenuContentContext = { inside: false }

export type NavigationMenuContentProps = {
  // Which side of the trigger it sits on; the browser flips it when it doesn't fit. Default: "bottom".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the trigger it lines up with. Default: "center".
  align?: "start" | "center" | "end"
  // Gap between trigger and content, in pixels. Default: 0.
  sideOffset?: number
  // How far it is moved along the trigger's edge from its `align` position, in pixels. Default: 0.
  alignOffset?: number
} & DivProps

// The item's panel: declare it after the item's trigger. `data-activation-direction` says where the previously
// open item was ("left" or "right"; "up" or "down" when vertical) while it is open.
export fn navigationMenuContent(ref nav: NavigationMenuContext, ref item: NavigationMenuItemContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(item, "auto", side, align, sideOffset, alignOffset)
  action focusOut(event: FocusEvent) {
    // Tab past its end, or focus moving anywhere else but its trigger, closes it.
    if (item.active && event.relatedTarget != null && !containsTarget([item.popup, item.trigger], event.relatedTarget)) {
      nav.setValue(undefined, nav.openReason, undefined)
    }
  }
  {
    ...base,
    // Not a Tab stop itself (Firefox makes a scrollable popover one otherwise), but focusable from script.
    tabindex: "-1",
    // A list of its own, so the list's arrow keys leave the links inside alone.
    "data-rs-ui-list": "",
    "data-activation-direction": item.active ? nav.activationDirection : undefined,
    onFocusOut: focusOut,
  }
}

export component NavigationMenuContent(props: NavigationMenuContentProps) {
  nav = use navigationMenu
  item = use navigationMenuItem
  provide navigationMenuContentScope = { inside: true }
  { side = "bottom", align = "center", sideOffset = 0, alignOffset = 0, children, ...rest } = props
  own = navigationMenuContent(nav, item, side, align, sideOffset, alignOffset)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export type NavigationMenuLinkProps = {
  // Whether the link is the current page: `aria-current="page"` and `data-active`. Default: false.
  active?: boolean
  // Whether following the link closes the content. Default: false.
  closeOnClick?: boolean
} & AnchorProps

export fn navigationMenuLink(ref nav: NavigationMenuContext, ref content: NavigationMenuContentContext, ref active: boolean, ref closeOnClick: boolean): PartProps {
  action click() {
    if (closeOnClick) { nav.setValue(undefined, "click", undefined) }
  }
  {
    "aria-current": active ? "page" : undefined,
    "data-active": active ? "" : undefined,
    "data-rs-ui-item": content.inside ? undefined : "",
    onClick: click,
  }
}

export component NavigationMenuLink({ active = false, closeOnClick = false, children, ...rest }: NavigationMenuLinkProps) {
  nav = use navigationMenu
  content = use navigationMenuContentScope
  own = navigationMenuLink(nav, content, active, closeOnClick)
  merged = mergeProps(own, rest)
  <a {...merged}>{children}</a>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn navigationMenuArrow(ref c: NavigationMenuItemContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component NavigationMenuArrow({ children, ...rest }: DivProps) {
  c = use navigationMenuItem
  own = navigationMenuArrow(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
