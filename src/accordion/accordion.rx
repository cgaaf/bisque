// A set of disclosures, each item a native <details>. The browser holds each item's open state, toggles it from
// its <summary> (click, Enter, Space), hides closed content (`::details-content`) and opens it for find-in-page.
// This family adds the value (which items are open, controlled or not), `disabled`, arrow-key movement between
// triggers, the panels' measured size and their exit animation. Style items with `[open]` and panels with
// `[data-ending-style]`.
//
// When only one item may be open, the root closes the others, not the browser: items don't share a `name`. The
// browser closes a <details> of the same name the moment another opens, before its exit animation can run, so the
// item snapped shut and everything below it jumped. Find-in-page still works: the item it opens reports the open,
// and the one that was open animates out.
//
// There is no Header part. Base UI wraps its trigger button in a heading; here the trigger is the <summary>, which
// must be the first child of its <details>, so nothing can wrap it. A summary may contain a heading instead:
// `<AccordionTrigger><h3>Shipping</h3></AccordionTrigger>`.
import { mergeProps, createId, createRef } from "../internal/props.js"
import { createDisclosure, focusAdjacentTrigger } from "../internal/disclosure.js"
import { createKeptFocus } from "../internal/dom.js"
import { DivProps, DetailsProps, SummaryProps, PartProps } from "../internal/types.rx"

export type AccordionOrientation = "vertical" | "horizontal"

export type AccordionContext = {
  // The values of the open items.
  value: string[]
  disabled: boolean
  orientation: AccordionOrientation
  loopFocus: boolean
  setItemOpen: (item: string, open: boolean) => void
}

export context accordion: lane AccordionContext

export type AccordionRootProps = {
  value?: string[]
  defaultValue?: string[]
  onValueChange?: (value: string[]) => void
  // Whether several items can be open at once. Default: false.
  multiple?: boolean
  disabled?: boolean
  // Which arrow keys move between triggers: Up/Down when vertical, Left/Right when horizontal. Default: vertical.
  orientation?: AccordionOrientation
  // Whether the arrow keys wrap around at the ends. Default: true.
  loopFocus?: boolean
  children?: View
} & Omit<DivProps, "children">

export component AccordionRoot(props: AccordionRootProps) {
  source uncontrolled: string[] := peek([...(props.defaultValue ?? [])])
  current = props.value ?? uncontrolled
  isDisabled = latest props.disabled ?? false
  axis = latest props.orientation ?? "vertical"

  action setItemOpen(item: string, open: boolean) {
    if (current.includes(item) == open) { return }
    let others = current.filter((v) => v != item)
    let next = open ? ((props.multiple ?? false) ? [...others, item] : [item]) : others
    uncontrolled := next
    // In a change of its own (`onFlush`): a handler that writes what a loading question reads, or that awaits, would
    // otherwise hold this change, and the items (and the <details> the browser opened) with it.
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(next) })
    }
  }

  provide accordion = {
    value: current,
    disabled: isDisabled,
    orientation: axis,
    loopFocus: latest props.loopFocus ?? true,
    setItemOpen: setItemOpen,
  }

  { value, defaultValue, onValueChange, multiple, disabled, orientation, loopFocus, children, ...rest } = props
  own = {
    "data-bisque-accordion": "",
    "data-orientation": axis,
    "data-disabled": isDisabled ? "" : undefined,
  }
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export type AccordionItemContext = {
  value: string
  open: boolean
  disabled: boolean
  triggerId: string
  panelId: string
  setOpen: (open: boolean) => void
  setPanel: (element: HTMLElement) => void
}

export context accordionItem: lane AccordionItemContext

export type AccordionItemProps = {
  // Identifies the item in the root's `value`. Default: a generated id.
  value?: string
  // Its trigger does nothing while disabled. Find-in-page still opens it: the browser's behaviour wins.
  disabled?: boolean
  // Called before the root's `onValueChange` when the item is opened or closed.
  onOpenChange?: (open: boolean) => void
  children?: View
} & Omit<DetailsProps, "children" | "open" | "name">

// The disabled and orientation attributes every part of an item carries.
//
// The parts read each field of the contexts through an equation of its own. The item context is one object,
// rebuilt whenever any field changes (each open and close): a props object built straight from it would be
// rebuilt each time with the same content, and everything spread from it would run again
// (`UNSTABLE_MEMO_OUTPUT`). An equation of one field stops the change when that field didn't.
fn itemState(ref root: AccordionContext, ref item: AccordionItemContext): PartProps {
  disabled = item.disabled
  orientation = root.orientation
  {
    "data-disabled": disabled ? "" : undefined,
    "data-orientation": orientation,
  }
}

export component AccordionItem(props: AccordionItemProps) {
  root = use accordion
  source details: HTMLDetailsElement | undefined := undefined
  source panel: HTMLElement | undefined := undefined
  fallbackValue = createId("accordion-item")
  triggerId = createId("accordion-trigger")
  panelId = createId("accordion-panel")
  itemValue = latest props.value ?? fallbackValue
  isOpen = root.value.includes(itemValue)
  isDisabled = (latest props.disabled ?? false) || root.disabled
  // Rendered once, so an open item doesn't animate in on mount; the driver keeps it in step after that.
  initiallyOpen = peek(isOpen)

  action setOpen(next: boolean) {
    if (next == isOpen) { return }
    // In a change of its own, as the root's `onValueChange` is, and before it.
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
    root.setItemOpen(itemValue, next)
  }
  action writeDetails(element: HTMLDetailsElement) { details := element }
  setDetails = createRef(writeDetails)
  action writePanel(element: HTMLElement) { panel := element }
  setPanel = createRef(writePanel)

  _details = createDisclosure(details, panel, isOpen, "accordion-panel", setOpen)
  // Content that loads or fails inside the open panel replaces what had focus: focus stays in the panel.
  _focus = createKeptFocus(panel, isOpen)

  self = {
    value: itemValue,
    open: isOpen,
    disabled: isDisabled,
    triggerId: triggerId,
    panelId: panelId,
    setOpen: setOpen,
    setPanel: setPanel,
  }
  provide accordionItem = self

  { value, disabled, onOpenChange, children, ...rest } = props
  state = itemState(root, self)
  own = {
    ...state,
    open: initiallyOpen ? true : undefined,
    ref: setDetails,
  }
  merged = latest mergeProps(own, rest)
  <details {...merged}>{children}</details>
}

// Spread on a <summary> that is the first child of the item's <details>: the toggling, focusability and the
// expanded state come from that element, and it works on no other. A press asks the root instead of toggling, so
// a controlled `value` decides and the close can animate. The arrow keys, Home and End move between triggers.
export fn accordionTrigger(ref root: AccordionContext, ref item: AccordionItemContext): PartProps {
  action press(event: MouseEvent) {
    event.preventDefault()
    if (item.disabled) { return }
    item.setOpen(!item.open)
  }
  action keyDown(event: KeyboardEvent) { focusAdjacentTrigger(event, root.orientation, root.loopFocus) }
  state = itemState(root, item)
  // One equation per field, as in itemState.
  triggerId = item.triggerId
  disabled = item.disabled
  {
    ...state,
    id: triggerId,
    "aria-disabled": disabled ? "true" : undefined,
    tabindex: disabled ? "-1" : undefined,
    "data-bisque-accordion-trigger": "",
    onClick: press,
    onKeyDown: keyDown,
  }
}

export component AccordionTrigger({ children, ...rest }: SummaryProps) {
  root = use accordion
  item = use accordionItem
  own = accordionTrigger(root, item)
  merged = latest mergeProps(own, rest)
  <summary {...merged}>{children}</summary>
}

// A region labelled by its trigger. Its size is written to `--accordion-panel-height` and
// `--accordion-panel-width`: px while it opens and closes, `auto` once open. Animate `height` from 0 with both
// `details:not([open]) > .panel` and `@starting-style` (Chrome needs the second, Safari the first), and to 0
// under `[data-ending-style]`.
export fn accordionPanel(ref root: AccordionContext, ref item: AccordionItemContext): PartProps {
  state = itemState(root, item)
  // One equation per field, as in itemState.
  panelId = item.panelId
  triggerId = item.triggerId
  setPanel = item.setPanel
  {
    ...state,
    id: panelId,
    role: "region",
    "aria-labelledby": triggerId,
    ref: setPanel,
  }
}

export component AccordionPanel({ children, ...rest }: DivProps) {
  root = use accordion
  item = use accordionItem
  own = accordionPanel(root, item)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
