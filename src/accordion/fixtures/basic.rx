import { AccordionRoot, AccordionItem, AccordionTrigger, AccordionPanel, accordion, accordionItem, accordionTrigger } from "../accordion.rx"

// A summary the consumer writes, with a heading inside.
component OwnTrigger() {
  root = use accordion
  item = use accordionItem
  t = accordionTrigger(root, item)
  <summary data-testid="own" {...t}><h3>Four</h3></summary>
}

export default component Fixture() {
  source changes: string[] := []
  source opened := ""
  <style>
    :global(.anim) { overflow: hidden; height: var(--accordion-panel-height); transition: height 200ms linear }
    :global(details:not([open]) > .anim), :global(.anim[data-ending-style]) { height: 0 }
    @starting-style { :global(details[open] > .anim) { height: 0 } }
  </style>
  <main>
    <AccordionRoot data-testid="root" class="mine" defaultValue={["one"]} onValueChange={(next) => { changes := [...changes, next.join("+")] }}>
      <AccordionItem value="one" data-testid="item-one">
        <AccordionTrigger>One</AccordionTrigger>
        <AccordionPanel data-testid="panel-one" class="anim"><div style="height: 80px">First <input aria-label="Note" /></div></AccordionPanel>
      </AccordionItem>
      <AccordionItem value="two" data-testid="item-two" onOpenChange={(open) => { opened := open ? "two open" : "two closed" }}>
        <AccordionTrigger>Two</AccordionTrigger>
        <AccordionPanel data-testid="panel-two">Second</AccordionPanel>
      </AccordionItem>
      <AccordionItem value="three" disabled data-testid="item-three">
        <AccordionTrigger>Three</AccordionTrigger>
        <AccordionPanel>Third</AccordionPanel>
      </AccordionItem>
      <AccordionItem value="four" data-testid="item-four">
        <OwnTrigger />
        <AccordionPanel data-testid="panel-four">Fourth</AccordionPanel>
      </AccordionItem>
    </AccordionRoot>
    <output data-testid="changes">{changes.join(",")}</output>
    <output data-testid="opened">{opened}</output>
  </main>
}
