import { mergeProps, createId } from "../internal/props.js"
import { ButtonProps, PartProps } from "../internal/types.rx"
import { button, gateButtonHandlers } from "../button/button.rx"
import { toggleGroup, ToggleGroupContext } from "../toggle-group/toggle-group.rx"
import { toolbar, ToolbarContext } from "../toolbar/toolbar.rx"

export type ToggleOptions = {
  pressed?: boolean
  defaultPressed?: boolean
  onPressedChange?: (pressed: boolean) => void
  disabled?: boolean
  // What the toggle stands for in a toggle group's `value`. Give one to every toggle in a group.
  value?: string
  // Pass false when the element playing the toggle isn't a <button>. Default: true.
  native?: boolean
}

// A two-state button. In a toggle group the group owns the pressed state, and the toggle is one of its items;
// in a toolbar it is one of the toolbar's items.
export fn toggle(ref group: ToggleGroupContext, ref bar: ToolbarContext, ref o: ToggleOptions): PartProps {
  source uncontrolled := peek(o.defaultPressed ?? false)
  fallbackValue = createId("toggle")
  key = latest o.value ?? fallbackValue
  // `pressed` and `disabled` are often read from an answer that can fail (`pressed={setting}` with
  // `setting = await load()`): a failure there is the app's to show, in its `errored` region, not the toggle's.
  givenPressed = o.pressed catch (e) => undefined
  givenDisabled = (latest o.disabled ?? false) catch (e) => false
  isPressed = group.present ? group.value.includes(key) : (givenPressed ?? uncontrolled)
  isDisabled = givenDisabled || group.disabled
  composite = group.present || bar.present
  own = button({ disabled: isDisabled, native: latest o.native ?? true, composite: composite })

  // The owner's handler is called in a change of its own (`onFlush`), never in the one that updates this toggle: a
  // handler that saves (an action that awaits, or a write a loading question reads) holds its change until the
  // answer lands, and the toggle would be held with it.
  action notify(next: boolean) {
    if (o.onPressedChange) {
      let report = o.onPressedChange
      onFlush(() => { report(next) })
    }
  }
  action press() {
    if (isDisabled) { return }
    let next = !isPressed
    // The toggle's own handler is told before the group's.
    notify(next)
    if (group.present) { group.setPressed(key, next) } else { uncontrolled := next }
  }

  // `press` runs before the button's own click handler, which only cancels the click while disabled.
  mergeProps(own, {
    "aria-pressed": isPressed ? "true" : "false",
    "data-pressed": isPressed ? "" : undefined,
    "data-bisque-item": composite ? "" : undefined,
    onClick: press,
  })
}

export type ToggleProps = {
  pressed?: boolean
  // Default: false.
  defaultPressed?: boolean
  onPressedChange?: (pressed: boolean) => void
  disabled?: boolean
  value?: string
} & Omit<ButtonProps, "value" | "disabled">

export component Toggle({ pressed, defaultPressed, onPressedChange, disabled = false, value, children, ...rest }: ToggleProps) {
  group = use toggleGroup
  bar = use toolbar
  own = toggle(group, bar, { pressed: pressed, defaultPressed: latest defaultPressed, onPressedChange: onPressedChange, disabled: latest disabled, value: latest value })
  external = gateButtonHandlers(rest, (latest disabled) || group.disabled)
  merged = latest mergeProps(own, external)
  <button {...merged}>{children}</button>
}
