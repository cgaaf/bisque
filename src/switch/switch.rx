// A switch: a native <input type="checkbox" role="switch">, styleable whole with `appearance: none`. The browser
// provides the on state, Space, label association, form submission, `required` validation and the style hooks
// `:checked`, `:disabled`, `:focus-visible` and `:user-invalid`, and exposes the checked state as the switch's.
// This family adds a controlled value, `readOnly` and the Field wiring.
//
// An <input> can't have children, so SwitchRoot renders its children right after the input: SwitchThumb is the
// input's next sibling, styled from it (`input:checked + span`), or the input draws its own thumb (`::before`).
import { mergeProps, createRef } from "../internal/props.js"
import { createFormReset } from "../internal/field.js"
import { createCheckedInput } from "../internal/checked-input.js"
import { createFocusKeeper } from "../internal/focus-keeper.js"
import { field, fieldInputProps } from "../field/field.rx"
import { InputProps, SpanProps } from "../internal/types.rx"

// For a custom thumb that renders differently per state (SwitchRoot provides it to its children).
export type SwitchContext = {
  checked: boolean
  disabled: boolean
  readOnly: boolean
  required: boolean
}

// `switch` is a reserved word, so the family's context has a longer name.
export context switchContext: SwitchContext

export type SwitchRootProps = {
  checked?: boolean
  defaultChecked?: boolean
  onCheckedChange?: (checked: boolean) => void
  disabled?: boolean
  // Focusable and announced, but a press doesn't change it (`readonly` has no effect on a native checkbox).
  readOnly?: boolean
  required?: boolean
  // With a name (or inside a named FieldRoot), the switch submits `value` (default "on") with its form while on.
  name?: string
  value?: string
  // Rendered after the input, as its siblings: a SwitchThumb or the consumer's own.
  children?: View
} & Omit<InputProps, "value" | "name" | "disabled" | "checked" | "defaultChecked" | "readOnly" | "readonly" | "required" | "type" | "role" | "children">

// An on/off control. Inside a FieldRoot it is the field's control.
export component SwitchRoot(props: SwitchRootProps) {
  f = use field
  source uncontrolled := peek(props.defaultChecked ?? false)
  // Counts form resets, so the input is set back to the state after one (createCheckedInput).
  source revision := 0
  source element: HTMLInputElement | undefined := undefined
  // `checked` and `disabled` are often read from an answer that can fail (`checked={setting}` with
  // `setting = await load()`): a failure there is the app's to show, in its `errored` region, not the switch's.
  givenChecked = props.checked catch (e) => undefined
  givenDisabled = (props.disabled ?? false) catch (e) => false
  isChecked = givenChecked ?? uncontrolled
  isReadOnly = props.readOnly ?? false
  self = {
    checked: isChecked,
    disabled: givenDisabled || (f?.disabled ?? false),
    readOnly: isReadOnly,
    required: props.required ?? false,
  }

  // The input's `defaultChecked`: what a form reset puts back, which for an uncontrolled switch is its default.
  initialChecked = peek(isChecked)

  effect (isChecked) { if (f) { f.setValue($0) } }
  _input = createCheckedInput(element, isChecked, false, revision)
  _reset = createFormReset(element, reset)
  // Disabled while it had focus (`disabled={pending? setting}`), it takes focus back when re-enabled.
  _focus = createFocusKeeper(element, self.disabled)

  // The owner's handler is called in a change of its own (`onFlush`), never in the one that updates this switch: a
  // handler that saves (an action that awaits, or a write a loading question reads) holds its change until the
  // answer lands, and the switch would be held with it, showing the browser's toggle whatever the owner decided.
  action notify(next: boolean) {
    if (props.onCheckedChange) {
      let report = props.onCheckedChange
      onFlush(() => { report(next) })
    }
  }
  // The browser has already toggled the input: report that, and let the state decide what it shows. The input is
  // set back to the state once the owner's change has run too (createCheckedInput).
  action change(event: Event & { currentTarget: HTMLInputElement }) {
    let next = event.currentTarget.checked
    uncontrolled := next
    notify(next)
  }
  // The browser has put the input back to `defaultChecked`. Uncontrolled, that is the new state, reported once if
  // it changed; controlled, the owner's state is written back over it.
  action reset() {
    revision := revision + 1
    let next = givenChecked ?? initialChecked
    if (givenChecked == undefined && next != uncontrolled) {
      uncontrolled := next
      notify(next)
    }
    if (f) { f.reset(next) }
  }
  // Cancelling the click is what keeps a native checkbox unchanged: the browser restores it and fires no change.
  action click(event: MouseEvent) { if (isReadOnly) { event.preventDefault() } }
  action writeElement(input: HTMLInputElement) {
    element := input
    if (f) { f.setInput(input) }
  }
  setElement = createRef(writeElement)

  provide switchContext = self

  { checked, defaultChecked, onCheckedChange, disabled, readOnly, required, name, value, children, ...rest } = props
  inField = fieldInputProps(f)
  own = mergeProps(inField, {
    type: "checkbox",
    role: "switch",
    name: name ?? f?.name,
    value: value,
    defaultChecked: initialChecked,
    disabled: self.disabled ? true : undefined,
    required: self.required ? true : undefined,
    "aria-readonly": self.readOnly ? "true" : undefined,
    "data-readonly": self.readOnly ? "" : undefined,
    ref: setElement,
    onChange: change,
    onClick: click,
  })
  merged = mergeProps(own, rest)
  <input {...merged} />
  {children}
}

// The moving part, always in the document: place it in SwitchRoot, where it is the input's next sibling, and
// style it with `input:checked + *`. Hidden from assistive technology.
export component SwitchThumb({ children, ...rest }: SpanProps) {
  merged = mergeProps({ "aria-hidden": "true" }, rest)
  <span {...merged}>{children}</span>
}
