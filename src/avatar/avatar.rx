import { mergeProps } from "../internal/props.js"
import { createPresence } from "../internal/dom.js"
import { createImageSlot, createImageLoadingStatus, createDelayPassed } from "../internal/image-loading.js"
import { SpanProps, ImageProps, PartProps } from "../internal/types.rx"

export type ImageLoadingStatus = "idle" | "loading" | "loaded" | "error"

// Where AvatarImage reports how it is loading (../internal/impl/image-loading.ts).
export type AvatarImageSlot = { add: (status: any) => void; remove: (status: any) => void }

export type AvatarContext = {
  // How the image is doing: the fallback shows until it is "loaded". "idle" while there is no AvatarImage.
  imageLoadingStatus: ImageLoadingStatus
  // Where AvatarImage reports its status.
  slot: AvatarImageSlot
}

export context avatar: AvatarContext

export component AvatarRoot(props: SpanProps) {
  // The image's status is kept in TypeScript: an avatar in a `for` row that a new answer removes can't call an
  // action from its cleanup to say its image has gone.
  [status, slot] = createImageSlot()
  provide avatar = { imageLoadingStatus: status, slot: slot }
  { children, ...rest } = props
  <span {...rest}>{children}</span>
}

export type AvatarImageProps = {
  src?: string
  srcset?: string
  crossorigin?: "anonymous" | "use-credentials" | ""
  referrerpolicy?: string
  onLoadingStatusChange?: (status: ImageLoadingStatus) => void
} & Omit<ImageProps, "src" | "srcset" | "crossorigin" | "referrerpolicy">

// Loads the source off-screen and mounts the <img> only once it has loaded, so a broken image never shows.
// It animates in and out with `data-starting-style` and `data-ending-style`.
export component AvatarImage({ src, srcset, crossorigin, referrerpolicy, onLoadingStatusChange, ...rest }: AvatarImageProps) {
  c = use avatar
  status = createImageLoadingStatus(latest src, latest srcset, latest crossorigin, latest referrerpolicy, peek(c.slot))
  effect (status) {
    if ($0 != "idle" && onLoadingStatusChange) { onLoadingStatusChange($0) }
  }
  source element: HTMLElement | undefined := undefined
  action setElement(el: HTMLElement) { element := el }
  [mounted, transition] = createPresence(status == "loaded", element)
  own = {
    ref: setElement,
    "data-starting-style": transition == "starting" ? "" : undefined,
    "data-ending-style": transition == "ending" ? "" : undefined,
  }
  merged = latest mergeProps(own, rest)
  {if mounted {
    <img {...merged} crossorigin={crossorigin} referrerpolicy={referrerpolicy} srcset={srcset} src={src} />
  }}
}

export type AvatarFallbackProps = {
  // Milliseconds to wait before showing, so a fast-loading image doesn't flash the fallback first. Default: 0.
  delay?: number
} & SpanProps

// Shown while the image hasn't loaded: before it does, when it fails, and when there is no image at all.
export component AvatarFallback({ delay = 0, children, ...rest }: AvatarFallbackProps) {
  c = use avatar
  passed = createDelayPassed(latest delay)
  {if c.imageLoadingStatus != "loaded" && passed {
    <span {...rest}>{children}</span>
  }}
}
