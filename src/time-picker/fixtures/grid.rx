  <TimePickerRoot locale="en-US" defaultValue={parseTime("09:30")} minuteStep={5}>
    <TimePickerTrigger />
    <TimePickerPopup>
      <TimePickerHours gridColumns={6} />
      <TimePickerMinutes gridColumns={6} />
    </TimePickerPopup>
  </TimePickerRoot>
