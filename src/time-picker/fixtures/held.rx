import { TimePickerRoot, TimePickerField, TimePickerTrigger, TimePickerPopup, TimePickerHours, TimePickerMinutes, TimePickerDayPeriod } from "../time-picker.rx"
import { TimeFieldInput, TimeFieldSegment, timeField } from "../../time-field/time-field.rx"
import { parseTime } from "../../internal/date.js"
import { save } from "../../test/slow-server.js"

component Segments() {
  c = use timeField
  {for segment in c.segments {
    <TimeFieldSegment segment={segment} />
  }}
}

// An app that holds a plain write in an action (`step := 2`, then a slow request) while a prop of a time picker is
// computed from that write. The picker's own state (open, the value chosen) must not wait for the app's request.
export default component Fixture() {
  source step := 1
  action next() {
    step := 2
    try { await save("step") } catch (e) { }
  }
  column = "height: 120px; overflow-y: auto; overflow-x: hidden; font-size: 12px"
  columns = "display: flex; gap: 4px"

  <main>
    <button onClick={() => { next() }}>Next</button>
    <output data-testid="step">{step}</output>

    // A prop of the root that changes with the held write.
    <TimePickerRoot locale="en-US" defaultValue={parseTime("09:30")} max={step == 1 ? parseTime("18:00") : parseTime("17:00")}>
      <TimePickerField aria-label="Root prop">
        <TimeFieldInput><Segments /></TimeFieldInput>
        <TimePickerTrigger aria-label="Open root prop" />
      </TimePickerField>
      <TimePickerPopup data-testid="root-prop-popup">
        <div style={columns}>
          <TimePickerHours style={column} />
          <TimePickerMinutes style={column} />
          <TimePickerDayPeriod style={column} />
        </div>
      </TimePickerPopup>
    </TimePickerRoot>

    // An attribute passed through to the popup and a column.
    <TimePickerRoot locale="en-US" defaultValue={parseTime("09:30")}>
      <TimePickerField aria-label="Attribute">
        <TimeFieldInput><Segments /></TimeFieldInput>
        <TimePickerTrigger aria-label="Open attribute" class={step == 2 ? "second" : "first"} />
      </TimePickerField>
      <TimePickerPopup data-testid="attribute-popup" class={step == 2 ? "second" : "first"}>
        <div style={columns}>
          <TimePickerHours style={column} class={step == 2 ? "second" : "first"} />
          <TimePickerMinutes style={column} />
          <TimePickerDayPeriod style={column} />
        </div>
      </TimePickerPopup>
    </TimePickerRoot>
  </main>
}
