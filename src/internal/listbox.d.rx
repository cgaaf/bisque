// How .rx may use ./listbox.js (implemented in ./impl/listbox.ts): option lists of select, combobox, autocomplete.
// Items carry `data-rs-ui-item`, `data-value`, `data-label` (optional) and `data-disabled`; the DOM is the registry.
// One declaration per line: scripts/gen-dts.mjs turns this file into ./listbox.d.ts.
export pure fn createTypeahead(): [(container: HTMLElement | undefined, key: string, current: string | undefined) => HTMLElement | undefined, () => void] instantiates
export fn elementText(element: HTMLElement | undefined): string
export fn itemValue(element: EventTarget | null | undefined): string | undefined
export fn adjacentItemId(list: HTMLElement | undefined, currentId: string | undefined, direction: "next" | "previous" | "first" | "last", loop: boolean): string | undefined
export fn scrollItemIntoView(list: HTMLElement | undefined, id: string | undefined): void
export fn itemLabel(list: HTMLElement | undefined, id: string | undefined): string | undefined
export fn clickItem(list: HTMLElement | undefined, id: string | undefined): void
export fn itemIdByValue(list: HTMLElement | undefined, value: string | undefined): string | undefined
export pure fn matchesFilter(filter: ((label: string, query: string) => boolean) | undefined, label: string, query: string): boolean
