// How .rx may use ./image-loading.js (implemented in ./impl/image-loading.ts): the avatar's image and fallback.
// One declaration per line: scripts/gen-dts.mjs turns this file into ./image-loading.d.ts.
export pure fn createImageLoadingStatus(ref src: string | undefined, ref srcset: string | undefined, ref crossOrigin: string | undefined, ref referrerPolicy: string | undefined): ref "idle" | "loading" | "loaded" | "error"
export pure fn createDelayPassed(ref delay: number): ref boolean
