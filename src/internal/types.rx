// Types the parts share, as names .rx can import.
//
// They are aliases of the definitions in ./impl/types.ts, written with `import("…")` on purpose: the compiler binds
// every name imported from a JS or TS module as a value, so `import { ButtonProps } from "./impl/types.ts"` leaves an
// import the bundler rejects ("ButtonProps is not exported"). A type imported from an .rx module binds nothing.
export type PartProps = import("./impl/types.ts").PartProps
export type ButtonProps = import("./impl/types.ts").ButtonProps
export type InputProps = import("./impl/types.ts").InputProps
export type DivProps = import("./impl/types.ts").HTMLProps<HTMLDivElement>
export type SpanProps = import("./impl/types.ts").HTMLProps<HTMLSpanElement>
export type HeadingProps = import("./impl/types.ts").HTMLProps<HTMLHeadingElement>
export type ParagraphProps = import("./impl/types.ts").HTMLProps<HTMLParagraphElement>
export type TransitionStatus = "starting" | "ending" | undefined
export type LabelProps = import("./impl/types.ts").HTMLProps<HTMLLabelElement>
