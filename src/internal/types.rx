// Types the parts share, as names .rx can import.
//
// They are aliases of the definitions in ./impl/types.ts, written with `import("…")` on purpose: the compiler
// binds every name imported from a JS or TS module as a value, so `import { ButtonProps } from "./impl/types.ts"`
// leaves an import the bundler rejects ("ButtonProps is not exported"). A type imported from an .rx module binds
// nothing. For a tag that has no alias yet, add one here.
export type PartProps = import("./impl/types.ts").PartProps
export type TransitionStatus = "starting" | "ending" | undefined

export type DivProps = import("./impl/types.ts").ElementProps<"div">
export type SpanProps = import("./impl/types.ts").ElementProps<"span">
export type ButtonProps = import("./impl/types.ts").ElementProps<"button">
export type InputProps = import("./impl/types.ts").ElementProps<"input">
export type TextareaProps = import("./impl/types.ts").ElementProps<"textarea">
export type LabelProps = import("./impl/types.ts").ElementProps<"label">
export type FormProps = import("./impl/types.ts").ElementProps<"form">
export type FieldsetProps = import("./impl/types.ts").ElementProps<"fieldset">
export type LegendProps = import("./impl/types.ts").ElementProps<"legend">
export type OutputProps = import("./impl/types.ts").ElementProps<"output">
export type AnchorProps = import("./impl/types.ts").ElementProps<"a">
export type ImageProps = import("./impl/types.ts").ElementProps<"img">
export type HeadingProps = import("./impl/types.ts").ElementProps<"h2">
export type ParagraphProps = import("./impl/types.ts").ElementProps<"p">
export type ListProps = import("./impl/types.ts").ElementProps<"ul">
export type ListItemProps = import("./impl/types.ts").ElementProps<"li">
export type NavProps = import("./impl/types.ts").ElementProps<"nav">
export type DialogElementProps = import("./impl/types.ts").ElementProps<"dialog">
export type DetailsProps = import("./impl/types.ts").ElementProps<"details">
export type SummaryProps = import("./impl/types.ts").ElementProps<"summary">
export type HrProps = import("./impl/types.ts").ElementProps<"hr">
export type Placement = import("./impl/native.ts").Placement

// Dates and times (./date.d.rx says how .rx must hold them: never as a source's seed).
export type PlainDate = Temporal.PlainDate
export type PlainTime = Temporal.PlainTime
export type PlainYearMonth = Temporal.PlainYearMonth
export type DateRange = import("./impl/date.ts").DateRange
export type DateConstraints = import("./impl/date.ts").DateConstraints
export type CalendarDay = import("./impl/date.ts").CalendarDay
export type CalendarWeek = import("./impl/date.ts").CalendarWeek
export type CalendarOption = import("./impl/date.ts").CalendarOption
export type WeekdayName = import("./impl/date.ts").WeekdayName
export type DateMove = import("./impl/date.ts").DateMove
export type TimeGranularity = import("./impl/date.ts").TimeGranularity
export type HourCycle = import("./impl/date.ts").HourCycle
export type SegmentKind = import("./impl/date.ts").SegmentKind
export type SegmentValues = import("./impl/date.ts").SegmentValues
export type FieldOptions = import("./impl/date.ts").FieldOptions
export type FieldSegment = import("./impl/date.ts").FieldSegment
export type SegmentEntry = import("./impl/date.ts").SegmentEntry
export type TimeOption = import("./impl/date.ts").TimeOption

// File Upload (./file-upload.d.rx).
export type FileRejection = import("./impl/file-upload.ts").FileRejection
export type FileRejectionReason = import("./impl/file-upload.ts").FileRejectionReason
export type FileValidateResult = import("./impl/file-upload.ts").FileValidateResult

// Calendar (a <table role="grid"> and native <select>s).
export type TableProps = import("./impl/types.ts").ElementProps<"table">
export type TableSectionProps = import("./impl/types.ts").ElementProps<"tbody">
export type TableRowProps = import("./impl/types.ts").ElementProps<"tr">
export type TableCellProps = import("./impl/types.ts").ElementProps<"td">
export type TableHeaderCellProps = import("./impl/types.ts").ElementProps<"th">
export type SelectElementProps = import("./impl/types.ts").ElementProps<"select">
export type KeyedSegment = import("./impl/segmented-field.ts").KeyedSegment

// Time Range Picker: the range it holds; either end may be missing while it is being chosen.
export type TimeRange = { start: Temporal.PlainTime | undefined; end: Temporal.PlainTime | undefined }
