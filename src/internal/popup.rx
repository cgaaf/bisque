// What every anchored popup shares (menu, popover, select, tooltip): open state that may be controlled, the
// elements involved, and staying mounted while the popup animates out.
import { createPresence, createDismiss } from "./dom.js"
import { TransitionStatus } from "./types.rx"

export type PopupState = {
  open: boolean
  // True from opening until the popup has finished animating out.
  mounted: boolean
  status: TransitionStatus
  trigger: HTMLElement | undefined
  positioner: HTMLElement | undefined
  popup: HTMLElement | undefined
  setOpen: (open: boolean) => void
  setTrigger: (element: HTMLElement) => void
  setPositioner: (element: HTMLElement) => void
  setPopup: (element: HTMLElement) => void
}

// `controlled` is the `open` prop (undefined when the consumer leaves it out), `initial` the `defaultOpen` one.
export fn createPopupState(ref controlled: boolean | undefined, initial: boolean, ref dismissible: boolean, ref onOpenChange: ((open: boolean) => void) | undefined): PopupState {
  source uncontrolled := initial
  source trigger: HTMLElement | undefined := undefined
  source positioner: HTMLElement | undefined := undefined
  source popup: HTMLElement | undefined := undefined
  isOpen = controlled ?? uncontrolled

  action setOpen(next: boolean) {
    if (next == isOpen) { return }
    uncontrolled := next
    if (onOpenChange) { onOpenChange(next) }
  }
  action dismiss() { setOpen(false) }
  action setTrigger(element: HTMLElement) { trigger := element }
  action setPositioner(element: HTMLElement) { positioner := element }
  action setPopup(element: HTMLElement) { popup := element }

  [mounted, status] = createPresence(isOpen, popup)
  _dismiss = createDismiss(isOpen && dismissible, [popup, trigger], dismiss)

  {
    open: isOpen,
    mounted: mounted,
    status: status,
    trigger: trigger,
    positioner: positioner,
    popup: popup,
    setOpen: setOpen,
    setTrigger: setTrigger,
    setPositioner: setPositioner,
    setPopup: setPopup,
  }
}

// The state attributes every popup part carries, for styling and animation.
export fn popupStateAttributes(ref p: PopupState): import("./impl/types.ts").PartProps {
  {
    "data-open": p.open ? "" : undefined,
    "data-closed": p.open ? undefined : "",
    "data-starting-style": p.status == "starting" ? "" : undefined,
    "data-ending-style": p.status == "ending" ? "" : undefined,
  }
}
