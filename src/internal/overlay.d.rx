// How .rx may use ./overlay.js (implemented in ./impl/overlay.ts): hover intent, the tooltip delay group, the
// arrow, and a popover's focus. A `ref` parameter is passed live; the others are read once. Bind every call.
// `group` is a HoverGroup from createHoverGroup; .rx types it with a local alias of ./impl/overlay.ts's HoverGroup.
// One declaration per line: scripts/gen-dts.mjs turns this file into ./overlay.d.ts.
export pure fn createHoverGroup(ref timeout: number): any
export pure fn createHoverIntent(ref enabled: boolean, ref open: boolean, ref trigger: HTMLElement | undefined, ref popup: HTMLElement | undefined, ref options: { openDelay: number; closeDelay: number; hoverablePopup: boolean; focus: boolean; focusDelay: number; closeOnPress: boolean; group: any }, onOpenChange: (open: boolean, reason: "hover" | "focus" | "press" | "group") => void) instantiates
export pure fn createArrow(ref active: boolean, ref anchor: HTMLElement | undefined, ref floating: HTMLElement | undefined, ref arrow: HTMLElement | undefined, ref side: "top" | "bottom" | "left" | "right"): ref boolean
export pure fn createPopupFocus(ref active: boolean, ref popup: HTMLElement | undefined, ref trigger: HTMLElement | undefined, ref trap: boolean, onFocusOut: () => void) instantiates
