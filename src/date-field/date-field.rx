// Date Field: a date entered through one spinbutton per segment (month / day / year, in the locale's order with its
// literals), as React Aria's DateField does; Base UI has none. ARIA: each editable segment is a `spinbutton` with
// `aria-valuenow`/`-min`/`-max`/`-valuetext` and a label, inside a `group` labelled by the field.
//
// Why not `<input type="date">`: it is a segmented field in every engine, but it takes its locale from the browser,
// not from `lang` or the app; its partial input can't be read (the value stays "" until every segment is filled);
// Firefox has no selector to style its segments; and it ignores typed non-ASCII digits. It stays as the hidden
// input that submits the value, and whose native `min`, `max` and `required` checks Field reads.
//
// Behaviour is in ../internal/segmented-field.rx, shared with Time Field; this file gives it the date's types.
// The value is a `Temporal.PlainDate`. `onValueChange` reports a date whenever every segment is filled and the day
// exists (typing a year reports each year on the way: 2, 20, 202, 2026, as WebKit's native input
// do), and `undefined` when a complete date becomes incomplete. A date outside `min`/`max` is kept, not clamped: the
// field is invalid (`data-invalid`, and the hidden input's `rangeUnderflow`/`rangeOverflow` for Field).
//
// Composing (a Date Picker, a Date Range Picker): give the field a controlled `value` (null for empty) and take
// `onValueChange`; a value set from outside replaces a partial edit. A part placed inside the root reads
// `use dateField` and calls `c.focus()` to give focus back to the field (the first empty segment, or the last). A
// picker that keeps the Field to itself (`provide field = undefined` around the field) passes its validity and
// description on with `invalid` and `describedBy`: each segment then gets them as `aria-invalid`/`data-invalid` and
// `aria-describedby`, exactly as from a FieldRoot, the given values winning over a Field's. A
// range is two roots inside the picker's own `role="group"`, each with its own `aria-label` ("Start date", "End
// date"); each root is a group of its own. The props functions (`dateFieldRoot`, `dateFieldInput`,
// `dateFieldSegment`) put the behaviour on any element.
import { mergeProps, createId } from "../internal/props.js"
import { parseDate, dateToString } from "../internal/date.js"
import { SegmentedFieldState, segmentedFieldState, segmentedFieldRoot, segmentedFieldInput, segmentedFieldSegment } from "../internal/segmented-field.rx"
import { field } from "../field/field.rx"
import { DivProps, SpanProps, PartProps, PlainDate, FieldOptions, KeyedSegment } from "../internal/types.rx"

export type DateFieldContext = SegmentedFieldState & {
  // The date the segments make; undefined while any is empty or the day doesn't exist.
  value: PlainDate | undefined
}

export context dateField: lane DateFieldContext

export type DateFieldRootProps = {
  // The date shown. `null` is controlled and empty; leaving it out lets the field hold its own value.
  value?: PlainDate | null
  defaultValue?: PlainDate
  // Called with the date when every segment is filled and the day exists, and with undefined when a complete date
  // becomes incomplete.
  onValueChange?: (value: PlainDate | undefined) => void
  // The earliest date that is valid. A date before it is kept and marks the field invalid.
  min?: PlainDate
  // The latest date that is valid. A date after it is kept and marks the field invalid.
  max?: PlainDate
  // The locale whose segment order, literals and digits the field uses. Default: the browser's.
  locale?: string | string[]
  // What an empty segment starts from when stepped with the arrow keys. Default: today.
  placeholderValue?: PlainDate
  disabled?: boolean
  readOnly?: boolean
  required?: boolean
  // With a name (or inside a named FieldRoot), a hidden date input submits the value (`2026-11-17`) with the form;
  // nothing while it is incomplete.
  name?: string
  form?: string
  // Marks the field invalid from outside, as an enclosing FieldRoot's state would (a picker that keeps the Field
  // to itself passes its own). Given, it wins over the Field's; a date outside `min`/`max` is invalid either way.
  invalid?: boolean
  // The ids that describe the field, for each segment's `aria-describedby`, as an enclosing FieldRoot's description
  // and error would. Given, it wins over the Field's.
  describedBy?: string
  // An empty segment's `aria-valuetext`, in the app's language. Default: "Empty".
  emptyText?: string
  // The validation message while some segments are filled and others not. Default: "Enter a complete date."
  incompleteMessage?: string
  children?: View
} & Omit<DivProps, "children" | "defaultValue" | "onChange">

// An id or id list the consumer gave (`id`, `aria-labelledby`), or none.
fn idRef(given: string | false | undefined): string | undefined => given == false || given == "" ? undefined : given

export component DateFieldRoot(props: DateFieldRootProps) {
  f = use field
  // `value` and `disabled` are often read from an answer that can fail: that failure is the app's to show.
  givenValue = props.value catch (e) => undefined
  givenDisabled = (props.disabled ?? false) catch (e) => false
  givenReadOnly = (props.readOnly ?? false) catch (e) => false
  controlled = givenValue == undefined ? undefined : givenValue == null ? "" : dateToString(givenValue)
  defaultText = dateToString(props.defaultValue)
  // Temporal props are held as their form strings: a prop set again to an equal date rebuilds nothing below.
  minText = dateToString(props.min)
  maxText = dateToString(props.max)
  placeholderText = dateToString(props.placeholderValue)
  options: FieldOptions = { type: "date", locale: props.locale, placeholderValue: parseDate(placeholderText, undefined) }
  isDisabled = givenDisabled || (f?.disabled ?? false)
  isReadOnly = givenReadOnly
  isRequired = props.required ?? false
  generatedId = createId("date-field")
  rootId: string = idRef(props.id) ?? generatedId
  labelledBy = f?.labelId ?? idRef(props["aria-labelledby"]) ?? (props["aria-label"] != undefined ? rootId : undefined)

  // The hidden input that submits the value, and whose validity Field reads.
  source hidden: HTMLInputElement | undefined := undefined
  action setHidden(element: HTMLInputElement) {
    hidden := element
    if (f) { f.setInput(element) }
  }
  // Called by the state in a change of its own, never in the one that updates the field.
  action report(text: string) {
    if (props.onValueChange) { props.onValueChange(parseDate(text, undefined)) }
  }
  state = segmentedFieldState(controlled, defaultText, options, isDisabled, isReadOnly, isRequired, minText, maxText, labelledBy, props.emptyText ?? "Empty", props.incompleteMessage ?? "Enter a complete date.", f, hidden, props.invalid, props.describedBy, report)
  text = state.text
  date = parseDate(text, undefined)
  self = latest { ...state, value: date }

  provide dateField = self

  { value, defaultValue, onValueChange, min, max, locale, invalid, describedBy, placeholderValue, disabled, readOnly, required, name, form, emptyText, incompleteMessage, id, children, ...rest } = props
  inputName = (latest name) ?? f?.name
  own = dateFieldRoot(self)
  withId = { ...own, id: rootId }
  merged = latest mergeProps(withId, rest)
  <div {...merged}>{children}</div>
  {if inputName != undefined || f != undefined {
    <input type="date" hidden aria-hidden="true" tabindex="-1" name={inputName} form={form} min={minText == "" ? undefined : minText} max={maxText == "" ? undefined : maxText} step="any" value={self.text} disabled={isDisabled} readonly={isReadOnly} required={isRequired} ref={setHidden} />
  }}
}

// The field's group: `role="group"`, named by FieldLabel or the root's `aria-label`.
export fn dateFieldRoot(ref c: DateFieldContext): PartProps {
  own = segmentedFieldRoot(c)
  own
}

// The box holding the segments. A press on its empty space focuses the first empty segment, or the last.
export fn dateFieldInput(ref c: DateFieldContext): PartProps {
  own = segmentedFieldInput(c)
  own
}

export component DateFieldInput({ children, ...rest }: DivProps) {
  c = use dateField
  own = dateFieldInput(c)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// One segment of `c.segments`: a spinbutton (contenteditable, for the phone keyboard) or an `aria-hidden` literal.
// A component that spreads this renders `segment.text` as the element's only content.
export fn dateFieldSegment(ref c: DateFieldContext, ref segment: KeyedSegment): PartProps {
  own = segmentedFieldSegment(c, segment)
  own
}

export type DateFieldSegmentProps = {
  // One entry of the context's `segments`: render one per entry, `for segment in c.segments`.
  segment: KeyedSegment
} & Omit<SpanProps, "children">

export component DateFieldSegment({ segment, ...rest }: DateFieldSegmentProps) {
  c = use dateField
  own = dateFieldSegment(c, segment)
  merged = latest mergeProps(own, rest)
  <span {...merged}>{segment.text}</span>
}
