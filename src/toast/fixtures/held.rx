import { ToastProvider, ToastViewport, ToastRoot, ToastContent, ToastTitle, ToastClose, toast } from "../toast.rx"
import { save } from "../../test/slow-server.js"

component Adder(props: { label: string }) {
  c = use toast
  action addOne() { c.manager.add({ title: props.label }) }
  <button onClick={addOne}>Add {props.label}</button>
}

component Toasts(props: { step: number; rootProp: boolean; rootAttribute: boolean }) {
  c = use toast
  for t in c.toasts {
    <ToastRoot
      toast={t}
      swipeThreshold={props.rootProp ? (props.step == 1 ? 40 : 50) : 40}
      class={props.rootAttribute ? (props.step == 2 ? "second" : "first") : "first"}
    >
      <ToastContent>
        <ToastTitle />
        <ToastClose>Dismiss</ToastClose>
      </ToastContent>
    </ToastRoot>
  }
}

// An app that holds a plain write in an action (`step := 2`, then a slow request) while something it passes to a
// toast provider or a toast is computed from that write. The toasts' own state (expanded on hover, closing) must
// not wait for the app's request.
export default component Fixture() {
  source step := 1
  action next() {
    step := 2
    try { await save("step") } catch (e) { }
  }

  <main>
    <button onClick={() => { next() }}>Next</button>
    <output data-testid="step">{step}</output>
    <output data-testid="saving">{pending? step ? "saving" : ""}</output>

    // 1. A prop of the provider.
    <ToastProvider timeout={0} limit={step == 1 ? 3 : 4}>
      <Adder label="provider-prop" />
      <ToastViewport data-testid="provider-prop" style="position: fixed; inset: auto auto 0 0; width: 20%; margin: 0">
        <Toasts step={1} rootProp={false} rootAttribute={false} />
      </ToastViewport>
    </ToastProvider>

    // 2. A prop of the toast. It has to change: a prop computed from the held write that comes out equal holds nothing.
    <ToastProvider timeout={0}>
      <Adder label="root-prop" />
      <ToastViewport data-testid="root-prop" style="position: fixed; inset: auto auto 0 25%; width: 20%; margin: 0">
        <Toasts step={step} rootProp={true} rootAttribute={false} />
      </ToastViewport>
    </ToastProvider>

    // 3. An attribute passed through to the toast's element.
    <ToastProvider timeout={0}>
      <Adder label="root-attribute" />
      <ToastViewport data-testid="root-attribute" style="position: fixed; inset: auto auto 0 50%; width: 20%; margin: 0">
        <Toasts step={step} rootProp={false} rootAttribute={true} />
      </ToastViewport>
    </ToastProvider>

    // 4. An attribute passed through to the viewport's element.
    <ToastProvider timeout={0}>
      <Adder label="viewport-attribute" />
      <ToastViewport data-testid="viewport-attribute" class={step == 2 ? "second" : "first"} style="position: fixed; inset: auto auto 0 75%; width: 20%; margin: 0">
        <Toasts step={1} rootProp={false} rootAttribute={false} />
      </ToastViewport>
    </ToastProvider>
  </main>
}
