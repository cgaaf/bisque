import { TableOfContentsRoot, TableOfContentsLink } from "../table-of-contents.rx"

type Section = { id: string; title: string }

// Sections and their links come and go after mount, and a heading gets its id late.
export default component Fixture() {
  source box: HTMLElement | undefined := undefined
  source sections: Section[] := [{ id: "d-one", title: "One" }, { id: "d-two", title: "Two" }]
  source late := false
  action setBox(element: HTMLElement) { box := element }
  action add() { sections := (old) => [...old, { id: "d-three", title: "Three" }] }
  action removeTwo() { sections := (old) => old.filter((s) => s.id != "d-two") }
  <style>
    :global(.dynamic h2) { height: 30px; margin: 0; }
    :global(.dynamic .box) { height: 200px; overflow: auto; }
  </style>
  <div class="dynamic">
    <button type="button" onClick={() => { add() }}>Add three</button>
    <button type="button" onClick={() => { removeTwo() }}>Remove two</button>
    <button type="button" onClick={() => { late := true }}>Name late heading</button>
    <TableOfContentsRoot aria-label="Sections" container={box}>
      <ul>
        {for s in sections {
          <li><TableOfContentsLink href={"#" + s.id}>{s.title}</TableOfContentsLink></li>
        }}
        <li><TableOfContentsLink href="#d-late">Late</TableOfContentsLink></li>
      </ul>
    </TableOfContentsRoot>
    <div class="box" data-testid="box" ref={setBox}>
      {for s in sections {
        <section>
          <h2 id={s.id}>{s.title}</h2>
          <div style="height: 300px"></div>
        </section>
      }}
      <h2 id={late ? "d-late" : undefined} data-testid="late">Late</h2>
      <div style="height: 300px"></div>
    </div>
  </div>
}
