import { mergeProps, createRef } from "../internal/props.js"
import { createFormReset, sameValue } from "../internal/field.js"
import { field, fieldGroupProps } from "../field/field.rx"
import { DivProps } from "../internal/types.rx"

// Read optionally by CheckboxRoot: a box with a `value` inside a group is checked while the group's value holds it;
// a `parent` box checks or clears them all.
export type CheckboxGroupContext = {
  value: string[]
  // Every value a box in the group can have: what the parent box checks.
  allValues: string[]
  disabled: boolean
  // Counts form resets, so every box is set back to the group's value after one.
  revision: number
  setChecked: (value: string, checked: boolean) => void
  // What pressing the parent box does: mixed, then all, then none, then the mixed selection again.
  pressParent: () => void
}

export context checkboxGroup: CheckboxGroupContext | undefined = undefined

export type CheckboxGroupProps = {
  value?: string[]
  defaultValue?: string[]
  onValueChange?: (value: string[]) => void
  // Needed for a parent box.
  allValues?: string[]
  disabled?: boolean
} & DivProps

// A set of checkboxes sharing one value: the list of the checked boxes' values. Inside a FieldRoot it is the
// field's control.
export component CheckboxGroup(props: CheckboxGroupProps) {
  f = use field
  // Seeded with copies: a write to a list source replaces its contents in place, so a source seeded with the
  // consumer's array would change that array, and two sources seeded with one array would change together.
  source uncontrolled: string[] := peek([...(props.defaultValue ?? [])])
  // `value` and `disabled` are often read from an answer that can fail (`value={saved}` with
  // `saved = await load()`): a failure there is the app's to show, in its `errored` region, not the group's.
  givenValue = props.value catch (e) => undefined
  givenDisabled = (props.disabled ?? false) catch (e) => false
  current = givenValue ?? uncontrolled
  // The selection the parent box returns to after all and none, and where it is in that cycle.
  source saved: string[] := peek([...(givenValue ?? props.defaultValue ?? [])])
  source status: "mixed" | "on" | "off" := "mixed"
  source revision := 0
  source element: HTMLElement | undefined := undefined
  // What a form reset puts back. Each box's `defaultChecked` is whether this list holds its value.
  initialValue = peek([...current])
  all = props.allValues ?? []
  isDisabled = givenDisabled || (f?.disabled ?? false)

  effect (current) { if (f) { f.setValue($0) } }
  // The group answers a reset for all its boxes, so it is reported once.
  _reset = createFormReset(element, reset)

  // The owner's handler is called in a change of its own (`onFlush`), never in the one that updates the group: a
  // handler that saves holds its change until the answer lands, and the boxes would be held with it.
  action notify(next: string[]) {
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(next) })
    }
  }
  action commit(next: string[]) {
    uncontrolled := next
    notify(next)
  }
  action setChecked(value: string, checked: boolean) {
    let next = checked ? (current.includes(value) ? [...current] : [...current, value]) : current.filter((other) => other != value)
    commit(next)
    saved := next
    status := "mixed"
  }
  // The browser has put every box back to `defaultChecked`. Uncontrolled, the default is the new value, reported
  // once if it changed; controlled, the owner's value is written back over the boxes.
  action reset() {
    revision := revision + 1
    let next = givenValue ?? [...initialValue]
    saved := [...next]
    status := "mixed"
    if (givenValue == undefined && !sameValue(next, uncontrolled)) {
      uncontrolled := next
      notify(next)
    }
    if (f) { f.reset(next) }
  }
  action writeElement(div: HTMLElement) { element := div }
  setElement = createRef(writeElement)
  action pressParent() {
    if (saved.length == 0 || saved.length == all.length) {
      commit(current.length == all.length ? [] : [...all])
      return
    }
    // Compared through a local: narrowing `status` itself would type the writes below (rx-tsc).
    let was = status
    if (was == "mixed") {
      commit([...all])
      status := "on"
    } else if (was == "on") {
      commit([])
      status := "off"
    } else {
      commit([...saved])
      status := "mixed"
    }
  }

  provide checkboxGroup = { value: current, allValues: all, disabled: isDisabled, revision: revision, setChecked: setChecked, pressParent: pressParent }

  { value, defaultValue, onValueChange, allValues, disabled, children, ...rest } = props
  group = fieldGroupProps(f)
  own = mergeProps(group, { role: "group", "data-disabled": isDisabled ? "" : undefined, ref: setElement })
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
