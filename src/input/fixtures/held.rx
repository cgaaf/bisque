import { Input } from "../input.rx"
import { FieldRoot, FieldLabel } from "../../field/field.rx"
import { save } from "../../test/slow-server.js"

// An app that holds a plain write in an action (`step := 2`, then a slow request) while an attribute it passes to
// an Input is computed from that write. The input's own state (what was typed, which its field tracks) must not
// wait for the app's request.
export default component Fixture() {
  source step := 1
  action next() {
    step := 2
    try { await save("step") } catch (e) { }
  }

  <main>
    <button onClick={() => { next() }}>Next</button>
    <output data-testid="step">{step}</output>
    <output data-testid="saving">{pending? step ? "saving" : ""}</output>

    <FieldRoot data-testid="root" validationMode="onChange" validate={(value) => value == "bad" ? "Bad" : null}>
      <FieldLabel>Attribute</FieldLabel>
      <Input class={step == 2 ? "second" : "first"} />
    </FieldRoot>
    <button>After</button>
  </main>
}
