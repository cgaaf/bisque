import { mergeProps } from "../internal/props.js"
import { field, fieldControl, FieldControlProps } from "../field/field.rx"

export type InputComponentProps = FieldControlProps

// A native <input>. Inside a FieldRoot it is the field's control: labelled and described by the field's parts,
// disabled with it, and validated by it. `onValueChange` receives the new value on every input.
export component Input(props: InputComponentProps) {
  f = use field
  { value, defaultValue, onValueChange, disabled, children, ...rest } = props
  // The app's handler is called in a change of its own (`onFlush`), never in the one the keystroke makes: a handler
  // that writes what a loading question reads (a check as the person types), or that saves, would hold the input's
  // own state and the field's with it until the answer lands, every keystroke queued behind the first.
  action report(next: string) {
    if (onValueChange) {
      let handler = onValueChange
      onFlush(() => { handler(next) })
    }
  }
  own = fieldControl(f, value, peek(defaultValue ?? ""), report, disabled == true)
  merged = mergeProps(own, latest rest)
  <input {...merged} />
}
