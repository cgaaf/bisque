// Radios on the native <input type="radio">, styleable whole with `appearance: none`. Radios that share a `name`
// are one Tab stop (the checked radio, else the first), and the browser moves between them and checks them with
// the arrow keys, skipping disabled ones; it also provides Space, label association, form submission, `required`
// validation and the style hooks `:checked`, `:disabled`, `:focus-visible` and `:user-invalid`. This family adds
// the group's role and labelling, a controlled value, a shared name when none is given, `readOnly`, and the Field
// wiring.
//
// An <input> can't have children, so RadioRoot renders its children right after the radio: RadioIndicator is the
// radio's next sibling, styled from it (`input:checked + span`), or the radio draws its own mark (`::before`).
import { mergeProps, createId, createRef } from "../internal/props.js"
import { createFormReset } from "../internal/field.js"
import { createCheckedInput } from "../internal/checked-input.js"
import { createFocusKeeper } from "../internal/focus-keeper.js"
import { field, fieldGroupProps } from "../field/field.rx"
import { DivProps, InputProps, SpanProps } from "../internal/types.rx"

export type RadioGroupContext = {
  value: string | undefined
  // The radios' shared name: the group's, else its FieldRoot's, else a generated one. Sharing it is what makes the
  // browser treat them as one group.
  name: string
  disabled: boolean
  readOnly: boolean
  required: boolean
  // The value the group started with: a radio holding it is `defaultChecked`, what a form reset restores.
  initialValue: string | undefined
  // Counts form resets, so every radio is set back to the state after one (createCheckedInput).
  revision: number
  select: (value: string) => void
  setInput: (element: HTMLInputElement) => void
}

export context radioGroup: RadioGroupContext

export type RadioGroupProps = {
  value?: string
  defaultValue?: string
  // Called with the new value. Not called when a form reset clears a group that has no default.
  onValueChange?: (value: string) => void
  disabled?: boolean
  // The radios are focusable and the arrow keys move between them, but nothing is checked.
  readOnly?: boolean
  required?: boolean
  // The radios' name: they submit the checked value under it with their form. Without one (and outside a named
  // FieldRoot) a generated name groups them, and a form they are in submits the value under that name.
  name?: string
} & DivProps

// A set of radios of which one is checked. Inside a FieldRoot it is the field's control.
export component RadioGroup(props: RadioGroupProps) {
  f = use field
  source uncontrolled: string | undefined := peek(props.defaultValue)
  source revision := 0
  // A radio of the group, for the form it is in: the group answers a reset for all its radios.
  source anyRadio: HTMLInputElement | undefined := undefined
  // `value` and `disabled` are often read from an answer that can fail (`value={saved}` with
  // `saved = await load()`): a failure there is the app's to show, in its `errored` region, not the group's.
  givenValue = props.value catch (e) => undefined
  givenDisabled = (props.disabled ?? false) catch (e) => false
  current = givenValue ?? uncontrolled
  // The value a form reset puts back: each radio's `defaultChecked` is whether it holds this one.
  initialValue = peek(current)
  isDisabled = givenDisabled || (f?.disabled ?? false)
  isReadOnly = props.readOnly ?? false
  isRequired = props.required ?? false
  generatedName = createId("radio-group")
  // A plain value, so the context below isn't rebuilt each time the field's context is.
  groupName = props.name ?? f?.name ?? generatedName

  effect (current) { if (f) { f.setValue($0) } }
  _reset = createFormReset(anyRadio, reset)

  // The owner's handler is called in a change of its own (`onFlush`), never in the one that updates the group: a
  // handler that saves (an action that awaits, or a write a loading question reads) holds its change until the
  // answer lands, and the radios would be held with it, showing the browser's choice whatever the owner decided.
  action notify(value: string) {
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(value) })
    }
  }
  // The browser has already checked the radio: report that, and let the state decide what is checked. The radios
  // are set back to the state once the owner's change has run too (createCheckedInput).
  action select(value: string) {
    if (isDisabled || isReadOnly || value == current) { return }
    uncontrolled := value
    notify(value)
  }
  // The browser has put every radio back to `defaultChecked`. Uncontrolled, the default is the new value, reported
  // once if it changed; controlled, the owner's value is written back over it.
  action reset() {
    revision := revision + 1
    let next = givenValue ?? initialValue
    if (givenValue == undefined && next != uncontrolled) {
      uncontrolled := next
      if (next != undefined) { notify(next) }
    }
    if (f) { f.reset(next) }
  }
  action setInput(element: HTMLInputElement) {
    anyRadio := element
    if (f) { f.setInput(element) }
  }

  provide radioGroup = {
    value: current,
    name: groupName,
    disabled: isDisabled,
    readOnly: isReadOnly,
    required: isRequired,
    initialValue: initialValue,
    revision: revision,
    select: select,
    setInput: setInput,
  }

  { value, defaultValue, onValueChange, disabled, readOnly, required, name, children, ...rest } = props
  inField = fieldGroupProps(f)
  own = mergeProps(inField, {
    role: "radiogroup",
    "aria-disabled": isDisabled ? "true" : undefined,
    "aria-readonly": isReadOnly ? "true" : undefined,
    "aria-required": isRequired ? "true" : undefined,
    "data-disabled": isDisabled ? "" : undefined,
    "data-readonly": isReadOnly ? "" : undefined,
  })
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// For a custom indicator that renders differently per state (RadioRoot provides it to its children).
export type RadioContext = {
  checked: boolean
  disabled: boolean
  readOnly: boolean
  required: boolean
}

export context radio: RadioContext

export type RadioRootProps = {
  value: string
  disabled?: boolean
  readOnly?: boolean
  // Rendered after the radio, as its siblings: a RadioIndicator or the consumer's own.
  children?: View
} & Omit<InputProps, "value" | "name" | "disabled" | "checked" | "defaultChecked" | "readOnly" | "readonly" | "required" | "type" | "children">

export component RadioRoot(props: RadioRootProps) {
  g = use radioGroup
  source element: HTMLInputElement | undefined := undefined
  // The group's context is a new object whenever its value changes. Each radio reads it into plain values first,
  // so its own objects (`self`, `own`) are rebuilt only when something about this radio changed, not for every
  // radio on every choice.
  isChecked = g.value == props.value
  isDisabled = g.disabled || (props.disabled ?? false)
  isReadOnly = g.readOnly || (props.readOnly ?? false)
  isRequired = g.required
  groupName = g.name
  isDefault = g.initialValue == props.value
  self = {
    checked: isChecked,
    disabled: isDisabled,
    readOnly: isReadOnly,
    required: isRequired,
  }
  _input = createCheckedInput(element, isChecked, false, g.revision)
  // Disabled while it had focus (`disabled={pending? setting}`), it takes focus back when re-enabled.
  _focus = createFocusKeeper(element, isDisabled)

  action change() { g.select(props.value) }
  // Cancelling the click keeps the radios as they were: the browser restores them and fires no change. The arrow
  // keys dispatch a click too (in all three engines), so focus still moves through a read-only group.
  action click(event: MouseEvent) { if (isReadOnly) { event.preventDefault() } }
  action writeElement(input: HTMLInputElement) {
    element := input
    g.setInput(input)
  }
  setElement = createRef(writeElement)

  provide radio = self

  { value, disabled, readOnly, children, ...rest } = props
  own = {
    type: "radio",
    name: groupName,
    value: value,
    defaultChecked: isDefault,
    disabled: isDisabled ? true : undefined,
    required: isRequired ? true : undefined,
    "data-readonly": isReadOnly ? "" : undefined,
    ref: setElement,
    onChange: change,
    onClick: click,
  }
  merged = mergeProps(own, rest)
  <input {...merged} />
  {children}
}

// A mark beside the radio, always in the document: place it in RadioRoot, where it is the radio's next sibling,
// and show it with `input:checked + *`. Hidden from assistive technology.
export component RadioIndicator({ children, ...rest }: SpanProps) {
  merged = mergeProps({ "aria-hidden": "true" }, rest)
  <span {...merged}>{children}</span>
}
