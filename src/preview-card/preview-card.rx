// A card that previews what a link points to, shown while the link is hovered or focused. It is supplementary:
// the link works without it, so the popup takes no role and focus never moves into it on its own.
//
// The card is a `popover="manual"` element opened with `showPopover({ source: link })`: the browser provides the
// top layer and the placement against the link with CSS anchor positioning. Hover-triggered popovers
// (`interestfor`, `popover="hint"`) aren't shipped in every engine yet, so this family keeps the hover intent and
// closes on Escape and on a press outside itself. There is no Portal or Positioner part: the popup is the
// positioned element, styled with `:popover-open` and `@starting-style`.
import { mergeProps } from "../internal/props.js"
import { createHoverIntent, createManualDismiss } from "../internal/overlay.js"
import { createPopoverState, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { DivProps, AnchorProps, PartProps } from "../internal/types.rx"

export type PreviewCardContext = PopoverState

export context previewCard: PreviewCardContext

export type PreviewCardRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  children?: View
}

export component PreviewCardRoot(props: PreviewCardRootProps) {
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), props.onOpenChange)
  action dismiss(reason: "escape-key" | "outside-press") { state.setOpen(false) }
  _dismiss = createManualDismiss(state.open, state.trigger, state.popup, dismiss)
  provide previewCard = state
  {props.children}
}

export type PreviewCardTriggerProps = {
  // How long the pointer rests on the link (or focus stays on it) before the card opens, in ms. Default: 600.
  delay?: number
  // How long after the pointer leaves the link and the card before it closes, in ms. Default: 300.
  closeDelay?: number
} & AnchorProps

// Spread on the link the card previews. It opens the card on hover and keyboard focus, after the delay.
export fn previewCardTrigger(ref c: PreviewCardContext, ref delay: number, ref closeDelay: number): PartProps {
  action change(next: boolean, reason: "hover" | "focus" | "press" | "group") { c.setOpen(next) }
  _hover = createHoverIntent(true, c.open, c.trigger, c.popup, {
    openDelay: delay,
    closeDelay: closeDelay,
    hoverablePopup: true,
    focus: true,
    focusDelay: delay,
    closeOnPress: false,
    group: undefined,
  }, change)
  { "data-popup-open": c.open ? "" : undefined, ref: c.setTrigger }
}

export component PreviewCardTrigger({ delay = 600, closeDelay = 300, children, ...rest }: PreviewCardTriggerProps) {
  c = use previewCard
  own = previewCardTrigger(c, delay, closeDelay)
  merged = mergeProps(own, rest)
  <a {...merged}>{children}</a>
}

export type PreviewCardPopupProps = {
  // Which side of the link it sits on; the browser flips it when it doesn't fit. Default: "bottom".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the link it lines up with. Default: "center".
  align?: "start" | "center" | "end"
  // Gap between link and card, in pixels. Default: 0.
  sideOffset?: number
  alignOffset?: number
} & DivProps

export fn previewCardPopup(ref c: PreviewCardContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(c, "manual", side, align, sideOffset, alignOffset)
  base
}

export component PreviewCardPopup({ side = "bottom", align = "center", sideOffset = 0, alignOffset = 0, children, ...rest }: PreviewCardPopupProps) {
  c = use previewCard
  own = previewCardPopup(c, side, align, sideOffset, alignOffset)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn previewCardArrow(ref c: PreviewCardContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component PreviewCardArrow({ children, ...rest }: DivProps) {
  c = use previewCard
  own = previewCardArrow(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
