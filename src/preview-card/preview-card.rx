// A card that previews what a link points to, shown while the link is hovered or focused. It is supplementary:
// the link works without it, so the popup takes no role and focus never moves into it on its own.
import { mergeProps, createId } from "../internal/props.js"
import { createFloating } from "../internal/dom.js"
import { createHoverIntent, createArrow } from "../internal/overlay.js"
import { createPopupState, popupStateAttributes, PopupState } from "../internal/popup.rx"
import { DivProps, AnchorProps, PartProps } from "../internal/types.rx"

export type PreviewCardContext = PopupState & {
  popupId: string
}

export context previewCard: PreviewCardContext

export type PreviewCardRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  children?: View
}

export component PreviewCardRoot(props: PreviewCardRootProps) {
  state = createPopupState(props.open, peek(props.defaultOpen ?? false), true, props.onOpenChange)
  popupId = createId("preview-card")
  provide previewCard = { ...state, popupId: popupId }
  {props.children}
}

export type PreviewCardTriggerProps = {
  // How long the pointer rests on the link (or focus stays on it) before the card opens, in ms. Default: 600.
  delay?: number
  // How long after the pointer leaves the link and the card before it closes, in ms. Default: 300.
  closeDelay?: number
} & AnchorProps

export fn previewCardTrigger(ref c: PreviewCardContext, ref delay: number, ref closeDelay: number): PartProps {
  action change(next: boolean, reason: "hover" | "focus" | "press" | "group") { c.setOpen(next) }
  _hover = createHoverIntent(true, c.open, c.trigger, c.popup, {
    openDelay: delay,
    closeDelay: closeDelay,
    hoverablePopup: true,
    focus: true,
    focusDelay: delay,
    closeOnPress: false,
    group: undefined,
  }, change)
  { "data-popup-open": c.open ? "" : undefined, ref: c.setTrigger }
}

export component PreviewCardTrigger({ delay = 600, closeDelay = 300, children, ...rest }: PreviewCardTriggerProps) {
  c = use previewCard
  own = previewCardTrigger(c, delay, closeDelay)
  merged = mergeProps(own, rest)
  <a {...merged}>{children}</a>
}

// Renders its children at the end of <body> while the card is mounted.
export component PreviewCardPortal(props: { keepMounted?: boolean; children?: View }) {
  c = use previewCard
  {if c.mounted || (props.keepMounted ?? false) {
    portal { {props.children} }
  }}
}

// Where the positioner put the popup, for the popup and the arrow inside it.
export type PreviewCardPositionerContext = {
  side: "top" | "bottom" | "left" | "right"
  align: "start" | "center" | "end"
  arrowUncentered: boolean
  setArrow: (element: HTMLElement) => void
}

export context previewCardPositioner: PreviewCardPositionerContext

export type PreviewCardPositionerProps = {
  side?: "top" | "bottom" | "left" | "right"
  align?: "start" | "center" | "end"
  sideOffset?: number
  alignOffset?: number
  collisionPadding?: number
} & DivProps

// Positions the card against the link, below it by default. Carries `data-side` and `data-align`.
export component PreviewCardPositioner(props: PreviewCardPositionerProps) {
  c = use previewCard
  source arrow: HTMLElement | undefined := undefined
  action setArrow(element: HTMLElement) { arrow := element }
  [usedSide, usedAlign] = createFloating(c.mounted, c.trigger, c.positioner, {
    side: props.side ?? "bottom",
    align: props.align ?? "center",
    sideOffset: props.sideOffset ?? 0,
    alignOffset: props.alignOffset ?? 0,
    collisionPadding: props.collisionPadding ?? 5,
  })
  arrowUncentered = createArrow(c.mounted, c.trigger, c.positioner, arrow, usedSide)
  provide previewCardPositioner = { side: usedSide, align: usedAlign, arrowUncentered: arrowUncentered, setArrow: setArrow }
  { side, align, sideOffset, alignOffset, collisionPadding, children, ...rest } = props
  state = popupStateAttributes(c)
  merged = mergeProps({ role: "presentation", "data-side": usedSide, "data-align": usedAlign, ref: c.setPositioner, ...state }, rest)
  <div {...merged}>{children}</div>
}

export fn previewCardPopup(ref c: PreviewCardContext): PartProps {
  state = popupStateAttributes(c)
  { id: c.popupId, ref: c.setPopup, ...state }
}

export component PreviewCardPopup({ children, ...rest }: DivProps) {
  c = use previewCard
  p = use previewCardPositioner
  own = previewCardPopup(c)
  merged = mergeProps({ ...own, "data-side": p.side, "data-align": p.align }, rest)
  <div {...merged}>{children}</div>
}

// Points at the link. Its offset along the card's edge is written for you; place it on the edge with CSS, by
// `data-side`.
export component PreviewCardArrow({ children, ...rest }: DivProps) {
  c = use previewCard
  p = use previewCardPositioner
  state = popupStateAttributes(c)
  merged = mergeProps({
    "aria-hidden": "true",
    "data-side": p.side,
    "data-align": p.align,
    "data-uncentered": p.arrowUncentered ? "" : undefined,
    ref: p.setArrow,
    ...state,
  }, rest)
  <div {...merged}>{children}</div>
}
