import { PreviewCardRoot, PreviewCardTrigger, PreviewCardPopup } from "../preview-card.rx"
import { save } from "../../test/slow-server.js"

// An app that holds a plain write in an action (`step := 2`, then a slow request) while something it passes to a
// preview card is computed from that write. The card's own state must not wait for the app's request. Each value
// computed from `step` has to change: one that comes out equal holds nothing.
export default component Fixture() {
  source step := 1
  action next() {
    step := 2
    try { await save("step") } catch (e) { }
  }

  <main style="padding: 40px 0 0 40px">
    <button onClick={() => { next() }}>Next</button>
    <output data-testid="step">{step}</output>
    <output data-testid="saving">{pending? step ? "saving" : ""}</output>
    <p data-testid="outside">Elsewhere</p>

    // 1. A prop of the popup.
    <PreviewCardRoot>
      <p><PreviewCardTrigger href="#two" delay={0} closeDelay={0}>Popup prop</PreviewCardTrigger></p>
      <PreviewCardPopup data-testid="popup-prop" side={step == 1 ? "right" : "left"}>Two</PreviewCardPopup>
    </PreviewCardRoot>

    // 2. An attribute passed through to the trigger's element.
    <PreviewCardRoot>
      <p><PreviewCardTrigger href="#three" delay={0} closeDelay={0} class={step == 2 ? "second" : "first"}>Trigger attribute</PreviewCardTrigger></p>
      <PreviewCardPopup data-testid="trigger-attribute" side="right">Three</PreviewCardPopup>
    </PreviewCardRoot>
  </main>
}
