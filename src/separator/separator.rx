// A separator is an <hr>, which has the separator role and is horizontal by default; `aria-orientation` is written
// only when it is vertical. Style it with `hr`, and a vertical one with `[aria-orientation="vertical"]`.
import { mergeProps } from "../internal/props.js"
import { PartProps } from "../internal/types.rx"

export type SeparatorOrientation = "horizontal" | "vertical"
// No alias for <hr> in src/internal/types.rx yet.
export type HrProps = import("../internal/impl/types.ts").ElementProps<"hr">

export type SeparatorProps = {
  orientation?: SeparatorOrientation
} & HrProps

// What a separator is on an element that doesn't have the role itself (a <div> in a toolbar): the role, and both
// orientations spelled out. Separator's own <hr> needs none of it.
export fn separator(ref orientation: SeparatorOrientation): PartProps {
  {
    role: "separator",
    "aria-orientation": orientation,
    "data-orientation": orientation,
  }
}

export component Separator({ orientation = "horizontal", ...rest }: SeparatorProps) {
  own = { "aria-orientation": (latest orientation) == "vertical" ? "vertical" : undefined }
  merged = latest mergeProps(own, rest)
  <hr {...merged} />
}
