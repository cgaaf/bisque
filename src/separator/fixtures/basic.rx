import { Separator, separator } from "../separator.rx"

component DivSeparator() {
  s = separator("vertical")
  <div data-testid="div" {...s} />
}

export default component Fixture() {
  source vertical := false
  <main>
    <Separator data-testid="default" class="line" />
    <Separator data-testid="vertical" orientation="vertical" />
    <Separator data-testid="switch" orientation={vertical ? "vertical" : "horizontal"} />
    <button onClick={() => { vertical := !vertical }}>Flip</button>
    <DivSeparator />
  </main>
}
