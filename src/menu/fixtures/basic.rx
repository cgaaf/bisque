import { MenuRoot, MenuTrigger, MenuPopup, MenuItem, MenuSeparator, MenuGroup, MenuGroupLabel, MenuCheckboxItem, MenuRadioGroup, MenuRadioItem } from "../menu.rx"

export default component Fixture() {
  source chosen := "none"
  source sort := "name"
  source wrap := false
  source changes := 0
  <main style="padding: 80px 0 0 120px">
    <MenuRoot onOpenChange={() => { changes := changes + 1 }}>
      <MenuTrigger>Actions</MenuTrigger>
      <MenuPopup data-testid="popup" sideOffset={4} style="width: 160px; padding: 0; border: 0">
        <MenuItem onClick={() => { chosen := "rename" }}>Rename</MenuItem>
        <MenuItem disabled onClick={() => { chosen := "archive" }}>Archive</MenuItem>
        <MenuItem onClick={() => { chosen := "delete" }}>Delete</MenuItem>
        <MenuSeparator />
        <MenuCheckboxItem checked={wrap} onCheckedChange={(next) => { wrap := next }}>Word wrap</MenuCheckboxItem>
        <MenuGroup>
          <MenuGroupLabel>Sort by</MenuGroupLabel>
          <MenuRadioGroup value={sort} onValueChange={(next) => { sort := next }}>
            <MenuRadioItem value="name">Name</MenuRadioItem>
            <MenuRadioItem value="date">Date</MenuRadioItem>
          </MenuRadioGroup>
        </MenuGroup>
      </MenuPopup>
    </MenuRoot>
    <button>After</button>
    <output data-testid="chosen">{chosen}</output>
    <output data-testid="sort">{sort}</output>
    <output data-testid="wrap">{wrap ? "on" : "off"}</output>
    <output data-testid="changes">{changes}</output>
    <p data-testid="outside" style="position: fixed; top: 0; right: 0; margin: 0">outside</p>
  </main>
}
