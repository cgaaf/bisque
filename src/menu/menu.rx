// A menu on the native `popover` attribute. The browser provides the top layer, closing on Escape and on a press
// outside, nesting (a submenu's popup sits inside its parent's, so the browser keeps the parent open while it is
// open and closes it with the parent), and the placement against the trigger with CSS anchor positioning. The
// platform has no menu keyboard model, so this family adds it: roving focus and typeahead between items, item
// kinds and their activation, moving focus into the menu on open and back to the trigger on close, and the ARIA
// roles. There is no Portal, Positioner or Backdrop part: the popup is the positioned element, styled with
// `:popover-open` and `@starting-style`, and it stays in the document while closed.
import { mergeProps, withoutHandlers, createId } from "../internal/props.js"
import { createRovingFocus, focusElement, clickElement, focusListItem } from "../internal/dom.js"
import { createHoverIntent } from "../internal/overlay.js"
import { createMenuFocus, adjacentItem } from "../internal/menu.js"
import { createPopoverState, popoverPopupProps, popoverArrowProps, PopoverState } from "../internal/popover.rx"
import { DivProps, ButtonProps, AnchorProps, PartProps } from "../internal/types.rx"

// Where focus goes when a menu opens: its popup, its first or last item, or nowhere (a submenu opened by hover).
export type MenuOpenFocus = "none" | "container" | "first-item" | "last-item"

// `trigger` is the element the popup is anchored to: the MenuTrigger, a submenu's trigger item, or a context
// menu's point.
export type MenuContext = PopoverState & {
  // Names this menu in a Menubar (MenubarContext.openMenu).
  menuId: string
  openFocus: MenuOpenFocus
  openWith: (focus: MenuOpenFocus) => void
  disabled: boolean
  // Closes this menu and every menu it is nested in: choosing an item, Tab.
  closeTree: () => void
  isSubmenu: boolean
  // In a menubar: opens the menu `direction` triggers along from this tree's top-level trigger.
  moveInMenubar: (direction: number) => void
}

export context menu: lane MenuContext

// What a Menubar shares with the menus in it. `present` is false outside one.
export type MenubarContext = {
  present: boolean
  orientation: "horizontal" | "vertical"
  disabled: boolean
  loop: boolean
  // The `menuId` of the menu that is open, if one is.
  openMenu: string | undefined
  openFocus: MenuOpenFocus
  element: HTMLElement | undefined
  setOpenMenu: (id: string | undefined, focus: MenuOpenFocus) => void
}

export context menubar: lane MenubarContext = {
  present: false,
  orientation: "horizontal",
  disabled: false,
  loop: true,
  openMenu: undefined,
  openFocus: "container",
  element: undefined,
  setOpenMenu: (id, focus) => undefined,
}

export type MenuRootProps = {
  open?: boolean
  defaultOpen?: boolean
  // Called after the browser or a part opened or closed it. A press outside and Escape can't be refused: a
  // controlled menu that keeps `open` true is shown again.
  onOpenChange?: (open: boolean) => void
  // A disabled menu doesn't open. Default: false.
  disabled?: boolean
  children?: View
}

export component MenuRoot(props: MenuRootProps) {
  bar = use menubar
  source localFocus: MenuOpenFocus := "container"
  menuId = createId("menu")
  inBar = bar.present
  isDisabled = (props.disabled ?? false) || bar.disabled

  // The app's handler is called in a change of its own (`onFlush`), never in the one that opens or closes the menu:
  // a handler that writes what a loading question reads (items that load when it opens), or that is an action
  // awaiting a request, holds its change until the answer lands, and the menu (and the browser's popover, put back
  // in step with the held state) would wait with it.
  action notifyOpen(next: boolean) {
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
  }
  action changed(next: boolean) {
    if (inBar) {
      if (next) { bar.setOpenMenu(menuId, localFocus) } else if (bar.openMenu == menuId) { bar.setOpenMenu(undefined, "container") }
    } else {
      notifyOpen(next)
    }
  }
  // In a menubar the bar holds which menu is open, and it changes in more ways than this menu sees (ArrowLeft and
  // ArrowRight move to a neighbour, opening one closes the other), so the handler follows the bar's state.
  barOpen = inBar && bar.openMenu == menuId
  source reported: boolean := false
  action reportBar(next: boolean) {
    let was = reported
    if (next != was) {
      reported := next
      notifyOpen(next)
    }
  }
  effect (barOpen) { if (inBar) { reportBar($0) } }

  state = createPopoverState(inBar ? bar.openMenu == menuId : props.open, peek(props.defaultOpen ?? false), changed)
  openFocus = inBar ? bar.openFocus : localFocus

  action openWith(focus: MenuOpenFocus) {
    if (isDisabled) { return }
    if (inBar) {
      if (bar.openMenu == menuId) { return }
      bar.setOpenMenu(menuId, focus)
      return
    }
    localFocus := focus
    state.setOpen(true)
  }
  action closeTree() { state.setOpen(false) }
  action moveInMenubar(direction: number) {
    if (!inBar) { return }
    let next = adjacentItem(bar.element, state.trigger, direction, bar.loop)
    if (!next) { return }
    let id = next.getAttribute("data-bisque-menu-id")
    if (id) {
      bar.setOpenMenu(id, "first-item")
    } else {
      state.setOpen(false)
      focusElement(next)
    }
  }

  _focus = createMenuFocus(state.open, state.popup, openFocus, state.trigger, true)

  provide menu = {
    ...state,
    menuId: menuId,
    openFocus: openFocus,
    openWith: openWith,
    disabled: isDisabled,
    closeTree: closeTree,
    isSubmenu: false,
    moveInMenubar: moveInMenubar,
  }

  {props.children}
}

// Spread on a <button>. `popovertarget` is there so the browser doesn't count a press on the trigger as a press
// outside the open menu; the click itself is the menu's (it is prevented, so the browser doesn't toggle), which
// lets a menubar keep a menu open that hovering opened.
export fn menuTrigger(ref c: MenuContext, ref bar: MenubarContext): PartProps {
  vertical = bar.orientation == "vertical"
  // Set while the pointer that opened the menu by hovering is still on the trigger: its click keeps it open.
  source hoverOpened: boolean := false
  action press(event: MouseEvent) {
    event.preventDefault()
    // Read into a local: narrowing `hoverOpened` itself would narrow the type rx-tsc gives its write.
    let stick = hoverOpened
    if (c.open && stick) {
      hoverOpened := false
    } else if (c.open) {
      c.setOpen(false)
    } else {
      c.openWith("container")
    }
  }
  action keyDown(event: KeyboardEvent) {
    if (event.key == "Enter" || event.key == " " || (vertical && bar.present ? event.key == "ArrowRight" : event.key == "ArrowDown")) {
      event.preventDefault()
      c.openWith("first-item")
    } else if (event.key == "ArrowUp" && !(bar.present && vertical)) {
      event.preventDefault()
      c.openWith("last-item")
    }
  }
  // In a menubar with a menu open, moving the pointer onto another trigger opens its menu instead.
  action pointerEnter(event: PointerEvent) {
    if (bar.present && !c.disabled && event.pointerType != "touch" && bar.openMenu != undefined && bar.openMenu != c.menuId) {
      hoverOpened := true
      c.openWith("container")
    }
  }
  action pointerLeave() { hoverOpened := false }
  {
    type: "button",
    popovertarget: c.popupId,
    role: bar.present ? "menuitem" : undefined,
    disabled: c.disabled ? true : undefined,
    "aria-haspopup": "menu",
    "aria-expanded": c.open ? "true" : "false",
    "aria-controls": c.popupId,
    "data-popup-open": c.open ? "" : undefined,
    "data-disabled": c.disabled ? "" : undefined,
    "data-bisque-item": bar.present ? "" : undefined,
    "data-bisque-menu-id": bar.present ? c.menuId : undefined,
    ref: c.setTrigger,
    onClick: press,
    onKeyDown: keyDown,
    onPointerEnter: pointerEnter,
    onPointerLeave: pointerLeave,
  }
}

export component MenuTrigger({ children, ...rest }: ButtonProps) {
  c = use menu
  bar = use menubar
  own = menuTrigger(c, bar)
  merged = latest mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

export type MenuPopupProps = {
  // Which side of the trigger it sits on; the browser flips it when it doesn't fit. Default: "bottom"; "right"
  // for a submenu and in a vertical menubar.
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the trigger it lines up with. Default: "start".
  align?: "start" | "center" | "end"
  // Gap between trigger and popup, in pixels. Default: 0.
  sideOffset?: number
  // How far it is moved along the trigger's edge from its `align` position, in pixels. Default: 0.
  alignOffset?: number
} & DivProps

// The menu: a `popover="auto"` element placed against its trigger. A submenu's popup is declared inside the
// parent's popup, which is what makes the browser treat it as nested.
export fn menuPopup(ref c: MenuContext, ref bar: MenubarContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(c, "auto", side, align, sideOffset, alignOffset)
  _roving = createRovingFocus(c.popup, { orientation: "vertical", loop: true, typeahead: true, tabStop: false })
  action keyDown(event: KeyboardEvent & { currentTarget: HTMLElement; target: HTMLElement }) {
    // A submenu's popup is inside this one, so its key events bubble through here: leave them to it.
    if (event.defaultPrevented || event.target.closest("[popover]") != event.currentTarget) { return }
    if (event.key == "Tab") {
      // Tab leaves the menu, so the whole tree closes.
      c.closeTree()
    } else if (event.key == "ArrowLeft" && c.isSubmenu) {
      event.preventDefault()
      c.setOpen(false)
    } else if (bar.present && bar.orientation == "horizontal" && (event.key == "ArrowLeft" || event.key == "ArrowRight")) {
      event.preventDefault()
      c.moveInMenubar(event.key == "ArrowRight" ? 1 : -1)
    }
  }
  {
    ...base,
    role: "menu",
    tabindex: "-1",
    "aria-orientation": "vertical",
    // Marks it a list of its own before roving focus does, so a menubar's arrow keys leave its items alone.
    "data-bisque-list": "",
    onKeyDown: keyDown,
  }
}

export component MenuPopup({ side, align = "start", sideOffset = 0, alignOffset = 0, children, ...rest }: MenuPopupProps) {
  c = use menu
  bar = use menubar
  usedSide = latest side ?? (c.isSubmenu || (bar.present && bar.orientation == "vertical") ? "right" : "bottom")
  own = menuPopup(c, bar, usedSide, latest align, latest sideOffset, latest alignOffset)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// What every kind of item shares: it is a roving-focus item, highlights under the pointer, and activates on
// Enter and Space.
fn itemBase(ref disabled: boolean): PartProps {
  source highlighted := false
  action focus() { highlighted := true }
  action blur() { highlighted := false }
  action pointerMove(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (!disabled) { focusElement(event.currentTarget) }
  }
  action keyDown(event: KeyboardEvent & { currentTarget: HTMLElement }) {
    if (event.key == "Enter" || event.key == " ") {
      event.preventDefault()
      clickElement(event.currentTarget)
    }
  }
  {
    tabindex: "-1",
    "data-bisque-item": "",
    "data-highlighted": highlighted ? "" : undefined,
    "data-disabled": disabled ? "" : undefined,
    "aria-disabled": disabled ? "true" : undefined,
    onFocus: focus,
    onBlur: blur,
    onPointerMove: pointerMove,
    onKeyDown: keyDown,
  }
}

export type MenuItemProps = {
  disabled?: boolean
  // Whether choosing the item closes the menu (and every menu it is nested in). Default: true.
  closeOnClick?: boolean
} & DivProps

export fn menuItem(ref c: MenuContext, ref disabled: boolean, ref closeOnClick: boolean): PartProps {
  base = itemBase(disabled)
  // The consumer's `onClick` runs first, in the same instant: when it starts an action (a save), a plain close here
  // would join that action's hold and the menu would stay open until the server answered. Closing is its own change.
  action close() { c.closeTree() }
  action click() {
    if (!disabled && closeOnClick) { onFlush(() => { close() }) }
  }
  { role: "menuitem", ...base, onClick: click }
}

export component MenuItem({ disabled = false, closeOnClick = true, children, ...rest }: MenuItemProps) {
  c = use menu
  own = menuItem(c, latest disabled, latest closeOnClick)
  merged = latest mergeProps(own, withoutHandlers(rest, disabled))
  <div {...merged}>{children}</div>
}

export type MenuLinkItemProps = {
  // Whether following the link closes the menu. Default: false (the page usually changes anyway).
  closeOnClick?: boolean
} & AnchorProps

// A menu item that is a link: Enter follows it.
export fn menuLinkItem(ref c: MenuContext, ref closeOnClick: boolean): PartProps {
  base = itemBase(false)
  // Its own change, as MenuItem's close.
  action close() { c.closeTree() }
  action click() {
    if (closeOnClick) { onFlush(() => { close() }) }
  }
  { role: "menuitem", ...base, onClick: click }
}

export component MenuLinkItem({ closeOnClick = false, children, ...rest }: MenuLinkItemProps) {
  c = use menu
  own = menuLinkItem(c, latest closeOnClick)
  merged = latest mergeProps(own, rest)
  <a {...merged}>{children}</a>
}

export type MenuCheckboxItemProps = {
  checked?: boolean
  defaultChecked?: boolean
  onCheckedChange?: (checked: boolean) => void
  disabled?: boolean
  // Default: false, so several boxes can be ticked without reopening the menu.
  closeOnClick?: boolean
} & DivProps

export component MenuCheckboxItem(props: MenuCheckboxItemProps) {
  c = use menu
  source uncontrolled := peek(props.defaultChecked ?? false)
  isChecked = props.checked ?? uncontrolled
  isDisabled = latest props.disabled ?? false
  base = itemBase(isDisabled)
  // Its own change, as MenuItem's close.
  action close() { c.closeTree() }
  action click() {
    if (isDisabled) { return }
    let next = !isChecked
    uncontrolled := next
    // In a change of its own: a handler that saves (an action) or writes what a loading question reads must not
    // hold the tick, the menu's highlight or its closing.
    if (props.onCheckedChange) {
      let report = props.onCheckedChange
      onFlush(() => { report(next) })
    }
    if (props.closeOnClick ?? false) { onFlush(() => { close() }) }
  }
  { checked, defaultChecked, onCheckedChange, disabled, closeOnClick, children, ...rest } = props
  own = {
    role: "menuitemcheckbox",
    "aria-checked": isChecked ? "true" : "false",
    "data-checked": isChecked ? "" : undefined,
    "data-unchecked": isChecked ? undefined : "",
    ...base,
    onClick: click,
  }
  merged = latest mergeProps(own, withoutHandlers(rest, isDisabled))
  <div {...merged}>{children}</div>
}

export type MenuRadioGroupContext = {
  value: string | undefined
  select: (value: string) => void
}

export context menuRadioGroup: MenuRadioGroupContext

export type MenuRadioGroupProps = {
  value?: string
  defaultValue?: string
  onValueChange?: (value: string) => void
} & DivProps

export component MenuRadioGroup(props: MenuRadioGroupProps) {
  source uncontrolled: string | undefined := peek(props.defaultValue)
  current = props.value ?? uncontrolled
  action select(value: string) {
    uncontrolled := value
    // In a change of its own, as MenuCheckboxItem's handler.
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(value) })
    }
  }
  provide menuRadioGroup = { value: current, select: select }
  { value, defaultValue, onValueChange, children, ...rest } = props
  merged = latest mergeProps({ role: "group" }, rest)
  <div {...merged}>{children}</div>
}

export type MenuRadioItemProps = {
  value: string
  disabled?: boolean
  closeOnClick?: boolean
} & DivProps

export component MenuRadioItem({ value, disabled = false, closeOnClick = false, children, ...rest }: MenuRadioItemProps) {
  c = use menu
  group = use menuRadioGroup
  base = itemBase(latest disabled)
  isChecked = group.value == latest value
  // Its own change, as MenuItem's close.
  action close() { c.closeTree() }
  action click() {
    if (disabled) { return }
    group.select(value)
    if (closeOnClick) { onFlush(() => { close() }) }
  }
  own = {
    role: "menuitemradio",
    "aria-checked": isChecked ? "true" : "false",
    "data-checked": isChecked ? "" : undefined,
    "data-unchecked": isChecked ? undefined : "",
    ...base,
    onClick: click,
  }
  merged = latest mergeProps(own, withoutHandlers(rest, disabled))
  <div {...merged}>{children}</div>
}

export type MenuGroupContext = {
  labelId: string | undefined
  setLabelId: (id: string | undefined) => void
}

export context menuGroup: MenuGroupContext

export component MenuGroup(props: DivProps) {
  source labelId: string | undefined := undefined
  action setLabelId(id: string | undefined) { labelId := id }
  provide menuGroup = { labelId: labelId, setLabelId: setLabelId }
  { children, ...rest } = props
  merged = latest mergeProps({ role: "group", "aria-labelledby": labelId }, rest)
  <div {...merged}>{children}</div>
}

export component MenuGroupLabel({ children, ...rest }: DivProps) {
  group = use menuGroup
  id = createId("menu-group-label")
  // No cleanup: a label removed with its `for` row (items replaced by a new answer) can't call an action from a
  // cleanup (ACTION_CALLED_IN_OWNED_SCOPE), and its group goes with it.
  effect () { group.setLabelId(id) }
  merged = latest mergeProps({ id: id, role: "presentation" }, rest)
  <div {...merged}>{children}</div>
}

export component MenuSeparator(props: DivProps) {
  merged = latest mergeProps({ role: "separator", "aria-orientation": "horizontal" }, props)
  <div {...merged} />
}

// Escape closes only the innermost open menu, as the browser does for nested popovers, and focus returns to the
// submenu's trigger. (Base UI's `closeParentOnEsc` is not offered: the browser decides.)
export type MenuSubmenuRootProps = {
  open?: boolean
  // Default: false.
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // A disabled submenu doesn't open; it is also disabled when its parent menu is. Default: false.
  disabled?: boolean
  children?: View
}

// A menu inside a menu: holds a MenuSubmenuTrigger (an item of the parent) and the submenu's own MenuPopup,
// declared inside the parent's MenuPopup. The parts beneath it read it as `menu`, like a top-level menu.
export component MenuSubmenuRoot(props: MenuSubmenuRootProps) {
  // Read here and passed down: in a component that provides `menu`, `use menu` sees its own provision.
  parent = use menu
  <SubmenuProvider parent={parent} open={props.open} defaultOpen={props.defaultOpen} onOpenChange={props.onOpenChange} disabled={props.disabled}>
    {props.children}
  </SubmenuProvider>
}

component SubmenuProvider(props: MenuSubmenuRootProps & { parent: MenuContext }) {
  parent = props.parent
  source openFocus: MenuOpenFocus := "none"
  // The app's handler in a change of its own, as MenuRoot's.
  action notifyOpen(next: boolean) {
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
  }
  // The browser closes the submenu with its parent (it is nested in it) and reports it through `toggle`.
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), notifyOpen)
  isDisabled = (props.disabled ?? false) || parent.disabled

  action openWith(focus: MenuOpenFocus) {
    if (isDisabled) { return }
    openFocus := focus
    state.setOpen(true)
  }
  action closeTree() {
    state.setOpen(false)
    parent.closeTree()
  }

  _focus = createMenuFocus(state.open, state.popup, openFocus, state.trigger, parent.open)

  provide menu = {
    ...state,
    menuId: state.popupId,
    openFocus: openFocus,
    openWith: openWith,
    disabled: isDisabled,
    closeTree: closeTree,
    isSubmenu: true,
    moveInMenubar: parent.moveInMenubar,
  }

  {props.children}
}

export type MenuSubmenuTriggerProps = {
  disabled?: boolean
  // Whether resting the pointer on the trigger opens the submenu. Default: true.
  openOnHover?: boolean
  // How long the pointer rests on the trigger before the submenu opens, in ms. Default: 100.
  delay?: number
  // How long after the pointer leaves (and not towards the submenu) before it closes, in ms. Default: 0.
  closeDelay?: number
} & ButtonProps

// An item of the parent menu that opens the submenu: on hover (the pointer may cross other items on its way to the
// submenu without closing it), on click, and on ArrowRight, Enter and Space, which also move focus into it.
// Spread it on a <button>: like MenuTrigger, its `popovertarget` keeps a press on it from closing the submenu
// (a press on any other part of the parent menu does close it), and the click itself is prevented.
export fn menuSubmenuTrigger(ref c: MenuContext, ref disabled: boolean, ref openOnHover: boolean, ref delay: number, ref closeDelay: number): PartProps {
  base = itemBase(disabled)
  action hoverChange(next: boolean, reason: "hover" | "focus" | "press" | "group") {
    if (next) { c.openWith("none") } else { c.setOpen(false) }
  }
  _hover = createHoverIntent(openOnHover && !disabled, c.open, c.trigger, c.popup, {
    openDelay: delay,
    closeDelay: closeDelay,
    hoverablePopup: true,
    focus: false,
    focusDelay: 0,
    closeOnPress: false,
    group: undefined,
  }, hoverChange)
  action keyDown(event: KeyboardEvent) {
    if (disabled) { return }
    if (event.key == "ArrowRight" || event.key == "Enter" || event.key == " ") {
      event.preventDefault()
      if (c.open) { focusListItem(c.popup, "first") } else { c.openWith("first-item") }
    } else if (c.open && (event.key == "ArrowDown" || event.key == "ArrowUp" || event.key == "Home" || event.key == "End")) {
      // The highlight moved to another item of the parent menu.
      c.setOpen(false)
    }
  }
  action click(event: MouseEvent) {
    event.preventDefault()
    if (disabled) { return }
    if (!c.open) { c.openWith("none") } else if (!openOnHover) { c.setOpen(false) }
  }
  {
    role: "menuitem",
    type: "button",
    popovertarget: c.popupId,
    ...base,
    "aria-haspopup": "menu",
    "aria-expanded": c.open ? "true" : "false",
    "aria-controls": c.popupId,
    "data-popup-open": c.open ? "" : undefined,
    ref: c.setTrigger,
    onClick: click,
    onKeyDown: keyDown,
  }
}

export component MenuSubmenuTrigger({ disabled = false, openOnHover = true, delay = 100, closeDelay = 0, children, ...rest }: MenuSubmenuTriggerProps) {
  c = use menu
  isDisabled = disabled || c.disabled
  own = menuSubmenuTrigger(c, isDisabled, latest openOnHover, latest delay, latest closeDelay)
  merged = latest mergeProps(own, withoutHandlers(rest, isDisabled))
  <button {...merged}>{children}</button>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn menuArrow(ref c: MenuContext): PartProps {
  base = popoverArrowProps(c)
  base
}

export component MenuArrow({ children, ...rest }: DivProps) {
  c = use menu
  own = menuArrow(c)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
