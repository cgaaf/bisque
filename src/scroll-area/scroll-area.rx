import { mergeProps } from "../internal/props.js"
import { createScrollMetrics, setScrollPosition, capturePointer, releasePointer } from "../internal/scroll-area.js"
import { DivProps, PartProps } from "../internal/types.rx"

// The smallest a thumb gets, in px, however long the content.
MIN_THUMB = 16

export type ScrollAreaOrientation = "vertical" | "horizontal"

export type ScrollAreaContext = {
  // The viewport's real scroll position and sizes (see createScrollMetrics in ../internal/scroll-area.js).
  top: number
  left: number
  maxTop: number
  maxLeft: number
  scrollingX: boolean
  scrollingY: boolean
  hovering: boolean
  hasOverflowX: boolean
  hasOverflowY: boolean
  overflowXStart: boolean
  overflowXEnd: boolean
  overflowYStart: boolean
  overflowYEnd: boolean
  // Scrollbar lengths, and each thumb's size and offset along its scrollbar, in px.
  trackX: number
  trackY: number
  thumbWidth: number
  thumbHeight: number
  thumbX: number
  thumbY: number
  cornerWidth: number
  cornerHeight: number
  viewport: HTMLElement | undefined
  setViewport: (element: HTMLElement) => void
  setScrollbarY: (element: HTMLElement) => void
  setScrollbarX: (element: HTMLElement) => void
}

export context scrollArea: ScrollAreaContext

export type ScrollAreaRootProps = {
  // How far from an edge, in px, the content must be scrolled before `data-overflow-*-start`/`-end` appear.
  // Default: 0.
  overflowEdgeThreshold?: number
  children?: View
} & Omit<DivProps, "children">

fn clamp(value: number, low: number, high: number): number => value < low ? low : value > high ? high : value

// The state attributes every part carries.
fn overflowState(ref c: ScrollAreaContext): PartProps {
  {
    "data-has-overflow-x": c.hasOverflowX ? "" : undefined,
    "data-has-overflow-y": c.hasOverflowY ? "" : undefined,
    "data-overflow-x-start": c.overflowXStart ? "" : undefined,
    "data-overflow-x-end": c.overflowXEnd ? "" : undefined,
    "data-overflow-y-start": c.overflowYStart ? "" : undefined,
    "data-overflow-y-end": c.overflowYEnd ? "" : undefined,
  }
}

export component ScrollAreaRoot(props: ScrollAreaRootProps) {
  source viewport: HTMLElement | undefined := undefined
  source scrollbarY: HTMLElement | undefined := undefined
  source scrollbarX: HTMLElement | undefined := undefined
  source hovering := false
  m = createScrollMetrics(viewport, scrollbarY, scrollbarX)
  threshold = props.overflowEdgeThreshold ?? 0
  maxTop = m.scrollHeight - m.clientHeight
  maxLeft = m.scrollWidth - m.clientWidth
  hasY = maxTop > 0
  hasX = maxLeft > 0
  top = clamp(m.top, 0, hasY ? maxTop : 0)
  left = clamp(m.left, 0, hasX ? maxLeft : 0)
  thumbHeight = hasY ? clamp(m.trackY * m.clientHeight / m.scrollHeight, MIN_THUMB, m.trackY > MIN_THUMB ? m.trackY : MIN_THUMB) : 0
  thumbWidth = hasX ? clamp(m.trackX * m.clientWidth / m.scrollWidth, MIN_THUMB, m.trackX > MIN_THUMB ? m.trackX : MIN_THUMB) : 0
  thumbY = hasY && m.trackY > thumbHeight ? (m.trackY - thumbHeight) * top / maxTop : 0
  thumbX = hasX && m.trackX > thumbWidth ? (m.trackX - thumbWidth) * left / maxLeft : 0

  action hover(event: PointerEvent) {
    if (event.pointerType != "touch") { hovering := true }
  }
  action leave() { hovering := false }
  action setViewport(element: HTMLElement) { viewport := element }
  action setScrollbarY(element: HTMLElement) { scrollbarY := element }
  action setScrollbarX(element: HTMLElement) { scrollbarX := element }

  self = {
    top: top,
    left: left,
    maxTop: hasY ? maxTop : 0,
    maxLeft: hasX ? maxLeft : 0,
    scrollingX: m.scrollingX,
    scrollingY: m.scrollingY,
    hovering: hovering,
    hasOverflowX: hasX,
    hasOverflowY: hasY,
    overflowXStart: hasX && left > threshold,
    overflowXEnd: hasX && maxLeft - left > threshold,
    overflowYStart: hasY && top > threshold,
    overflowYEnd: hasY && maxTop - top > threshold,
    trackX: m.trackX,
    trackY: m.trackY,
    thumbWidth: thumbWidth,
    thumbHeight: thumbHeight,
    thumbX: thumbX,
    thumbY: thumbY,
    cornerWidth: hasX && hasY ? m.thicknessY : 0,
    cornerHeight: hasX && hasY ? m.thicknessX : 0,
    viewport: viewport,
    setViewport: setViewport,
    setScrollbarY: setScrollbarY,
    setScrollbarX: setScrollbarX,
  }
  provide scrollArea = self

  { overflowEdgeThreshold, children, ...rest } = props
  state = overflowState(self)
  own = {
    role: "presentation",
    "data-scrolling": m.scrollingX || m.scrollingY ? "" : undefined,
    style: {
      "--scroll-area-corner-width": `${self.cornerWidth}px`,
      "--scroll-area-corner-height": `${self.cornerHeight}px`,
    },
    onPointerEnter: hover,
    onPointerMove: hover,
    onPointerLeave: leave,
    ...state,
  }
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// The element that scrolls. Its native scrollbars are hidden (`scrollbar-width: none`); it is focusable while it
// overflows, so the keyboard can scroll it. The distance to each edge is a CSS variable:
// `--scroll-area-overflow-x-start`, `-x-end`, `-y-start`, `-y-end`.
export fn scrollAreaViewport(ref c: ScrollAreaContext): PartProps {
  state = overflowState(c)
  {
    role: "presentation",
    tabindex: c.hasOverflowX || c.hasOverflowY ? "0" : "-1",
    "data-scrolling": c.scrollingX || c.scrollingY ? "" : undefined,
    style: {
      overflow: "scroll",
      "scrollbar-width": "none",
      "--scroll-area-overflow-x-start": `${c.left}px`,
      "--scroll-area-overflow-x-end": `${c.maxLeft - c.left}px`,
      "--scroll-area-overflow-y-start": `${c.top}px`,
      "--scroll-area-overflow-y-end": `${c.maxTop - c.top}px`,
    },
    ref: c.setViewport,
    ...state,
  }
}

export component ScrollAreaViewport({ children, ...rest }: DivProps) {
  c = use scrollArea
  own = scrollAreaViewport(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

// Wraps the content inside the viewport, at least as wide as the content (`min-width: fit-content`), so
// horizontal overflow is measured.
export component ScrollAreaContent({ children, ...rest }: DivProps) {
  c = use scrollArea
  state = overflowState(c)
  merged = mergeProps({ role: "presentation", style: { "min-width": "fit-content" }, ...state }, rest)
  <div {...merged}>{children}</div>
}

export type ScrollAreaScrollbarContext = {
  orientation: ScrollAreaOrientation
}

export context scrollAreaScrollbarOptions: ScrollAreaScrollbarContext

export type ScrollAreaScrollbarProps = {
  orientation?: ScrollAreaOrientation
  // Keep the scrollbar in the DOM while there is nothing to scroll on its axis. Default: false.
  keepMounted?: boolean
  children?: View
} & Omit<DivProps, "children">

// Pressing the track scrolls so the thumb centres on the pointer; the wheel over it scrolls the viewport. Its
// thumb's size is `--scroll-area-thumb-height` (vertical) or `--scroll-area-thumb-width` (horizontal).
export fn scrollAreaScrollbar(ref c: ScrollAreaContext, ref orientation: ScrollAreaOrientation): PartProps {
  vertical = orientation == "vertical"
  state = overflowState(c)
  action press(event: PointerEvent & { currentTarget: HTMLElement }) {
    // The thumb prevents the default of its own presses: those are drags, not jumps.
    if (event.button != 0 || event.defaultPrevented) { return }
    let rect = event.currentTarget.getBoundingClientRect()
    let thumb = vertical ? c.thumbHeight : c.thumbWidth
    let room = (vertical ? c.trackY : c.trackX) - thumb
    if (room <= 0) { return }
    let at = (vertical ? event.clientY - rect.top : event.clientX - rect.left) - thumb / 2
    let ratio = clamp(at / room, 0, 1)
    setScrollPosition(c.viewport, vertical ? "y" : "x", ratio * (vertical ? c.maxTop : c.maxLeft))
  }
  action wheel(event: WheelEvent) {
    let delta = vertical ? event.deltaY : event.deltaX
    let position = vertical ? c.top : c.left
    let max = vertical ? c.maxTop : c.maxLeft
    if (event.ctrlKey || delta == 0) { return }
    if ((delta < 0 && position <= 0) || (delta > 0 && position >= max)) { return }
    event.preventDefault()
    setScrollPosition(c.viewport, vertical ? "y" : "x", clamp(position + delta, 0, max))
  }
  {
    "aria-hidden": "true",
    "data-orientation": orientation,
    "data-hovering": c.hovering ? "" : undefined,
    "data-scrolling": (vertical ? c.scrollingY : c.scrollingX) ? "" : undefined,
    style: vertical ? { "--scroll-area-thumb-height": `${c.thumbHeight}px` } : { "--scroll-area-thumb-width": `${c.thumbWidth}px` },
    ref: vertical ? c.setScrollbarY : c.setScrollbarX,
    onPointerDown: press,
    onWheel: wheel,
    ...state,
  }
}

export component ScrollAreaScrollbar(props: ScrollAreaScrollbarProps) {
  c = use scrollArea
  axis = props.orientation ?? "vertical"
  provide scrollAreaScrollbarOptions = { orientation: axis }
  { orientation, keepMounted, children, ...rest } = props
  own = scrollAreaScrollbar(c, axis)
  merged = mergeProps(own, rest)
  {if (keepMounted ?? false) || (axis == "vertical" ? c.hasOverflowY : c.hasOverflowX) {
    <div {...merged}>{children}</div>
  }}
}

// Sized and moved along its scrollbar from the viewport's scroll position; drag it to scroll.
export fn scrollAreaThumb(ref c: ScrollAreaContext, ref orientation: ScrollAreaOrientation): PartProps {
  source pointer := -1
  source startPointer := 0
  source startScroll := 0
  vertical = orientation == "vertical"
  action down(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (event.button != 0) { return }
    event.preventDefault()
    pointer := event.pointerId
    startPointer := vertical ? event.clientY : event.clientX
    startScroll := vertical ? c.top : c.left
    capturePointer(event.currentTarget, event.pointerId)
  }
  action move(event: PointerEvent) {
    if (event.pointerId != pointer) { return }
    let room = vertical ? c.trackY - c.thumbHeight : c.trackX - c.thumbWidth
    if (room <= 0) { return }
    event.preventDefault()
    let delta = (vertical ? event.clientY : event.clientX) - startPointer
    let max = vertical ? c.maxTop : c.maxLeft
    setScrollPosition(c.viewport, vertical ? "y" : "x", clamp(startScroll + delta / room * max, 0, max))
  }
  action up(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (event.pointerId != pointer) { return }
    pointer := -1
    releasePointer(event.currentTarget, event.pointerId)
  }
  {
    "data-orientation": orientation,
    "data-scrolling": (vertical ? c.scrollingY : c.scrollingX) ? "" : undefined,
    style: vertical ? { height: "var(--scroll-area-thumb-height)", transform: `translate3d(0px, ${c.thumbY}px, 0px)` } : { width: "var(--scroll-area-thumb-width)", transform: `translate3d(${c.thumbX}px, 0px, 0px)` },
    onPointerDown: down,
    onPointerMove: move,
    onPointerUp: up,
    onPointerCancel: up,
  }
}

export component ScrollAreaThumb(props: DivProps) {
  c = use scrollArea
  s = use scrollAreaScrollbarOptions
  own = scrollAreaThumb(c, s.orientation)
  merged = mergeProps(own, props)
  <div {...merged} />
}

// Fills the gap where the two scrollbars meet. Rendered only while both are. Sized from the scrollbars'
// thickness, also exposed on the root as `--scroll-area-corner-width` and `--scroll-area-corner-height`.
export component ScrollAreaCorner(props: DivProps) {
  c = use scrollArea
  merged = mergeProps({ style: { width: `${c.cornerWidth}px`, height: `${c.cornerHeight}px` } }, props)
  {if c.hasOverflowX && c.hasOverflowY {
    <div {...merged} />
  }}
}
