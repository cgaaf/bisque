// A disclosure on the native <details> element. The browser holds the open state, toggles it from the <summary>
// (click, Enter, Space), hides the content (`::details-content`) and opens it for find-in-page. This family adds a
// controlled `open`, `disabled`, the panel's measured size and the exit animation. Style it with `[open]`:
// `details[open] > .panel`, and `[data-ending-style]` on the panel while it animates out.
import { mergeProps, createId, createRef } from "../internal/props.js"
import { createDisclosure } from "../internal/disclosure.js"
import { DetailsProps, SummaryProps, DivProps, PartProps } from "../internal/types.rx"

export type CollapsibleContext = {
  open: boolean
  disabled: boolean
  panelId: string
  setOpen: (open: boolean) => void
  setPanel: (element: HTMLElement) => void
}

export context collapsible: CollapsibleContext

export type CollapsibleRootProps = {
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // The trigger does nothing while disabled. Find-in-page still opens it: the browser's behaviour wins.
  disabled?: boolean
  children?: View
} & Omit<DetailsProps, "children" | "open">

export component CollapsibleRoot(props: CollapsibleRootProps) {
  source uncontrolled: boolean := peek(props.defaultOpen ?? false)
  source details: HTMLDetailsElement | undefined := undefined
  source panel: HTMLElement | undefined := undefined
  isOpen = props.open ?? uncontrolled
  isDisabled = props.disabled ?? false
  // Rendered once, so an open disclosure doesn't animate in on mount; the driver keeps it in step after that.
  initiallyOpen = peek(isOpen)
  panelId = createId("collapsible-panel")

  action setOpen(next: boolean) {
    if (next == isOpen) { return }
    uncontrolled := next
    if (props.onOpenChange) { props.onOpenChange(next) }
  }
  action writeDetails(element: HTMLDetailsElement) { details := element }
  setDetails = createRef(writeDetails)
  action writePanel(element: HTMLElement) { panel := element }
  setPanel = createRef(writePanel)

  _details = createDisclosure(details, panel, isOpen, "collapsible-panel", setOpen)

  provide collapsible = {
    open: isOpen,
    disabled: isDisabled,
    panelId: panelId,
    setOpen: setOpen,
    setPanel: setPanel,
  }

  { open, defaultOpen, onOpenChange, disabled, children, ...rest } = props
  own = {
    open: initiallyOpen ? true : undefined,
    "data-disabled": isDisabled ? "" : undefined,
    ref: setDetails,
  }
  merged = mergeProps(own, rest)
  <details {...merged}>{children}</details>
}

// Spread on a <summary> that is the first child of the root's <details>: the toggling, focusability and the
// expanded state come from that element, and it works on no other. A press asks the root instead of toggling, so a
// controlled `open` decides and the close can animate.
export fn collapsibleTrigger(ref c: CollapsibleContext): PartProps {
  action press(event: MouseEvent) {
    event.preventDefault()
    if (c.disabled) { return }
    c.setOpen(!c.open)
  }
  {
    "aria-disabled": c.disabled ? "true" : undefined,
    tabindex: c.disabled ? "-1" : undefined,
    "data-disabled": c.disabled ? "" : undefined,
    onClick: press,
  }
}

export component CollapsibleTrigger({ children, ...rest }: SummaryProps) {
  c = use collapsible
  own = collapsibleTrigger(c)
  merged = mergeProps(own, rest)
  <summary {...merged}>{children}</summary>
}

// The content after the summary. Its size is written to `--collapsible-panel-height` and
// `--collapsible-panel-width`: px while it opens and closes, `auto` once open. Animate `height` from 0 with both
// `details:not([open]) > .panel` and `@starting-style` (Chrome needs the second, Safari the first), and to 0
// under `[data-ending-style]`.
export fn collapsiblePanel(ref c: CollapsibleContext): PartProps {
  { id: c.panelId, ref: c.setPanel }
}

export component CollapsiblePanel({ children, ...rest }: DivProps) {
  c = use collapsible
  own = collapsiblePanel(c)
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
