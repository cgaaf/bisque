import { TimeFieldRoot, TimeFieldInput, TimeFieldSegment, timeField } from "../time-field.rx"
import { FieldRoot, FieldLabel, FieldDescription, FieldError } from "../../field/field.rx"
import { Form } from "../../form/form.rx"
import { parseTime } from "../../internal/date.js"

component Segments() {
  c = use timeField
  {for segment in c.segments {
    <TimeFieldSegment segment={segment} />
  }}
}

export default component Fixture() {
  source submitted := ""
  <div>
  <Form data-testid="form" onFormSubmit={(values) => { submitted := `start=${values.start}` }}>
    <FieldRoot name="start">
      <FieldLabel>Start time</FieldLabel>
      <TimeFieldRoot data-testid="start" locale="en-US" required min={parseTime("08:00")}>
        <TimeFieldInput><Segments /></TimeFieldInput>
      </TimeFieldRoot>
      <FieldDescription data-testid="description">When the shift starts.</FieldDescription>
      <FieldError data-testid="error" />
    </FieldRoot>
    <FieldRoot disabled>
      <FieldLabel>Locked</FieldLabel>
      <TimeFieldRoot data-testid="locked" locale="en-US" defaultValue={parseTime("12:00")}>
        <TimeFieldInput><Segments /></TimeFieldInput>
      </TimeFieldRoot>
    </FieldRoot>
    <button type="submit">Submit</button>
    <output data-testid="submitted">{submitted}</output>
  </Form>
    // An outer composition (a picker) gives the field its invalid state and description itself.
    <p id="outside-hint">Outside hint</p>
    <TimeFieldRoot data-testid="outside" aria-label="Outside" locale="en-US" invalid describedBy="outside-hint">
      <TimeFieldInput><Segments /></TimeFieldInput>
    </TimeFieldRoot>
    // Inside a FieldRoot that is invalid, the outside values win over the Field's.
    <FieldRoot invalid>
      <FieldLabel>Overridden</FieldLabel>
      <TimeFieldRoot data-testid="overridden" locale="en-US" invalid={false} describedBy="outside-hint">
        <TimeFieldInput><Segments /></TimeFieldInput>
      </TimeFieldRoot>
      <FieldDescription>Field's own description.</FieldDescription>
    </FieldRoot>
  </div>
}
