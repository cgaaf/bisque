import { mergeProps } from "../internal/props.js"
import { createCompositeFocus } from "../internal/composite-focus.js"
import { DivProps } from "../internal/types.rx"
import { toolbar, toolbarGroup } from "../toolbar/toolbar.rx"

export type ToggleGroupOrientation = "horizontal" | "vertical"

// `present` is false outside a group: a toggle reads this context with or without one.
export type ToggleGroupContext = {
  present: boolean
  disabled: boolean
  value: string[]
  setPressed: (value: string, pressed: boolean) => void
}

fn ignorePress(value: string, pressed: boolean): void => undefined

export context toggleGroup: ToggleGroupContext = { present: false, disabled: false, value: [], setPressed: ignorePress }

export type ToggleGroupProps = {
  // The values of the pressed toggles.
  value?: string[]
  defaultValue?: string[]
  onValueChange?: (value: string[]) => void
  // Whether several toggles can be pressed at once. Default: false (pressing one releases the other).
  multiple?: boolean
  disabled?: boolean
  orientation?: ToggleGroupOrientation
  // Whether the arrow keys wrap around at the ends. Default: true.
  loopFocus?: boolean
  children?: View
} & Omit<DivProps, "children">

// One Tab stop over its toggles, moved with the arrow keys, Home and End. Inside a toolbar the toolbar owns the
// keyboard instead, and the toggles are its items.
export component ToggleGroup(props: ToggleGroupProps) {
  bar = use toolbar
  barGroup = use toolbarGroup
  source uncontrolled: string[] := peek(props.defaultValue ?? [])
  current = props.value ?? uncontrolled
  isDisabled = bar.disabled || barGroup.disabled || (props.disabled ?? false)
  isMultiple = props.multiple ?? false
  dir = props.orientation ?? "horizontal"
  source element: HTMLElement | undefined := undefined
  action setElement(el: HTMLElement) { element := el }
  _focus = createCompositeFocus(bar.present ? undefined : element, { orientation: dir, loop: props.loopFocus ?? true, homeEnd: true })

  action setPressed(value: string, pressed: boolean) {
    let others = current.filter((v) => v != value)
    let next = pressed ? (isMultiple ? [...others, value] : [value]) : (isMultiple ? others : [])
    uncontrolled := next
    if (props.onValueChange) { props.onValueChange(next) }
  }

  provide toggleGroup = { present: true, disabled: isDisabled, value: current, setPressed: setPressed }

  { value, defaultValue, onValueChange, multiple, disabled, orientation, loopFocus, children, ...rest } = props
  own = {
    role: "group",
    "data-orientation": dir,
    "data-disabled": isDisabled ? "" : undefined,
    "data-multiple": isMultiple ? "" : undefined,
    ref: setElement,
  }
  merged = mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
