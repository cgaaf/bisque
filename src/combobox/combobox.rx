// An input that filters a list of options. Focus stays in the input: the highlighted option is named by
// `aria-activedescendant`, not focused. Autocomplete (../autocomplete) is the same interaction where the input's
// text is the value: both are built on InputListRoot below, and its parts read the `combobox` context.
//
// The popup is a native `popover`, placed against the input (or ComboboxChips) with CSS anchor positioning and at
// least as wide as it. It is `popover="manual"`: the browser's light dismiss counts a press on the input that
// opened it as a press outside (in Chrome, Firefox and Safari alike: the `source` of `showPopover()` is not
// exempt), so this family closes it itself, on Escape, on Tab and on a press outside. There is no Portal or
// Positioner part, and the options stay in the document while it is closed.
import { mergeProps, withoutHandlers, createId, createRef } from "../internal/props.js"
import { capturePointer } from "../internal/scroll-area.js"
import { focusElement } from "../internal/dom.js"
import { adjacentItemId, scrollItemIntoView, itemLabel, clickItem, itemIdByValue, itemValueById, elementText, matchesFilter, createOnShow, createOutsidePress, createItemLabels, createItemObserver, createInputValue } from "../internal/listbox.js"
import { createPopoverState, popoverPopupProps, PopoverState } from "../internal/popover.rx"
import { arrowStyle } from "../internal/native.js"
import { field, fieldControlProps } from "../field/field.rx"
import { DivProps, ButtonProps, SpanProps, InputProps, PartProps } from "../internal/types.rx"

// A value and the text that names it: what the input and ComboboxValue show for a selected value.
export type ComboboxItemLabel = { value: string; label: string }

// How an autocomplete completes what is typed: "list" filters the options; "inline" shows the highlighted
// option's label in the input; "both" does both; "none" neither. A combobox is always "list".
export type AutocompleteMode = "list" | "both" | "inline" | "none"

// From PopoverState: `trigger` is what the popup is anchored to (ComboboxChips when there is one, else the
// input), `popup` the ComboboxPopup element.
export type ComboboxContext = PopoverState & {
  kind: "combobox" | "autocomplete"
  mode: AutocompleteMode
  listId: string
  multiple: boolean
  // The selected values (none for an autocomplete).
  selected: string[]
  labels: ComboboxItemLabel[]
  // What the input shows.
  inputValue: string
  // What the options are filtered by: "" (everything) while the input shows the selection.
  query: string
  filtering: boolean
  filter: ((label: string, query: string) => boolean) | undefined
  // The id of the highlighted option, the input's `aria-activedescendant`.
  activeId: string | undefined
  // How many options are rendered (pass the filter).
  visibleCount: number
  // The app is fetching the options (the `loading` prop).
  loading: boolean
  disabled: boolean
  readOnly: boolean
  required: boolean
  openOnInputClick: boolean
  input: HTMLElement | undefined
  list: HTMLElement | undefined
  setInput: (element: HTMLElement) => void
  setList: (element: HTMLElement) => void
  setChips: (element: HTMLElement) => void
  setButton: (element: HTMLElement) => void
  setClear: (element: HTMLElement) => void
  // The user typed `text`.
  changeInput: (text: string) => void
  // Opens with an option highlighted: the selected one, else the first or last.
  openAt: (direction: "next" | "previous") => void
  move: (direction: "next" | "previous") => void
  highlight: (id: string | undefined) => void
  // Enter in the input: chooses the highlighted option.
  enter: (event: KeyboardEvent) => void
  choose: (value: string, label: string) => void
  remove: (value: string) => void
  removeLast: () => void
  clear: () => void
  // Names a value, for an option the root can't read a label from: the root reads each rendered option's
  // `data-value` and `data-label` itself, and keeps the label after the option is gone, for the selected value.
  registerLabel: (value: string, label: string) => void
}

export context combobox: lane ComboboxContext

// Everything ComboboxRoot and AutocompleteRoot take, for the root both of them render.
export type InputListRootProps = {
  kind: "combobox" | "autocomplete"
  mode?: AutocompleteMode
  value?: string | null
  defaultValue?: string | null
  onValueChange?: (value: string | null) => void
  multiple?: boolean
  values?: string[]
  defaultValues?: string[]
  onValuesChange?: (values: string[]) => void
  inputValue?: string
  defaultInputValue?: string
  onInputValueChange?: (value: string) => void
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  filter?: (label: string, query: string) => boolean
  autoHighlight?: boolean
  loop?: boolean
  openOnInputClick?: boolean
  disabled?: boolean
  readOnly?: boolean
  required?: boolean
  name?: string
  items?: ComboboxItemLabel[]
  loading?: boolean
  children?: View
}

fn labelFor(labels: ComboboxItemLabel[], value: string): string => labels.find((entry) => entry.value == value)?.label ?? value

// The root ComboboxRoot and AutocompleteRoot render. Not meant to be used directly.
export component InputListRoot(props: InputListRootProps) {
  f = use field
  source single: string | null := peek(props.defaultValue ?? null)
  source many: string[] := peek([...(props.defaultValues ?? [])])
  // What the user typed; undefined while a single combobox's input shows its selection.
  source typed: string | undefined := peek(props.defaultInputValue)
  // Inline completion: the highlighted option's label, shown in the input until the user types again.
  source preview: string | undefined := undefined
  // What was typed into a controlled input, shown until `inputValue` has caught up with it.
  source echo: string | undefined := undefined
  source activeId: string | undefined := undefined
  // The highlighted option's value: the highlight stays on it when its option is replaced (new options from a server).
  source activeValue: string | undefined := undefined
  // Whether the highlight was put on the first option by `autoHighlight`, not by the user.
  source autoHighlighted: boolean := false
  source visibleCount := 0
  source input: HTMLElement | undefined := undefined
  source list: HTMLElement | undefined := undefined
  source chips: HTMLElement | undefined := undefined
  source button: HTMLElement | undefined := undefined
  source clearButton: HTMLElement | undefined := undefined

  // The app's handlers are called in a change of their own (`onFlush`), never in the change that updates this
  // component: a handler that writes something a loading question reads (`query := text` with
  // `results = await search(query)`) holds its change until the answer lands, and the input, the popup and the
  // highlight would be held with it.
  action notifyOpen(next: boolean) {
    if (props.onOpenChange) {
      let report = props.onOpenChange
      onFlush(() => { report(next) })
    }
  }
  action notifyValue(next: string | null) {
    if (props.onValueChange) {
      let report = props.onValueChange
      onFlush(() => { report(next) })
    }
  }
  action notifyValues(next: string[]) {
    if (props.onValuesChange) {
      let report = props.onValuesChange
      onFlush(() => { report(next) })
    }
  }
  // Every open or close, whoever made it: the highlight and inline preview start over.
  action opened(next: boolean) {
    activeId := undefined
    activeValue := undefined
    preview := undefined
    notifyOpen(next)
  }
  state = createPopoverState(props.open, peek(props.defaultOpen ?? false), opened)

  isAutocomplete = props.kind == "autocomplete"
  mode = isAutocomplete ? props.mode ?? "list" : "list"
  isMultiple = !isAutocomplete && (props.multiple ?? false)
  currentSingle = props.value != undefined ? props.value : single
  selected = isAutocomplete ? [] : isMultiple ? props.values ?? many : currentSingle == null ? [] : [currentSingle]
  // `items` and `loading` are often read from an answer that can fail (`items={results}`): a failure there is the
  // app's to show, in its `errored` region around the list, not a reason for the root to fail.
  givenLabels = (props.items ?? []) catch (e) => []
  isLoading = (props.loading ?? false) catch (e) => false
  labels = [...givenLabels, ...registered]
  selectedLabel = !isAutocomplete && !isMultiple && currentSingle != null ? labelFor(labels, currentSingle) : ""
  shownText = echo ?? props.inputValue ?? typed ?? selectedLabel
  inputValue = preview ?? shownText
  filtering = mode == "list" || mode == "both"
  showsSelection = !isAutocomplete && !isMultiple && currentSingle != null && shownText == selectedLabel
  query = filtering && !showsSelection ? shownText : ""
  isOpen = state.open
  isDisabled = (props.disabled ?? false) || (f?.disabled ?? false)
  isReadOnly = props.readOnly ?? false
  isRequired = props.required ?? false
  loop = latest props.loop ?? true
  listId = createId("combobox-list")
  hiddenName = isAutocomplete ? undefined : latest props.name ?? f?.name
  // Where the options are found: the popup, which stays while an app's `errored` or `loading` region replaces the
  // list inside it; the list itself when there is no popup.
  host = state.popup ?? list
  // What names each value, read from the options in `host` and kept after an option is gone.
  [registered, registerLabel] = createItemLabels(host)

  action endEcho(text: string) {
    // Tested through a local: narrowing `echo` itself would type the write below as `string` (rx-tsc).
    let shown = echo
    if (shown == text) { echo := undefined }
  }
  action reportInput(text: string) {
    if (props.onInputValueChange && text != shownText) {
      let report = props.onInputValueChange
      // A controlled input goes on showing the text until the app's change for it has landed, whatever the app wrote
      // (the text, something else, nothing): the app is told a change later, and its write may wait for a question
      // that reads it. `echo` is cleared once that change settles, never in it: a write there would join its hold,
      // and the next keystroke's `echo` with it. A newer keystroke's `echo` is left for its own change to clear.
      if (props.inputValue != undefined) { echo := text }
      onFlush(() => {
        report(text)
        onSettled(() => { endEcho(text) })
      })
    }
  }
  // Opens or closes, leaving the input's text alone.
  action writeOpen(next: boolean) { state.setOpen(next) }
  // Closing without choosing puts a single combobox's selection back in the input.
  action setOpen(next: boolean) {
    if (next && (isDisabled || isReadOnly)) { return }
    // Tested through a local: narrowing `typed` itself would type the write below as `string` (rx-tsc).
    let editing = typed != undefined
    if (!next && !isAutocomplete && !isMultiple && editing) {
      typed := undefined
      reportInput(selectedLabel)
    }
    writeOpen(next)
  }
  action dismiss() { setOpen(false) }
  // The popup is anchored to the chips container when there is one, else to the input.
  action writeInput(element: HTMLElement) {
    input := element
    if (chips == undefined) { state.setTrigger(element) }
  }
  action writeChips(element: HTMLElement) {
    chips := element
    state.setTrigger(element)
  }
  action writeList(element: HTMLElement) { list := element }
  action writeButton(element: HTMLElement) { button := element }
  action writeClear(element: HTMLElement) { clearButton := element }
  setInput = createRef(writeInput)
  setChips = createRef(writeChips)
  setList = createRef(writeList)
  setButton = createRef(writeButton)
  setClear = createRef(writeClear)

  action changeInput(text: string) {
    if (isDisabled || isReadOnly) { return }
    preview := undefined
    typed := text
    activeId := undefined
    activeValue := undefined
    reportInput(text)
    // Emptying a single combobox's input clears its selection, as in Base UI.
    if (text == "" && !isAutocomplete && !isMultiple && currentSingle != null) {
      single := null
      notifyValue(null)
    }
    writeOpen(true)
  }
  // Highlights an option. Inline completion (modes "inline" and "both") follows the keyboard, not the pointer.
  action activate(id: string | undefined, inline: boolean) {
    activeId := id
    activeValue := itemValueById(host, id)
    autoHighlighted := false
    scrollItemIntoView(host, id)
    preview := inline && (mode == "inline" || mode == "both") && id != undefined ? itemLabel(host, id) : undefined
  }
  action highlight(id: string | undefined) { activate(id, false) }
  action move(direction: "next" | "previous") {
    activate(adjacentItemId(host, activeId, direction, loop), true)
  }
  action openAt(direction: "next" | "previous") {
    if (isDisabled || isReadOnly) { return }
    let current = itemIdByValue(host, selected.length > 0 ? selected[0] : undefined)
    writeOpen(true)
    activate(current ?? adjacentItemId(host, undefined, direction, loop), true)
  }
  action enter(event: KeyboardEvent) {
    if (!isOpen) { return }
    if (activeId != undefined) {
      event.preventDefault()
      clickItem(host, activeId)
    } else if (isAutocomplete) {
      writeOpen(false)
    }
  }
  action choose(value: string, label: string) {
    if (isDisabled || isReadOnly) { return }
    preview := undefined
    if (isAutocomplete) {
      typed := label
      reportInput(label)
      writeOpen(false)
    } else if (isMultiple) {
      let next = selected.includes(value) ? selected.filter((other) => other != value) : [...selected, value]
      many := next
      notifyValues(next)
      typed := ""
      reportInput("")
    } else {
      if (currentSingle != value) {
        single := value
        notifyValue(value)
      }
      typed := undefined
      reportInput(label)
      writeOpen(false)
    }
  }
  action remove(value: string) {
    if (isDisabled || isReadOnly || !selected.includes(value)) { return }
    let next = selected.filter((other) => other != value)
    many := next
    notifyValues(next)
  }
  action removeLast() {
    if (selected.length > 0) { remove(selected[selected.length - 1]) }
  }
  action clear() {
    if (isDisabled || isReadOnly) { return }
    preview := undefined
    activeId := undefined
    activeValue := undefined
    if (isMultiple && selected.length > 0) {
      many := []
      notifyValues([])
    } else if (!isAutocomplete && !isMultiple && currentSingle != null) {
      single := null
      notifyValue(null)
    }
    typed := isAutocomplete || isMultiple ? "" : undefined
    reportInput("")
    focusElement(input)
  }
  action highlightFirst() {
    highlight(adjacentItemId(host, undefined, "next", false))
    autoHighlighted := true
  }
  // The options changed: a filter, or new options from a server. The highlighted option may be gone (or, as a guard,
  // its element may now carry another value), so the highlight moves to the option with its value, or, when it was
  // `autoHighlight`'s, to the new first option. Without either it goes: `aria-activedescendant` never
  // names an option that isn't there, and Enter never chooses an option the user didn't highlight.
  action itemsChanged(count: number) {
    visibleCount := count
    let first = (props.autoHighlight ?? false) && isOpen && query != "" ? adjacentItemId(host, undefined, "next", false) : undefined
    // Tested through a local: narrowing `activeId` itself would type the write below as `string` (rx-tsc).
    let current = activeId
    if (autoHighlighted || (current == undefined && first != undefined)) {
      activeId := first
      activeValue := itemValueById(host, first)
      autoHighlighted := first != undefined
    } else if (current != undefined && itemValueById(host, current) != activeValue) {
      let again = itemIdByValue(host, activeValue)
      activeId := again
      if (again == undefined) { activeValue := undefined }
    }
  }
  action setHiddenInput(element: HTMLInputElement) { if (f) { f.setInput(element) } }
  // A highlight set while the popup was hidden (ArrowDown on the closed input) is scrolled to once it shows.
  action shown() { scrollItemIntoView(host, activeId) }

  _outside = createOutsidePress(isOpen, [state.popup, input, chips, button, clearButton], dismiss)
  _scroll = createOnShow(state.popup, shown)
  // The options are counted from the DOM: an option that doesn't match isn't rendered.
  _items = createItemObserver(host, itemsChanged)
  // The input's text is written by this, not by a `value` prop: see createInputValue.
  _text = createInputValue(input, inputValue)

  // `autoHighlight`: once the options have been filtered for new input, the first one is highlighted.
  effect (query) { if ((props.autoHighlight ?? false) && peek(isOpen) && $0 != "") { highlightFirst() } }
  effect (selected, inputValue) {
    if (f) { f.setValue(isAutocomplete ? $1 : isMultiple ? $0 : $0.length > 0 ? $0[0] : null) }
  }

  provide combobox = {
    ...state,
    setOpen: setOpen,
    kind: props.kind,
    mode: mode,
    listId: listId,
    multiple: isMultiple,
    selected: selected,
    labels: labels,
    inputValue: inputValue,
    query: query,
    filtering: filtering,
    filter: props.filter,
    activeId: activeId,
    visibleCount: visibleCount,
    loading: isLoading,
    disabled: isDisabled,
    readOnly: isReadOnly,
    required: isRequired,
    openOnInputClick: props.openOnInputClick ?? true,
    input: input,
    list: list,
    setInput: setInput,
    setList: setList,
    setChips: setChips,
    setButton: setButton,
    setClear: setClear,
    changeInput: changeInput,
    openAt: openAt,
    move: move,
    highlight: highlight,
    enter: enter,
    choose: choose,
    remove: remove,
    removeLast: removeLast,
    clear: clear,
    registerLabel: registerLabel,
  }

  {props.children}
  {if hiddenName != undefined || (f != undefined && !isAutocomplete) {
    <input hidden aria-hidden="true" tabindex="-1" name={isMultiple ? undefined : hiddenName} value={selected.join(",")} required={isRequired} disabled={isDisabled} ref={setHiddenInput} />
  }}
  {if isMultiple && hiddenName != undefined {
    {for entry in selected {
      <input type="hidden" name={hiddenName} value={entry} disabled={isDisabled} />
    }}
  }}
}

export type ComboboxRootProps = {
  // Single selection: the selected value, null for none.
  value?: string | null
  defaultValue?: string | null
  onValueChange?: (value: string | null) => void
  // Any number of values may be selected; they are then `values`, `defaultValues` and `onValuesChange`.
  multiple?: boolean
  values?: string[]
  defaultValues?: string[]
  onValuesChange?: (values: string[]) => void
  // The input's text. By default it shows the selected option's label (single) or what was typed (multiple).
  inputValue?: string
  defaultInputValue?: string
  onInputValueChange?: (value: string) => void
  open?: boolean
  defaultOpen?: boolean
  onOpenChange?: (open: boolean) => void
  // Whether an option labelled `label` matches what was typed. Default: case- and accent-insensitive "contains".
  filter?: (label: string, query: string) => boolean
  // Highlight the first matching option as the user types. Default: false.
  autoHighlight?: boolean
  // Whether the arrow keys go from the last option back to the input, and on to the first. Default: true.
  loop?: boolean
  // Whether a click in the input opens the list. Default: true.
  openOnInputClick?: boolean
  disabled?: boolean
  readOnly?: boolean
  required?: boolean
  // With a name (or inside a named FieldRoot) the selected value is submitted with a <form>; with `multiple`,
  // one entry per value.
  name?: string
  // The label of each value, when it must be known before the option has rendered.
  items?: ComboboxItemLabel[]
  // Whether the options are being fetched (`pending? results` for `results = await search(query)`): ComboboxEmpty
  // stays empty, the list is `aria-busy`, and the popup and list carry `data-loading`.
  loading?: boolean
  children?: View
}

export component ComboboxRoot(props: ComboboxRootProps) {
  <InputListRoot kind="combobox" value={props.value} defaultValue={props.defaultValue} onValueChange={props.onValueChange} multiple={props.multiple} values={props.values} defaultValues={props.defaultValues} onValuesChange={props.onValuesChange} inputValue={props.inputValue} defaultInputValue={props.defaultInputValue} onInputValueChange={props.onInputValueChange} open={props.open} defaultOpen={props.defaultOpen} onOpenChange={props.onOpenChange} filter={props.filter} autoHighlight={props.autoHighlight} loop={props.loop} openOnInputClick={props.openOnInputClick} disabled={props.disabled} readOnly={props.readOnly} required={props.required} name={props.name} items={props.items} loading={props.loading}>
    {props.children}
  </InputListRoot>
}

// The state attributes the input, trigger, clear button and value share.
//
// The parts read each field of the context through an equation of its own. The context is one object, rebuilt
// whenever any field changes (the highlight, every keystroke): a props object built straight from it would be
// rebuilt each time with the same content, and everything spread from it would run again
// (`UNSTABLE_MEMO_OUTPUT`). An equation of one field stops the change when that field didn't.
fn comboboxState(ref c: ComboboxContext): PartProps {
  open = c.open
  disabled = c.disabled
  readOnly = c.readOnly
  required = c.required
  {
    "data-popup-open": open ? "" : undefined,
    "data-disabled": disabled ? "" : undefined,
    "data-readonly": readOnly ? "" : undefined,
    "data-required": required ? "" : undefined,
  }
}

// Spread on an <input>. There is no `value` among these props: the root writes the input's text itself, to the
// element the `ref` registers, and only when the text changes (createInputValue in ../internal/impl/listbox.ts).
export fn comboboxInput(ref c: ComboboxContext): PartProps {
  action input(event: InputEvent & { currentTarget: HTMLInputElement }) { c.changeInput(event.currentTarget.value) }
  action click() { if (c.openOnInputClick && !c.open) { c.setOpen(true) } }
  action keyDown(event: KeyboardEvent & { currentTarget: HTMLInputElement }) {
    if (event.key == "ArrowDown" || event.key == "ArrowUp") {
      event.preventDefault()
      let direction: "next" | "previous" = event.key == "ArrowDown" ? "next" : "previous"
      if (c.open) { c.move(direction) } else { c.openAt(direction) }
    } else if (event.key == "Enter") {
      c.enter(event)
    } else if (event.key == "Escape") {
      if (c.open) {
        event.preventDefault()
        c.setOpen(false)
      }
    } else if (event.key == "Tab") {
      if (c.open) { c.setOpen(false) }
    } else if (event.key == "Backspace" && c.multiple && event.currentTarget.value == "") {
      c.removeLast()
    }
  }
  state = comboboxState(c)
  mode = c.mode
  open = c.open
  listId = c.listId
  activeId = c.activeId
  readOnly = c.readOnly
  disabled = c.disabled
  setInput = c.setInput
  {
    type: "text",
    role: "combobox",
    autocomplete: "off",
    "aria-autocomplete": mode,
    "aria-expanded": open ? "true" : "false",
    "aria-haspopup": "listbox",
    "aria-controls": listId,
    "aria-activedescendant": open ? activeId : undefined,
    "aria-readonly": readOnly ? "true" : undefined,
    disabled: disabled ? true : undefined,
    readonly: readOnly ? true : undefined,
    ref: setInput,
    onInput: input,
    onClick: click,
    onKeyDown: keyDown,
    ...state,
  }
}

export component ComboboxInput(props: InputProps) {
  c = use combobox
  f = use field
  inField = fieldControlProps(f)
  own = comboboxInput(c)
  // An autocomplete's input is its value: it carries the name and the constraints the field validates.
  action setFieldInput(element: HTMLInputElement) { if (f && c.kind == "autocomplete") { f.setInput(element) } }
  isAutocomplete = c.kind == "autocomplete"
  fieldName = f?.name
  required = c.required
  forAutocomplete = isAutocomplete ? { name: fieldName, required: required ? true : undefined, ref: setFieldInput } : {}
  withField = mergeProps(mergeProps(inField, own), forAutocomplete)
  merged = latest mergeProps(withField, props)
  <input {...merged} />
}

// A <button> beside the input that toggles the list. Not a `popovertarget` button: that would make it the
// popup's anchor, and the popup belongs under the input.
export fn comboboxTrigger(ref c: ComboboxContext): PartProps {
  source openingPointer := -1
  source openedOnDown := false

  action down(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (!event.isPrimary || event.button != 0) { return }
    openedOnDown := false
    if (event.pointerType != "mouse" || event.ctrlKey || c.open || c.disabled || c.readOnly) { return }
    // Capture the opening gesture so a release over an option cannot choose it.
    capturePointer(event.currentTarget, event.pointerId)
    openingPointer := event.pointerId
    openedOnDown := true
    c.setOpen(true)
    focusElement(c.input)
  }
  action up(event: PointerEvent & { currentTarget: HTMLElement }) {
    if (event.pointerId != openingPointer) { return }
    openingPointer := -1
    let box = event.currentTarget.getBoundingClientRect()
    if (event.clientX < box.left || event.clientX >= box.right || event.clientY < box.top || event.clientY >= box.bottom) {
      c.setOpen(false)
    }
  }
  action cancel(event: PointerEvent) {
    if (event.pointerId != openingPointer) { return }
    openingPointer := -1
    c.setOpen(false)
  }
  action press(event: MouseEvent) {
    // A virtual click (keyboard, assistive technology or .click()) has no preceding press.
    let handled = openedOnDown
    if (handled && event.detail > 0) { openedOnDown := false; return }
    if (event.button != 0 || event.ctrlKey) { return }
    c.setOpen(!c.open)
    focusElement(c.input)
  }
  action mouseDown(event: MouseEvent) { event.preventDefault() }
  state = comboboxState(c)
  open = c.open
  listId = c.listId
  disabled = c.disabled
  setButton = c.setButton
  {
    type: "button",
    tabindex: "-1",
    "aria-haspopup": "listbox",
    "aria-expanded": open ? "true" : "false",
    "aria-controls": listId,
    disabled: disabled ? true : undefined,
    ref: setButton,
    onPointerDown: down,
    onPointerUp: up,
    onPointerCancel: cancel,
    onLostPointerCapture: cancel,
    onMouseDown: mouseDown,
    onClick: press,
    ...state,
  }
}

export component ComboboxTrigger({ children, ...rest }: ButtonProps) {
  c = use combobox
  own = comboboxTrigger(c)
  merged = latest mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

export fn comboboxClear(ref c: ComboboxContext): PartProps {
  action mouseDown(event: MouseEvent) { event.preventDefault() }
  action press() { c.clear() }
  state = comboboxState(c)
  disabled = c.disabled
  setClear = c.setClear
  {
    type: "button",
    tabindex: "-1",
    disabled: disabled ? true : undefined,
    ref: setClear,
    onMouseDown: mouseDown,
    onClick: press,
    ...state,
  }
}

// Clears the selection and the input. Rendered only while there is something to clear, unless `keepMounted`.
export component ComboboxClear({ keepMounted = false, children, ...rest }: { keepMounted?: boolean } & ButtonProps) {
  c = use combobox
  own = comboboxClear(c)
  merged = latest mergeProps(own, rest)
  shown = latest keepMounted || c.selected.length > 0 || c.inputValue != ""
  {if shown {
    <button {...merged}>{children}</button>
  }}
}

export type ComboboxValueProps = {
  // Shown while nothing is selected (the value then carries `data-placeholder`).
  placeholder?: string
} & SpanProps

// The selected option's label (labels joined by ", " when `multiple`); an autocomplete's input text.
export component ComboboxValue({ placeholder, children, ...rest }: ComboboxValueProps) {
  c = use combobox
  text = c.kind == "autocomplete" ? c.inputValue : c.selected.map((value) => labelFor(c.labels, value)).join(", ")
  isEmpty = text == ""
  state = comboboxState(c)
  merged = latest mergeProps({ "data-placeholder": isEmpty ? "" : undefined, ...state }, rest)
  <span {...merged}>{isEmpty ? placeholder ?? "" : text}</span>
}

export type ComboboxPopupProps = {
  // Which side of the input it sits on; the browser flips it when it doesn't fit. Default: "bottom".
  side?: "top" | "bottom" | "left" | "right"
  // Which edge of the input it lines up with. Default: "start".
  align?: "start" | "center" | "end"
  // Gap between input and popup, in pixels. Default: 0.
  sideOffset?: number
  alignOffset?: number
} & DivProps

// The popup: a `popover="manual"` element anchored to the input (or ComboboxChips) and at least as wide as it
// (`min-width: anchor-size(width)`). Style it with `:popover-open` and `@starting-style`. A press inside it keeps
// focus in the input.
export fn comboboxPopup(ref c: ComboboxContext, ref side: "top" | "bottom" | "left" | "right", ref align: "start" | "center" | "end", ref sideOffset: number, ref alignOffset: number): PartProps {
  base = popoverPopupProps(c, "manual", side, align, sideOffset, alignOffset)
  empty = c.visibleCount == 0
  isLoading = c.loading
  action mouseDown(event: MouseEvent) { event.preventDefault() }
  {
    ...base,
    style: { ...base.style, "min-width": "anchor-size(width)" },
    "data-empty": empty ? "" : undefined,
    "data-loading": isLoading ? "" : undefined,
    onMouseDown: mouseDown,
  }
}

export component ComboboxPopup({ side = "bottom", align = "start", sideOffset = 0, alignOffset = 0, children, ...rest }: ComboboxPopupProps) {
  c = use combobox
  own = comboboxPopup(c, latest side, latest align, latest sideOffset, latest alignOffset)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export fn comboboxList(ref c: ComboboxContext): PartProps {
  listId = c.listId
  multiple = c.multiple
  isLoading = c.loading
  empty = c.visibleCount == 0
  setList = c.setList
  {
    id: listId,
    role: "listbox",
    "aria-multiselectable": multiple ? "true" : undefined,
    "aria-busy": isLoading ? "true" : undefined,
    "data-empty": empty ? "" : undefined,
    "data-loading": isLoading ? "" : undefined,
    ref: setList,
  }
}

export component ComboboxList({ children, ...rest }: DivProps) {
  c = use combobox
  own = comboboxList(c)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}

export type ComboboxGroupContext = {
  labelId: string | undefined
  setLabelId: (id: string | undefined) => void
}

export context comboboxGroup: ComboboxGroupContext | undefined = undefined

export type ComboboxItemContext = {
  selected: boolean
  highlighted: boolean
  disabled: boolean
}

export context comboboxItemState: lane ComboboxItemContext

export type ComboboxItemProps = {
  value: string
  // The text the filter matches and the input shows once chosen. Default: the option's text.
  label?: string
  disabled?: boolean
} & DivProps

export fn comboboxItem(ref c: ComboboxContext, ref id: string, ref value: string, ref label: string, ref disabled: boolean): PartProps {
  isSelected = c.selected.includes(value)
  highlighted = c.activeId == id
  isAutocomplete = c.kind == "autocomplete"
  action click() { if (!disabled) { c.choose(value, label) } }
  action mouseDown(event: MouseEvent) { event.preventDefault() }
  action pointerMove() { if (!disabled && c.activeId != id) { c.highlight(id) } }
  {
    id: id,
    role: "option",
    "aria-selected": isAutocomplete ? undefined : isSelected ? "true" : "false",
    "aria-disabled": disabled ? "true" : undefined,
    "data-bisque-item": "",
    "data-value": value,
    "data-label": label,
    "data-selected": isSelected ? "" : undefined,
    "data-highlighted": highlighted ? "" : undefined,
    "data-disabled": disabled ? "" : undefined,
    onClick: click,
    onMouseDown: mouseDown,
    onPointerMove: pointerMove,
  }
}

// An option. It hides itself (it isn't rendered) while it doesn't match what was typed.
export component ComboboxItem(props: ComboboxItemProps) {
  c = use combobox
  source element: HTMLElement | undefined := undefined
  source text: string | undefined := undefined
  id = createId("combobox-item")
  isDisabled = props.disabled ?? false
  label = latest props.label ?? (text != undefined && text != "" ? text : latest props.value)
  // Booleans read straight from the context: they re-run on each of its changes, and stop there when unchanged.
  visible = !c.filtering || matchesFilter(c.filter, label, c.query)
  isSelected = c.selected.includes(props.value)
  highlighted = c.activeId == id
  action setElement(el: HTMLElement) { element := el }
  action setText(next: string) { text := next }

  // The root reads the label from the option's `data-label` (createItemLabels): it isn't registered from here.
  effect (element) { if ($0) { setText(elementText($0)) } }

  provide comboboxItemState = { selected: isSelected, highlighted: highlighted, disabled: isDisabled }

  { value, label: _label, disabled, children, ...rest } = props
  own = comboboxItem(c, id, latest value, label, isDisabled)
  withRef = mergeProps(own, { ref: setElement })
  merged = latest mergeProps(withRef, withoutHandlers(rest, isDisabled))
  {if visible {
    <div {...merged}>{children}</div>
  }}
}

// Shown while its option is selected, unless `keepMounted`.
export component ComboboxItemIndicator({ keepMounted = false, children, ...rest }: { keepMounted?: boolean } & SpanProps) {
  item = use comboboxItemState
  merged = latest mergeProps({ "aria-hidden": "true", "data-selected": item.selected ? "" : undefined }, rest)
  {if item.selected || keepMounted {
    <span {...merged}>{children}</span>
  }}
}

// Groups options under a label. Hidden while none of its options match.
export component ComboboxGroup(props: DivProps) {
  source labelId: string | undefined := undefined
  source element: HTMLElement | undefined := undefined
  source count := 0
  action setLabelId(id: string | undefined) { labelId := id }
  action writeElement(el: HTMLElement) { element := el }
  action setCount(n: number) { count := n }
  setElement = createRef(writeElement)
  _items = createItemObserver(element, setCount)
  provide comboboxGroup = { labelId: labelId, setLabelId: setLabelId }
  { children, ...rest } = props
  merged = latest mergeProps({ role: "group", "aria-labelledby": labelId, hidden: count == 0 ? true : undefined, ref: setElement }, rest)
  <div {...merged}>{children}</div>
}

export component ComboboxGroupLabel({ children, ...rest }: DivProps) {
  group = use comboboxGroup
  id = createId("combobox-group-label")
  // No cleanup: a label removed with a `for` row can't call an action from a cleanup, and its group goes with it.
  effect () { if (group) { group.setLabelId(id) } }
  merged = latest mergeProps({ id: id }, rest)
  <div {...merged}>{children}</div>
}

// Its children show while no option matches, except while the options are `loading`: "no results" isn't shown
// for an answer that hasn't come. The element stays, so screen readers announce the change.
export component ComboboxEmpty({ children, ...rest }: DivProps) {
  c = use combobox
  merged = latest mergeProps({ role: "status", "aria-live": "polite", "aria-atomic": "true" }, rest)
  <div {...merged}>
    {if c.visibleCount == 0 && !c.loading {
      {children}
    }}
  </div>
}

// A polite live region for a message about the list ("3 results", "Loading…").
export component ComboboxStatus({ children, ...rest }: DivProps) {
  merged = latest mergeProps({ role: "status", "aria-live": "polite", "aria-atomic": "true" }, rest)
  <div {...merged}>{children}</div>
}

export component ComboboxSeparator(props: DivProps) {
  merged = latest mergeProps({ role: "separator", "aria-orientation": "horizontal" }, props)
  <div {...merged} />
}

// Multiple selection: the container of the chips and the input. The popup is positioned against it.
export component ComboboxChips({ children, ...rest }: DivProps) {
  c = use combobox
  action setChips(element: HTMLElement) { c.setChips(element) }
  merged = latest mergeProps({ ref: setChips }, rest)
  <div {...merged}>{children}</div>
}

export type ComboboxChipContext = { value: string }

export context comboboxChip: ComboboxChipContext

// One selected value. Render one per value from the `combobox` context's `selected` (or your own `values`).
export component ComboboxChip(props: { value: string } & DivProps) {
  c = use combobox
  provide comboboxChip = { value: props.value }
  { value, children, ...rest } = props
  disabled = c.disabled
  readOnly = c.readOnly
  merged = latest mergeProps({ "data-disabled": disabled ? "" : undefined, "data-readonly": readOnly ? "" : undefined }, rest)
  <div {...merged}>{children}</div>
}

export fn comboboxChipRemove(ref c: ComboboxContext, ref value: string): PartProps {
  action mouseDown(event: MouseEvent) { event.preventDefault() }
  action press() { c.remove(value) }
  inert = c.disabled || c.readOnly
  {
    type: "button",
    tabindex: "-1",
    disabled: inert ? true : undefined,
    onMouseDown: mouseDown,
    onClick: press,
  }
}

// Removes its chip's value from the selection.
export component ComboboxChipRemove({ children, ...rest }: ButtonProps) {
  c = use combobox
  chip = use comboboxChip
  own = comboboxChipRemove(c, chip.value)
  merged = latest mergeProps(own, rest)
  <button {...merged}>{children}</button>
}

// Spread on an element inside the popup: it is placed on the popup's edge that faces the trigger, centred on the
// trigger, and carries the popup's `data-side`. The shape (a rotated square, an SVG) is the stylesheet's.
export fn comboboxArrow(ref c: ComboboxContext): PartProps {
  // As popoverArrowProps, from the placement alone: given the whole context, that would be rebuilt on every change.
  placement = c.placement
  { "aria-hidden": "true", "data-side": placement?.side, style: arrowStyle(placement) }
}

export component ComboboxArrow({ children, ...rest }: DivProps) {
  c = use combobox
  own = comboboxArrow(c)
  merged = latest mergeProps(own, rest)
  <div {...merged}>{children}</div>
}
