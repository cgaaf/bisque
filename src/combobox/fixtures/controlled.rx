import { ComboboxRoot, ComboboxInput, ComboboxTrigger, ComboboxPortal, ComboboxPositioner, ComboboxPopup, ComboboxList, ComboboxItem } from "../combobox.rx"

fn startsWith(label: string, query: string): boolean => label.toLowerCase().startsWith(query.toLowerCase())

export default component Fixture() {
  source value: string | null := "pear"
  source text := "Pear"
  source open: boolean := false
  <main>
    <ComboboxRoot value={value} onValueChange={(next) => { value := next }} inputValue={text} onInputValueChange={(next) => { text := next }} open={open} onOpenChange={(next) => { open := next }} filter={startsWith} autoHighlight items={[{ value: "pear", label: "Pear" }]}>
      <ComboboxInput aria-label="Fruit" />
      <ComboboxTrigger aria-label="Toggle">▾</ComboboxTrigger>
      <ComboboxPortal>
        <ComboboxPositioner>
          <ComboboxPopup>
            <ComboboxList>
              <ComboboxItem value="apple">Apple</ComboboxItem>
              <ComboboxItem value="pear">Pear</ComboboxItem>
              <ComboboxItem value="pineapple">Pineapple</ComboboxItem>
              <ComboboxItem value="plum">Plum</ComboboxItem>
            </ComboboxList>
          </ComboboxPopup>
        </ComboboxPositioner>
      </ComboboxPortal>
    </ComboboxRoot>
    <output data-testid="value">{value ?? "null"}</output>
    <output data-testid="text">{text}</output>
    <output data-testid="open">{open ? "open" : "closed"}</output>
    <button type="button" onClick={() => { value := "plum"; text := "Plum" }}>Pick plum</button>
    <ComboboxRoot disabled>
      <ComboboxInput aria-label="Disabled" />
      <ComboboxPortal>
        <ComboboxPositioner>
          <ComboboxPopup>
            <ComboboxList><ComboboxItem value="x">X</ComboboxItem></ComboboxList>
          </ComboboxPopup>
        </ComboboxPositioner>
      </ComboboxPortal>
    </ComboboxRoot>
    <ComboboxRoot readOnly defaultValue="y">
      <ComboboxInput aria-label="Read only" />
      <ComboboxPortal>
        <ComboboxPositioner>
          <ComboboxPopup>
            <ComboboxList><ComboboxItem value="y">Y</ComboboxItem><ComboboxItem value="z">Z</ComboboxItem></ComboboxList>
          </ComboboxPopup>
        </ComboboxPositioner>
      </ComboboxPortal>
    </ComboboxRoot>
  </main>
}
