import { combobox, ComboboxRoot, ComboboxInput, ComboboxChips, ComboboxChip, ComboboxChipRemove, ComboboxPopup, ComboboxList, ComboboxItem, ComboboxItemIndicator } from "../combobox.rx"

// Chips for whatever is selected, read from the context: how an uncontrolled multiple combobox lists its values.
component SelectedChips() {
  c = use combobox
  {for value in c.selected {
    <ComboboxChip value={value} data-testid="chip">{value}<ComboboxChipRemove aria-label={`Remove ${value}`}>×</ComboboxChipRemove></ComboboxChip>
  }}
}

export default component Fixture() {
  source picked := ""
  <form data-testid="form" style="padding: 40px 0 0 60px">
    <ComboboxRoot multiple name="langs" defaultValues={["rx"]} onValuesChange={(next) => { picked := next.join(",") }}>
      <ComboboxChips data-testid="chips" style="display: flex; width: 320px; padding: 6px">
        <SelectedChips />
        <ComboboxInput aria-label="Languages" />
      </ComboboxChips>
      <ComboboxPopup data-testid="popup" style="padding: 0; border: 0">
        <ComboboxList>
          <ComboboxItem value="rx" label="ReactiveScript"><ComboboxItemIndicator>✓</ComboboxItemIndicator>ReactiveScript</ComboboxItem>
          <ComboboxItem value="ts" label="TypeScript"><ComboboxItemIndicator>✓</ComboboxItemIndicator>TypeScript</ComboboxItem>
          <ComboboxItem value="rs" label="Rust"><ComboboxItemIndicator>✓</ComboboxItemIndicator>Rust</ComboboxItem>
        </ComboboxList>
      </ComboboxPopup>
    </ComboboxRoot>
    <output data-testid="picked">{picked}</output>
  </form>
}
